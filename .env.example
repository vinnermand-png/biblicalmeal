# Optional public ownership verification values for V3C.12.
# Leave empty until a real verification challenge is issued by the chosen service.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Optional GA4 measurement ID for V3C.13. Leave empty until a real ID is issued.
PUBLIC_GA_MEASUREMENT_ID=

# Local development only for V3D.4 editorial asset generation.
# Never commit a real key. The public website does not read this value.
OPENAI_API_KEY=

# Optional override for the local generator. Defaults to the current API model below.
OPENAI_IMAGE_MODEL=gpt-image-2
