---
import { getVisibleArticles } from '../../lib/queries';
import { formatDate, readingTime, statusChip } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';
import ContentHero from '../../components/common/ContentHero.astro';
import ArticleCard from '../../components/common/ArticleCard.astro';
import EditorialImage from '../../components/common/EditorialImage.astro';
import Chip from '../../components/common/Chip.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';

const articles = await getVisibleArticles();
const currentFeature = articles[0];
const archiveArticles = articles.slice(1);
const featureChip = currentFeature ? statusChip(currentFeature.data.status) : null;
const featureMinutes = currentFeature ? readingTime(currentFeature.body) : 0;
const featureArt = currentFeature?.data.art ?? 'still-life';
const featureImageId = currentFeature?.data.art === 'mediterranean'
  ? 'journal-mediterranean-landscape'
  : 'journal-ancient-table';

const editorialContexts = [
  {
    id: 'journal-research-manuscript',
    eyebrow: 'Research',
    title: 'The work behind the page',
    fallbackArt: 'still-life' as const,
  },
  {
    id: 'journal-meal-preparation',
    eyebrow: 'Kitchen',
    title: 'Ingredients before the recipe',
    fallbackArt: 'stew' as const,
  },
  {
    id: 'journal-mediterranean-landscape',
    eyebrow: 'Place',
    title: 'The landscape around the table',
    fallbackArt: 'mediterranean' as const,
  },
];
---
<BaseLayout title="Journal" description="Stories and method notes from BiblicalMeal — how we research the foods of the ancient world, and how they meet the modern table.">
  <Header />
  <main id="main">
    <ContentHero
      variant="listing"
      eyebrow="The Journal"
      title="Stories & Method"
      lead="Long-form reading on the foods of scripture — our research process, what the sources can and cannot tell us, and life around the ancient table."
      art="still-life"
      editorialImageId="journal-ancient-table"
    >
      <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Journal' }]} />
    </ContentHero>

    {currentFeature ? (
      <section class="journal container-site section-space" aria-label="Journal articles">
        <div class="journal__intro">
          <div>
            <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">Current feature</p>
            <p class="mt-4 font-display text-h2 text-ink">A quieter place for the questions behind the table.</p>
          </div>
          <p class="journal__intro-copy text-body text-ink-muted">Research-aware essays, context, and careful interpretation — presented as an editorial collection rather than an endless feed.</p>
        </div>

        <article class="journal-feature surface-card">
          <a href={`/articles/${currentFeature.id}/`} class="journal-feature__media media-frame group" aria-label={`Read ${currentFeature.data.title}`}>
            <EditorialImage
              id={featureImageId}
              fallbackArt={featureArt}
              ratio="3 / 2"
              alt={currentFeature.data.title}
              loading="eager"
            />
          </a>
          <div class="journal-feature__copy">
            <div class="flex flex-wrap items-center gap-3">
              <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">{currentFeature.data.category}</p>
              {featureChip && <Chip variant={featureChip} class="bg-background-alt" />}
            </div>
            <h2 class="mt-5 max-w-3xl font-display text-display text-ink">{currentFeature.data.title}</h2>
            <p class="mt-5 max-w-2xl text-body-lg text-ink-muted">{currentFeature.data.excerpt}</p>
            <div class="journal-feature__meta mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-caption text-ink-muted">
              <span>{featureMinutes} min read</span>
              {currentFeature.data.pubDate && <span>{formatDate(currentFeature.data.pubDate)}</span>}
            </div>
            <a href={`/articles/${currentFeature.id}/`} class="journal-feature__link mt-8 inline-flex font-sans text-caption font-semibold tracking-wide text-terracotta-dark">
              Read current feature <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <section class="journal-context" aria-labelledby="journal-context-title">
          <div class="journal-context__heading">
            <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">Around the table</p>
            <h2 id="journal-context-title" class="mt-3 font-display text-h2 text-ink">The material world of the journal</h2>
            <p class="mt-4 max-w-2xl text-body text-ink-muted">The Journal follows more than finished dishes: sources, preparation, and place all shape how BiblicalMeal approaches the ancient table.</p>
          </div>
          <div class="journal-context__grid">
            {editorialContexts.map((context) => (
              <article class="journal-context__item">
                <div class="journal-context__media media-frame group">
                  <EditorialImage
                    id={context.id}
                    fallbackArt={context.fallbackArt}
                    ratio="3 / 2"
                    alt=""
                  />
                </div>
                <p class="mt-5 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">{context.eyebrow}</p>
                <h3 class="mt-2 font-display text-h3 text-ink">{context.title}</h3>
              </article>
            ))}
          </div>
        </section>

        {archiveArticles.length > 0 && (
          <div class="journal-archive">
            <div class="journal-archive__heading">
              <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">From the archive</p>
              <p class="mt-3 font-display text-h2 text-ink">More reading</p>
            </div>
            <ul class="content-listing__grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
              {archiveArticles.map((entry) => <li><ArticleCard entry={entry} /></li>)}
            </ul>
          </div>
        )}

        <p class="journal__note text-caption text-ink-muted">The Journal is intentionally small while new essays remain in editorial review. New work joins this collection only when it meets the same publication and research standards.</p>
      </section>
    ) : (
      <div class="container-site section-space"><EmptyState message="The journal opens soon. Our first stories are in editorial review — written to the same standard as every profile on this site." /></div>
    )}
  </main>
  <SiteFooter />
</BaseLayout>