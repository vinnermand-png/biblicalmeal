---
import { getVisibleArticles } from '../../lib/queries';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';
import ContentHero from '../../components/common/ContentHero.astro';
import ArticleCard from '../../components/common/ArticleCard.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';

const articles = await getVisibleArticles();
---

<BaseLayout
  title="Journal"
  description="Stories and method notes from BiblicalMeal — how we research the foods of the ancient world, and how they meet the modern table."
>
  <Header />
  <main id="main">
    <ContentHero
      eyebrow="The Journal"
      title="Stories & Method"
      lead="Long-form reading on the foods of scripture — our research process, what the sources can and cannot tell us, and life around the ancient table."
    >
      <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Journal' }]} />
    </ContentHero>

    {
      articles.length > 0 ? (
        <section class="container-site py-16 sm:py-20" aria-label="Articles">
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {articles.map((entry) => (
              <li>
                <ArticleCard entry={entry} />
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <div class="container-site py-16 sm:py-20">
          <EmptyState message="The journal opens soon. Our first stories are in editorial review — written to the same standard as every profile on this site." />
        </div>
      )
    }
  </main>
  <SiteFooter />
</BaseLayout>
