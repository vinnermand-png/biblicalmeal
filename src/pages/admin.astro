---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ADMIN_OVERVIEW } from '../data/admin/overview';

const eligible = ADMIN_OVERVIEW.workflowItems.filter((item) => item.publicationEligible).length;
const blocked = ADMIN_OVERVIEW.workflowItems.length - eligible;
---

<BaseLayout
  title="Admin Overview"
  description="Internal read-only visibility across BiblicalMeal canonical content, research, recipes, cookbook production and publication readiness."
  noindex={true}
>
  <main class="admin-shell">
    <header class="admin-header">
      <p class="eyebrow">BiblicalMeal internal foundation</p>
      <h1>Admin &amp; Content Overview</h1>
      <p>
        Read-only visibility over canonical systems. This dashboard does not own content,
        mutate records, approve research, or publish anything.
      </p>
    </header>

    <section class="admin-notice" aria-label="Admin access model">
      <strong>Access mode: {ADMIN_OVERVIEW.accessMode}</strong>
      <span>Current repository architecture has no authenticated persistence layer, so V3C.31 intentionally exposes visibility without mutation authority.</span>
    </section>

    <section class="metrics" aria-label="Canonical system summary">
      {ADMIN_OVERVIEW.metrics.map((metric) => (
        <article class="metric-card">
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
          <p>{metric.note}</p>
        </article>
      ))}
    </section>

    <section class="readiness" aria-labelledby="readiness-heading">
      <div>
        <p class="eyebrow">Workflow visibility</p>
        <h2 id="readiness-heading">Publication readiness</h2>
      </div>
      <div class="readiness-counts">
        <span><strong>{eligible}</strong> eligible</span>
        <span><strong>{blocked}</strong> blocked or still in workflow</span>
      </div>
    </section>

    <section class="workflow" aria-label="Canonical workflow items">
      {ADMIN_OVERVIEW.workflowItems.map((item) => (
        <article class="workflow-item">
          <div class="workflow-topline">
            <span class="kind">{item.kind}</span>
            <span class:list={['status', { eligible: item.publicationEligible }]}>{item.stage}</span>
          </div>
          <h3>{item.label}</h3>
          <p class="state">Publication: {item.publicationState}</p>
          <p class="relationships"><strong>Canonical relationships:</strong> {item.relationships.join(', ') || 'None'}</p>
          {item.blockers.length > 0 && (
            <ul>
              {item.blockers.map((blocker) => <li>{blocker}</li>)}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="warnings" aria-labelledby="boundaries-heading">
      <p class="eyebrow">System boundaries</p>
      <h2 id="boundaries-heading">What this admin layer cannot do</h2>
      <ul>
        {ADMIN_OVERVIEW.warnings.map((warning) => <li>{warning}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .admin-shell { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 5rem; }
  .admin-header { max-width: 760px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; font-weight: 700; color: var(--color-olive-700, #526047); }
  h1, h2, h3 { font-family: var(--font-display, Fraunces, Georgia, serif); }
  h1 { font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: .98; margin: .25rem 0 1rem; }
  h2 { margin: 0; }
  .admin-header > p:last-child { font-size: 1.08rem; max-width: 70ch; }
  .admin-notice, .metric-card, .workflow-item, .warnings { border: 1px solid rgba(58, 48, 35, .14); background: rgba(255,255,255,.55); border-radius: 1rem; }
  .admin-notice { display: grid; gap: .35rem; padding: 1rem 1.2rem; margin: 2rem 0; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .9rem; }
  .metric-card { padding: 1rem; min-height: 150px; }
  .metric-card span { font-size: .86rem; color: #6f675d; }
  .metric-card strong { display: block; font-size: 2rem; margin: .4rem 0; }
  .metric-card p { margin: 0; font-size: .86rem; color: #6f675d; }
  .readiness { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin: 3rem 0 1rem; }
  .readiness-counts { display: flex; gap: 1rem; flex-wrap: wrap; }
  .readiness-counts span { background: #efe9df; border-radius: 999px; padding: .45rem .8rem; }
  .workflow { display: grid; gap: .8rem; }
  .workflow-item { padding: 1.15rem 1.25rem; }
  .workflow-topline { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .kind, .status { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
  .kind { color: #6f675d; }
  .status { color: #8b5e20; }
  .status.eligible { color: #2f6b45; }
  .workflow-item h3 { margin: .5rem 0 .25rem; font-size: 1.35rem; }
  .workflow-item p { margin: .35rem 0; }
  .state { color: #6f675d; }
  .relationships { font-size: .9rem; overflow-wrap: anywhere; }
  .workflow-item ul { margin: .75rem 0 0; padding-left: 1.2rem; color: #7a3f2d; }
  .warnings { margin-top: 3rem; padding: 1.3rem; }
  .warnings ul { margin: .8rem 0 0; padding-left: 1.2rem; }
  @media (max-width: 680px) { .admin-shell { padding-top: 2rem; } .readiness { align-items: start; flex-direction: column; } .workflow-topline { align-items: start; flex-direction: column; gap: .35rem; } }
</style>
