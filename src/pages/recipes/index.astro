---
import { getVisibleRecipes } from '../../lib/queries';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';
import RecipeCard from '../../components/common/RecipeCard.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
const recipes = await getVisibleRecipes();
---

<BaseLayout
  title="Recipes"
  description="Modern kitchen recipes inspired by the ingredients of the ancient biblical world — clearly labelled as inspired creations or historically researched reconstructions."
>
  <Header /><main id="main" class="page-recipes">
    <section class="recipes-hero" aria-labelledby="recipes-hero-title">
      <div class="recipes-hero__inner container-site">
        <Breadcrumbs items={[{ label: 'Recipes' }]} />
        <p class="recipes-hero__eyebrow">From Our Kitchen</p>
        <h1 id="recipes-hero-title" class="recipes-hero__title">Recipes</h1>
        <div class="recipes-hero__rule" aria-hidden="true"></div>
        <p class="recipes-hero__lead">
          Every BiblicalMeal recipe states exactly what it is: a modern creation
          inspired by biblical-world ingredients, a researched reconstruction,
          or work built from cited historical sources.
        </p>
      </div>
    </section>
    {
      recipes.length > 0 ? (
        <section
          class="recipes-archive container-site section-space"
          aria-label="Recipe collection"
        >
          <div class="recipes-archive__intro">
            <p class="recipes-archive__statement font-display text-ink">
              A modern kitchen in conversation with an ancient food world.
            </p>
            <p class="recipes-archive__support text-ink-muted">
              Each recipe keeps its historical relationship visible, so
              reconstruction and inspiration are never visually presented as the
              same thing.
            </p>
          </div>
          <div class="recipes-archive__divider" aria-hidden="true" />
          <ul class="recipes-archive__grid">
            {recipes.map((entry) => (
              <li>
                <RecipeCard entry={entry} />
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <div class="container-site section-space">
          <EmptyState message="Our first tested recipes are finishing development. Each recipe publishes only once it has been cooked, measured, and honestly labelled." />
        </div>
      )
    }
  </main><SiteFooter /></BaseLayout
>

<style>
  /* Editorial masthead hero — cookbook chapter opener */
  .recipes-hero {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .recipes-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }

  .recipes-hero__inner :global(nav) {
    align-self: stretch;
    text-align: left;
  }

  .recipes-hero__eyebrow {
    margin: clamp(1.5rem, 3vw, 1.875rem) 0 0.75rem;
    color: var(--color-olive-dark);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .recipes-hero__title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.75rem + 3vw, 4.25rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .recipes-hero__rule {
    width: 3.5rem;
    height: 1px;
    margin: clamp(1.375rem, 2.5vw, 1.75rem) 0;
    background: var(--color-gold);
    opacity: 0.55;
  }

  .recipes-hero__lead {
    margin: 0;
    max-width: 39rem;
    color: var(--color-ink-muted);
    font-size: clamp(0.9375rem, 0.875rem + 0.2vw, 1.125rem);
    line-height: 1.72;
  }

  @media (max-width: 639px) {
    .recipes-hero {
      padding-block: clamp(2rem, 6vw, 2.75rem);
    }
    .recipes-hero__eyebrow {
      margin-top: 1.25rem;
    }
  }

  .recipes-archive {
    max-width: 88rem;
  }

  .recipes-archive__intro {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: baseline;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .recipes-archive__statement {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.65rem, 1.25rem + 1.6vw, 2.35rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .recipes-archive__support {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: clamp(0.9375rem, 0.875rem + 0.2vw, 1.0625rem);
    line-height: 1.72;
  }

  .recipes-archive__divider {
    height: 1px;
    background: var(--color-line);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .recipes-archive__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2vw, 1.75rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  @media (max-width: 1023px) {
    .recipes-archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .recipes-archive__intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .recipes-archive__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
