---
import type { CollectionEntry } from 'astro:content';
import { draftsPreview, minutesToISO } from '../../lib/content';
import { getRelated, getVisibleRecipes } from '../../lib/queries';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';
import ContentHero from '../../components/common/ContentHero.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import Chip from '../../components/common/Chip.astro';
import MetaRow,{type MetaItem} from '../../components/common/MetaRow.astro';
import ScriptureBlock from '../../components/common/ScriptureBlock.astro';
import RelatedSection from '../../components/common/RelatedSection.astro';
type Entry=CollectionEntry<'recipes'>;export async function getStaticPaths(){const recipes=await getVisibleRecipes();return recipes.map(entry=>({params:{slug:entry.id},props:{entry}}));}interface Props{entry:Entry;}
const {entry}:Props=Astro.props;const {title,description,inspiredNote,recipeType,servings,prepMinutes,cookMinutes,difficulty,ingredients,instructions}=entry.data;const related=await getRelated({collection:'recipes',id:entry.id});const isDevPreview=draftsPreview()&&entry.data.status!=='published';
const TYPE_FRAMING={inspired:'A BiblicalMeal kitchen creation',researched:'Built from historical sources',reconstructed:'A scholarly reconstruction'} as const;const totalMinutes=prepMinutes!=null&&cookMinutes!=null?prepMinutes+cookMinutes:undefined;const isPublished=entry.data.status==='published';const supportsRecipeSchema=isPublished&&ingredients.length>0&&instructions.length>0;
const recipeSchema=supportsRecipeSchema?{'@context':'https://schema.org','@type':'Recipe',name:title,description,author:{'@type':'Organization',name:'BiblicalMeal'},...(servings!=null&&{recipeYield:`${servings} servings`}),...(prepMinutes!=null&&{prepTime:minutesToISO(prepMinutes)}),...(cookMinutes!=null&&{cookTime:minutesToISO(cookMinutes)}),...(totalMinutes!=null&&{totalTime:minutesToISO(totalMinutes)}),recipeIngredient:ingredients.map(ing=>[ing.quantity,ing.item].filter(Boolean).join(' ')),recipeInstructions:instructions.map(text=>({'@type':'HowToStep',text})),keywords:entry.data.tags.join(', ')}:undefined;
const breadcrumbs=[{label:'Recipes',href:'/recipes/'},{label:title}];const metaItems=([{label:'Prep',value:prepMinutes!=null?`${prepMinutes} min`:undefined},{label:'Cook',value:cookMinutes!=null?`${cookMinutes} min`:undefined},{label:'Total',value:totalMinutes!=null?`${totalMinutes} min`:undefined},{label:'Serves',value:servings!=null?String(servings):undefined},{label:'Difficulty',value:difficulty!=null?difficulty[0].toUpperCase()+difficulty.slice(1):undefined}].filter(item=>item.value) as MetaItem[]);
---
<BaseLayout title={title} description={description} jsonLd={recipeSchema?[recipeSchema]:[]}><Header/><main id="main">
<ContentHero variant="recipe" eyebrow="Recipe" title={title} lead={description} art={entry.data.art??'stew'}><Breadcrumbs slot="breadcrumbs" items={breadcrumbs}/><div slot="meta" class="mt-6 space-y-4"><div class="flex flex-wrap items-center gap-3">{isDevPreview&&<Chip variant="dev"/>}<Chip variant={recipeType==='reconstructed'?'review':'inspired'} label={TYPE_FRAMING[recipeType]}/></div><MetaRow items={metaItems}/></div></ContentHero>
<article class="container-site section-space"><div class="grid gap-12 lg:grid-cols-12 lg:gap-16"><aside class="lg:col-span-5 lg:col-start-1"><section class="surface-panel p-6 sm:p-8" aria-labelledby="recipe-ingredients"><p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">The pantry</p><h2 id="recipe-ingredients" class="mt-2 font-display text-h2 text-ink">Ingredients</h2><ul class="mt-6 divide-y divide-line border-y border-line">{ingredients.map(ing=><li class="flex items-baseline justify-between gap-4 py-3"><span class="text-body text-ink">{ing.item}</span>{ing.quantity&&<span class="shrink-0 font-medium text-olive-dark">{ing.quantity}</span>}</li>)}</ul></section></aside><div class="lg:col-span-7"><section aria-labelledby="recipe-method"><p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">Preparation</p><h2 id="recipe-method" class="mt-2 font-display text-h2 text-ink">Method</h2>{instructions.length>0?<ol class="mt-8 space-y-7">{instructions.map((step,i)=><li class="flex gap-5"><span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full border border-line bg-background-alt font-display text-body font-semibold text-terracotta-dark">{i+1}</span><p class="max-w-prose pt-1 text-body-lg text-ink-muted">{step}</p></li>)}</ol>:<p class="mt-6 max-w-prose text-body-lg text-ink-muted">The full method for this recipe is still in development.</p>}</section><section aria-labelledby="recipe-inspiration" class="surface-panel mt-16 border-olive/30 p-7 sm:p-9"><h2 id="recipe-inspiration" class="font-display text-h3 text-ink">About this recipe</h2><p class="mt-3 max-w-prose text-body text-ink-muted">{inspiredNote}</p></section>{entry.data.scriptureRefs.length>0&&<div class="mt-12 border-t border-line pt-10"><ScriptureBlock refs={entry.data.scriptureRefs}/></div>}</div></div></article><RelatedSection related={related}/></main><SiteFooter/></BaseLayout>
