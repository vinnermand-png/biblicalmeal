---
import CookbookShell from '../../components/cookbook/CookbookShell.astro';
import CookbookHeader from '../../components/cookbook/CookbookHeader.astro';
import { COOKBOOK_CHAPTERS } from '../../data/cookbook/structure';
import { COOKBOOK_RECIPE_INCLUSIONS } from '../../data/cookbook-production/records';
import { RECIPE_CONTENT_RECORDS } from '../../data/recipe-content/records';

const recipeContentById = new Map(RECIPE_CONTENT_RECORDS.map((r) => [r.id, r]));

const SECTION_TO_CHAPTER: Record<string, string> = {
  'cookbook-section-simple-preparations': 'legumes-one-pot-meals',
  'cookbook-section-breads-and-grains': 'grains-breads',
  'cookbook-section-seafood-preparations': 'fish-seafood',
  'cookbook-section-fruits-and-preserves': 'fruits-preserves',
  'cookbook-section-herbs-oils-seasonings': 'herbs-oils-seasonings',
  'cookbook-section-feasts-and-gatherings': 'feasts-gatherings',
};

const CLASSIFICATION_LABELS: Record<string, string> = {
  'historically-attested-preparation': 'Historically attested',
  'historically-informed-reconstruction': 'Reconstruction',
  'scripture-inspired-preparation': 'Scripture-inspired',
  'modern-adaptation': 'Modern adaptation',
};

interface TocRecipe {
  title: string;
  classification: string;
  recipeContentId: string;
  order: number;
}

const recipesByChapter = new Map<string, TocRecipe[]>();

for (const inclusion of COOKBOOK_RECIPE_INCLUSIONS) {
  const chapterId = SECTION_TO_CHAPTER[inclusion.sectionId];
  if (!chapterId) continue;

  const recipe = recipeContentById.get(inclusion.recipeContentId);
  if (!recipe) continue;

  const list = recipesByChapter.get(chapterId) ?? [];
  list.push({
    title: recipe.title,
    classification: recipe.classification,
    recipeContentId: inclusion.recipeContentId,
    order: inclusion.order,
  });
  recipesByChapter.set(chapterId, list);
}

for (const [, recipes] of recipesByChapter) {
  recipes.sort((a, b) => a.order - b.order);
}
---

<CookbookShell
  title="Table of Contents"
  description="Browse all nine recipes across six chapters in the BiblicalMeal Cookbook."
>
  <CookbookHeader />

  <section class="bg-background-alt section-space">
    <div class="cookbook-content px-5 sm:px-8">
      <p
        class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
      >
        The BiblicalMeal Cookbook
      </p>
      <h1 class="mt-3 font-display text-h1 text-ink">Table of Contents</h1>
      <p class="mt-4 max-w-2xl text-body-lg text-ink-muted">
        Nine evidence-aware recipes across six chapters — from grains and breads
        to feasts and gatherings.
      </p>
    </div>
  </section>

  <section class="bg-background section-space-compact">
    <div class="cookbook-content px-5 sm:px-8">
      {
        COOKBOOK_CHAPTERS.map((chapter) => {
          const recipes = recipesByChapter.get(chapter.id) ?? [];
          return (
            <div class="cookbook-toc-chapter">
              <div class="flex items-baseline gap-4">
                <span class="cookbook-chapter-number text-3xl sm:text-4xl">
                  {String(chapter.order).padStart(2, '0')}
                </span>
                <div>
                  <h2 class="font-display text-h2 text-ink">{chapter.title}</h2>
                  <p class="mt-1 text-body text-ink-muted">
                    {chapter.description}
                  </p>
                </div>
              </div>

              {recipes.length > 0 && (
                <div class="mt-6 ml-0 sm:ml-16">
                  {recipes.map((recipe) => (
                    <div class="cookbook-toc-recipe">
                      <div class="flex items-baseline gap-3">
                        <span class="font-sans text-caption font-medium text-olive-dark">
                          {recipe.order}.
                        </span>
                        <span class="text-body text-ink">{recipe.title}</span>
                      </div>
                      <span class="shrink-0 rounded-full border border-line bg-background-alt px-3 py-1 text-xs font-medium text-ink-muted">
                        {CLASSIFICATION_LABELS[recipe.classification] ??
                          recipe.classification}
                      </span>
                    </div>
                  ))}
                </div>
              )}

              {recipes.length === 0 && (
                <p class="mt-4 ml-0 text-body text-ink-muted italic sm:ml-16">
                  Recipes coming soon.
                </p>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="bg-background-alt section-space-compact">
    <div class="cookbook-content px-5 text-center sm:px-8">
      <p class="text-body-lg text-ink-muted">
        Each recipe is honestly classified by its evidence basis. Browse the
        classification guide to understand what each label means.
      </p>
      <a
        href="/cookbook/"
        class="mt-6 inline-flex items-center rounded-full border border-line bg-surface px-6 py-3 text-sm font-medium text-ink transition-all duration-200 hover:border-olive/40 hover:text-olive-dark"
      >
        ← Back to Cookbook
      </a>
    </div>
  </section>
</CookbookShell>
