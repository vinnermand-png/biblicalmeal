---
/**
 * V3C.45D — Cookbook Landing Page
 *
 * The main cookbook page is now a book preview experience.
 * The visitor opens the book and reads real pages.
 */
import CookbookShell from '../../components/cookbook/CookbookShell.astro';
import CookbookHeader from '../../components/cookbook/CookbookHeader.astro';
import BookViewer from '../../components/cookbook/BookViewer.astro';
---

<CookbookShell
  title="The Cookbook"
  description="Preview Biblical Meals — nine evidence-aware recipes rooted in Scripture, history, and the culinary traditions of the ancient world."
>
  <CookbookHeader />

  {/* The book viewer IS the page */}
  <section class="bg-background-alt py-8 sm:py-12">
    <div class="cookbook-wide px-5 sm:px-8">
      <BookViewer />
    </div>
  </section>

  {/* Supporting info below the viewer */}
  <section class="bg-background section-space-compact">
    <div class="cookbook-content px-5 sm:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p
          class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
        >
          About the Cookbook
        </p>
        <h2 class="mt-3 font-display text-h2 text-ink">
          Evidence-Aware Cooking
        </h2>
        <p class="mt-4 text-body-lg text-ink-muted">
          Every recipe in <em>Biblical Meals</em> is honestly classified by its evidence
          basis. From directly attested ingredients to modern adaptations, you always
          know what is historically grounded and what is a practical kitchen choice.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <span
            class="rounded-full border border-olive/40 bg-olive/10 px-4 py-2 text-sm font-medium text-olive-dark"
          >
            Scripture-inspired
          </span>
          <span
            class="rounded-full border border-terracotta/30 bg-terracotta/10 px-4 py-2 text-sm font-medium text-terracotta-dark"
          >
            Historically informed
          </span>
          <span
            class="rounded-full border border-gold/40 bg-gold/10 px-4 py-2 text-sm font-medium text-ink"
          >
            Evidence-transparent
          </span>
        </div>
      </div>
    </div>
  </section>
</CookbookShell>
