---
/**
 * V3C.45D — Cookbook Landing Page (Showroom)
 *
 * The cookbook landing page is now a book cover/showroom.
 * The visitor sees the real cover and clicks to open the reader.
 */
import CookbookShell from '../../components/cookbook/CookbookShell.astro';
import CookbookHeader from '../../components/cookbook/CookbookHeader.astro';
import FoodIllustration from '../../components/common/FoodIllustration.astro';
import { BOOK_METADATA } from '../../data/cookbook/book-metadata';
---

<CookbookShell
  title="The Cookbook"
  description="Preview Biblical Meals — nine evidence-aware recipes rooted in Scripture, history, and the culinary traditions of the ancient world."
>
  <CookbookHeader />

  {/* ── Cover / Showroom ─────────────────────────── */}
  <section class="cookbook-showroom">
    <div class="cookbook-showroom__inner">
      {/* The actual book cover */}
      <div class="cookbook-showroom__cover-wrapper">
        <a
          href="/cookbook/read/"
          class="cookbook-showroom__cover-link"
          aria-label="Open the book preview"
        >
          <div class="cookbook-showroom__cover">
            <div class="cookbook-showroom__cover-art">
              <FoodIllustration kind="still-life" ratio="8 / 10" />
            </div>
            <div class="cookbook-showroom__cover-content">
              <p class="cookbook-showroom__cover-publisher">
                The BiblicalMeal Cookbook
              </p>
              <h1 class="cookbook-showroom__cover-title">Biblical Meals</h1>
              <p class="cookbook-showroom__cover-subtitle">
                {BOOK_METADATA.subtitle}
              </p>
              <div class="cookbook-showroom__cover-divider"></div>
              <p class="cookbook-showroom__cover-meta">
                {BOOK_METADATA.publisher} &middot; {BOOK_METADATA.edition} &middot;
                {BOOK_METADATA.publicationYear}
              </p>
            </div>
          </div>
        </a>
      </div>

      {/* Below the cover */}
      <div class="cookbook-showroom__info">
        <h2 class="cookbook-showroom__info-title">A Real Cookbook, Digital</h2>
        <p class="cookbook-showroom__info-desc">
          {BOOK_METADATA.description}
        </p>
        <div class="cookbook-showroom__features">
          <div class="cookbook-showroom__feature">
            <span class="cookbook-showroom__feature-icon" aria-hidden="true"
              >📖</span
            >
            <div>
              <p class="cookbook-showroom__feature-title">Six Chapters</p>
              <p class="cookbook-showroom__feature-desc">
                From grains and breads to feasts and gatherings
              </p>
            </div>
          </div>
          <div class="cookbook-showroom__feature">
            <span class="cookbook-showroom__feature-icon" aria-hidden="true"
              >🔬</span
            >
            <div>
              <p class="cookbook-showroom__feature-title">Evidence-Aware</p>
              <p class="cookbook-showroom__feature-desc">
                Every recipe classified by its historical evidence
              </p>
            </div>
          </div>
          <div class="cookbook-showroom__feature">
            <span class="cookbook-showroom__feature-icon" aria-hidden="true"
              >📜</span
            >
            <div>
              <p class="cookbook-showroom__feature-title">Scripture-Rooted</p>
              <p class="cookbook-showroom__feature-desc">
                Recipes connected to biblical texts and context
              </p>
            </div>
          </div>
        </div>
        <div class="cookbook-showroom__actions">
          <a href="/cookbook/read/" class="cookbook-showroom__cta">
            Read Preview
          </a>
          <a href="/cookbook/toc/" class="cookbook-showroom__cta-secondary">
            Table of Contents
          </a>
        </div>
      </div>
    </div>
  </section>
</CookbookShell>

<style>
  .cookbook-showroom {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    background: var(--color-background);
  }
  .cookbook-showroom__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 56rem;
    width: 100%;
  }
  @media (min-width: 900px) {
    .cookbook-showroom__inner {
      flex-direction: row;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  /* Cover */
  .cookbook-showroom__cover-wrapper {
    flex-shrink: 0;
  }
  .cookbook-showroom__cover-link {
    display: block;
    text-decoration: none;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .cookbook-showroom__cover-link:hover {
    transform: translateY(-4px);
  }
  .cookbook-showroom__cover {
    width: min(100%, 320px);
    aspect-ratio: 8 / 10;
    border-radius: 0.5rem;
    overflow: hidden;
    position: relative;
    background: var(--color-surface);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.06),
      0 16px 48px rgba(0, 0, 0, 0.04);
  }
  @media (min-width: 900px) {
    .cookbook-showroom__cover {
      width: min(100%, 380px);
    }
  }
  .cookbook-showroom__cover-art {
    position: absolute;
    inset: 0;
    opacity: 0.25;
  }
  .cookbook-showroom__cover-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    gap: clamp(0.375rem, 1.2vw, 0.75rem);
  }
  .cookbook-showroom__cover-publisher {
    font-family: var(--font-sans);
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-olive-dark);
    margin: 0;
  }
  .cookbook-showroom__cover-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
  }
  .cookbook-showroom__cover-subtitle {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 2vw, 1rem);
    line-height: 1.3;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .cookbook-showroom__cover-divider {
    width: 3rem;
    height: 1px;
    background: var(--color-line);
    margin: clamp(0.25rem, 1vw, 0.5rem) 0;
  }
  .cookbook-showroom__cover-meta {
    font-family: var(--font-sans);
    font-size: clamp(0.55rem, 1.1vw, 0.65rem);
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Info */
  .cookbook-showroom__info {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: 32rem;
  }
  .cookbook-showroom__info-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0;
  }
  .cookbook-showroom__info-desc {
    font-size: clamp(0.875rem, 1.6vw, 1rem);
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Features */
  .cookbook-showroom__features {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }
  .cookbook-showroom__feature {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .cookbook-showroom__feature-icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-top: 0.125rem;
  }
  .cookbook-showroom__feature-title {
    font-family: var(--font-sans);
    font-size: clamp(0.8rem, 1.4vw, 0.875rem);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }
  .cookbook-showroom__feature-desc {
    font-size: clamp(0.75rem, 1.3vw, 0.8125rem);
    color: var(--color-ink-muted);
    margin: 0.125rem 0 0;
  }

  /* Actions */
  .cookbook-showroom__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(0.25rem, 1vw, 0.5rem);
  }
  .cookbook-showroom__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    background: var(--color-terracotta);
    color: var(--color-cream);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 200ms ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .cookbook-showroom__cta:hover {
    background: var(--color-terracotta-dark);
    transform: translateY(-1px);
  }
  .cookbook-showroom__cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 200ms ease;
  }
  .cookbook-showroom__cta-secondary:hover {
    border-color: var(--color-olive);
    color: var(--color-olive-dark);
  }
</style>
