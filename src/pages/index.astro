---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import EditorialImage from '../components/common/EditorialImage.astro';

const HOME_DESCRIPTION =
  'Explore the foods of the Bible through ingredients, recipes, regions, history, and the culinary traditions of the ancient world.';
---

<BaseLayout title={undefined} description={HOME_DESCRIPTION}>
  <Header />

  <main id="main" class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__image" aria-hidden="true">
        <EditorialImage id="journal-ancient-table" fallbackArt="still-life" alt="Ancient-inspired table with bread, figs, olives, pottery and linen" loading="eager" ratio="16 / 10" class="hero__media" />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>

      <div class="container-site hero__shell">
        <div class="hero__copy">
          <p class="hero__eyebrow">The Ancient Table</p>
          <h1 id="hero-title">The Bible tells<br />its story at the <em>table.</em></h1>
          <div class="hero__ornament" aria-hidden="true"><span></span><b>✦</b><span></span></div>
          <p class="hero__lead">Ingredients, meals, landscapes, and culinary traditions from the ancient world — explored through Scripture, history, evidence, and cooking.</p>
          <div class="hero__actions">
            <a href="/ingredients/" class="hero__primary">Explore the foods <span aria-hidden="true">→</span></a>
            <a href="/editorial-method/" class="hero__secondary">Enter the biblical world</a>
          </div>
          <div class="hero__principles" aria-label="BiblicalMeal principles"><span>Rooted in Scripture</span><i aria-hidden="true"></i><span>Inspired by history</span><i aria-hidden="true"></i><span>Made for today</span></div>
        </div>
      </div>

      <aside class="hero__scripture" aria-label="Scripture reflection">
        <span class="hero__scripture-label">At the table</span>
        <blockquote>“Man shall not live by bread alone.”</blockquote>
        <cite>Matthew 4:4</cite>
      </aside>
    </section>

    <section class="ingredient-story" aria-labelledby="ingredient-story-title">
      <div class="container-site ingredient-story__shell">
        <div class="ingredient-story__intro">
          <p class="section-kicker">THE BIBLICAL TABLE</p>
          <h2 id="ingredient-story-title">Every ingredient<br />carries a <em>story.</em></h2>
        </div>

        <div class="ingredient-story__content">
          <div class="ingredient-story__copy">
            <p class="ingredient-story__lead">Food in the Bible was never only food. A fig carried the memory of harvest. Olive oil travelled from the press to the lamp. Barley fed ordinary households. Honey became a language of abundance.</p>
            <p>Each ingredient opens a way into the ancient world — its landscapes, labour, trade, meals, and the people who gathered around the table.</p>
            <a href="/ingredients/" class="text-link">Explore the ingredients <span aria-hidden="true">→</span></a>
          </div>

          <figure class="ingredient-story__image">
            <EditorialImage id="ingredient-portrait-figs" fallbackArt="figs" alt="Fresh figs presented as a premium editorial ingredient study" ratio="4 / 5" class="ingredient-story__media" />
            <figcaption>
              <span>01</span>
              <p>The ingredients of Scripture are also the ingredients of daily life.</p>
            </figcaption>
          </figure>
        </div>

        <div class="ingredient-story__principles" aria-label="How BiblicalMeal explores ingredients">
          <article><span>01</span><h3>Scripture</h3><p>Where food appears in the biblical text and how it is understood in context.</p></article>
          <article><span>02</span><h3>History</h3><p>What archaeology, geography, trade, and food culture can responsibly tell us.</p></article>
          <article><span>03</span><h3>The ingredient</h3><p>The material reality of what was grown, gathered, prepared, and eaten.</p></article>
          <article><span>04</span><h3>The table</h3><p>How evidence can inspire a careful culinary reconstruction for today.</p></article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .home-page { background: #f2ecdf; }
  .hero { position: relative; isolation: isolate; min-height: min(50rem, calc(100svh - 4.5rem)); overflow: hidden; color: #f4eee0; background: #10170f; }
  .hero__image, .hero__veil { position: absolute; inset: 0; }
  .hero__image { z-index: -3; left: 38%; }
  .hero__image :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.78) sepia(.12) contrast(1.04) brightness(.82); }
  .hero__veil { z-index: -2; background: linear-gradient(90deg, #0b110b 0%, #0b110b 30%, rgba(11,17,11,.97) 40%, rgba(11,17,11,.68) 53%, rgba(11,17,11,.14) 73%, rgba(11,17,11,.04) 100%), linear-gradient(0deg, rgba(4,8,5,.45), transparent 42%); }
  .hero__shell { position: relative; display: flex; align-items: center; min-height: min(50rem, calc(100svh - 4.5rem)); padding-top: clamp(3rem, 7vw, 6.5rem); padding-bottom: clamp(3rem, 8vw, 6rem); }
  .hero__copy { width: min(36rem, 52%); }
  .hero__eyebrow, .hero__scripture-label, .section-kicker { margin: 0 0 1.25rem; color: #c9a76a; font-family: var(--font-sans, Arial, sans-serif); font-size: .63rem; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
  .hero h1 { margin: 0; font-family: var(--font-display, Georgia, serif); font-size: clamp(3.9rem, 6.4vw, 6.8rem); font-weight: 400; line-height: .94; letter-spacing: -.035em; color: #f3eddf; }
  .hero h1 em, .ingredient-story h2 em { color: #c69a56; font-style: normal; }
  .hero__ornament { display: flex; align-items: center; gap: .55rem; width: 11rem; margin: 1.7rem 0 1.65rem; color: #a77b3d; }
  .hero__ornament span { height: 1px; flex: 1; background: currentColor; opacity: .72; } .hero__ornament b { font-size: .9rem; font-weight: 400; }
  .hero__lead { max-width: 32rem; margin: 0; color: rgba(244,238,224,.72); font-size: clamp(.92rem, 1.1vw, 1.02rem); line-height: 1.9; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; }
  .hero__primary, .hero__secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 1.4rem; font-family: var(--font-sans, Arial, sans-serif); font-size: .61rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; transition: transform .2s ease, background .2s ease, border-color .2s ease; }
  .hero__primary { gap: 1.7rem; color: #1c170f; background: #c49a57; } .hero__secondary { color: #efe6d5; border: 1px solid rgba(240,228,204,.32); }
  .hero__primary:hover, .hero__secondary:hover { transform: translateY(-2px); } .hero__primary:hover { background: #d1aa68; } .hero__secondary:hover { border-color: rgba(240,228,204,.72); }
  .hero__principles { display: flex; align-items: center; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; color: #b89458; font-family: var(--font-sans, Arial, sans-serif); font-size: .57rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .hero__principles i { width: .24rem; height: .24rem; border-radius: 50%; background: #8f6b39; }
  .hero__scripture { position: absolute; z-index: 2; right: clamp(1.5rem, 7vw, 9rem); bottom: clamp(1.5rem, 8vw, 5.5rem); width: min(18rem, 26vw); padding: 1.35rem 1.45rem; border: 1px solid rgba(199,158,88,.28); background: rgba(13,22,13,.74); backdrop-filter: blur(8px); }
  .hero__scripture-label { display: block; margin-bottom: .75rem; font-size: .55rem; } .hero__scripture blockquote { margin: 0 0 .9rem; font-family: var(--font-display, Georgia, serif); font-size: 1.1rem; font-style: italic; line-height: 1.45; color: #f2eadb; } .hero__scripture cite { color: #b89250; font-family: var(--font-sans, Arial, sans-serif); font-size: .56rem; font-style: normal; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }

  .ingredient-story { position: relative; overflow: hidden; padding: clamp(6rem, 11vw, 10rem) 0 clamp(5rem, 9vw, 8rem); background: #f2ecdf; color: #24231e; }
  .ingredient-story::before { content: ''; position: absolute; top: 0; left: 0; width: min(58rem, 62vw); height: 1px; background: #bca778; opacity: .55; }
  .ingredient-story__shell { position: relative; }
  .ingredient-story__intro { width: min(49rem, 100%); margin-bottom: clamp(3.5rem, 7vw, 7rem); }
  .section-kicker { color: #7c6b46; margin-bottom: 1.4rem; }
  .ingredient-story h2 { margin: 0; max-width: 11ch; font-family: var(--font-display, Georgia, serif); font-size: clamp(4rem, 8vw, 8.5rem); font-weight: 400; line-height: .88; letter-spacing: -.05em; }
  .ingredient-story__content { display: grid; grid-template-columns: minmax(18rem, .92fr) minmax(22rem, 1.08fr); gap: clamp(3rem, 9vw, 10rem); align-items: center; }
  .ingredient-story__copy { max-width: 31rem; padding-left: clamp(0rem, 3vw, 3rem); }
  .ingredient-story__lead { margin: 0 0 1.6rem; font-family: var(--font-display, Georgia, serif); font-size: clamp(1.55rem, 2.15vw, 2.25rem); line-height: 1.34; letter-spacing: -.025em; }
  .ingredient-story__copy > p:not(.ingredient-story__lead) { margin: 0; max-width: 30rem; color: #706b60; font-size: .95rem; line-height: 1.9; }
  .text-link { display: inline-flex; gap: 1.4rem; margin-top: 2.4rem; padding-bottom: .55rem; border-bottom: 1px solid #9a865d; color: #27271f; font-family: var(--font-sans, Arial, sans-serif); font-size: .62rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .ingredient-story__image { position: relative; margin: 0; max-width: 36rem; justify-self: end; }
  .ingredient-story__image :global(img) { display: block; width: 100%; height: auto; object-fit: cover; filter: saturate(.86) contrast(1.02); }
  .ingredient-story__image::after { content: ''; position: absolute; inset: 1.5rem -1.5rem -1.5rem 1.5rem; z-index: -1; border: 1px solid rgba(154,134,93,.55); }
  .ingredient-story figcaption { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; align-items: start; width: min(24rem, 82%); margin-top: 1.6rem; color: #6d6657; }
  .ingredient-story figcaption span { color: #aa8952; font-family: var(--font-sans, Arial, sans-serif); font-size: .58rem; font-weight: 700; letter-spacing: .15em; }
  .ingredient-story figcaption p { margin: 0; font-family: var(--font-display, Georgia, serif); font-size: 1.05rem; font-style: italic; line-height: 1.45; }
  .ingredient-story__principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: clamp(6rem, 12vw, 11rem); padding-top: 2rem; border-top: 1px solid rgba(109,102,87,.25); }
  .ingredient-story__principles article { min-width: 0; }
  .ingredient-story__principles span { display: block; margin-bottom: 1.35rem; color: #a38451; font-family: var(--font-sans, Arial, sans-serif); font-size: .56rem; font-weight: 700; letter-spacing: .16em; }
  .ingredient-story__principles h3 { margin: 0 0 .75rem; font-family: var(--font-display, Georgia, serif); font-size: 1.4rem; font-weight: 400; }
  .ingredient-story__principles p { margin: 0; color: #777064; font-size: .82rem; line-height: 1.75; }

  @media (max-width: 980px) { .hero { min-height: auto; } .hero__image { left: 20%; } .hero__copy { width: min(38rem, 62%); } .hero__scripture { width: min(17rem, 32vw); right: 2rem; } .ingredient-story__content { gap: 4rem; } .ingredient-story__principles { grid-template-columns: repeat(2, 1fr); row-gap: 3.5rem; } }
  @media (max-width: 760px) { .hero__image { left: 0; } .hero__veil { background: linear-gradient(180deg, rgba(7,12,7,.2) 0%, rgba(7,12,7,.6) 36%, #0b110b 72%), linear-gradient(90deg, rgba(7,12,7,.78), rgba(7,12,7,.12)); } .hero__shell { align-items: flex-end; min-height: 43rem; padding-top: 18rem; } .hero__copy { width: 100%; } .hero h1 { font-size: clamp(3.25rem, 13vw, 5.5rem); } .hero__lead { max-width: 34rem; } .hero__scripture { position: static; width: auto; margin: 0 1rem 1rem; background: rgba(13,22,13,.86); } .ingredient-story { padding-top: 5.5rem; } .ingredient-story h2 { font-size: clamp(3.7rem, 13vw, 6.5rem); } .ingredient-story__content { grid-template-columns: 1fr; gap: 3.5rem; } .ingredient-story__copy { padding-left: 0; } .ingredient-story__image { width: min(100%, 36rem); justify-self: start; } .ingredient-story__principles { margin-top: 5.5rem; } }
  @media (max-width: 520px) { .hero__shell { min-height: 42rem; padding-top: 15rem; padding-bottom: 2.25rem; } .hero__eyebrow { margin-bottom: 1rem; } .hero h1 { font-size: clamp(3rem, 15vw, 4.7rem); line-height: .96; } .hero__lead { font-size: .92rem; line-height: 1.75; } .hero__actions { display: grid; grid-template-columns: 1fr; } .hero__primary, .hero__secondary { width: 100%; min-height: 3.45rem; } .hero__principles { gap: .55rem; line-height: 1.8; } .ingredient-story { padding-top: 4.5rem; padding-bottom: 4.5rem; } .ingredient-story__intro { margin-bottom: 3.5rem; } .ingredient-story h2 { font-size: clamp(3.5rem, 16vw, 5.1rem); } .ingredient-story__lead { font-size: 1.55rem; } .ingredient-story__image::after { inset: 1rem -1rem -1rem 1rem; } .ingredient-story__principles { grid-template-columns: 1fr; gap: 2.6rem; margin-top: 4.5rem; } .ingredient-story figcaption { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero__primary, .hero__secondary { transition: none; } }
</style>
