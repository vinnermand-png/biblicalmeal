---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import SiteFooter from '../components/common/SiteFooter.astro';

const HOME_DESCRIPTION =
  'Explore the foods of the Bible through ingredients, recipes, regions, history, and the culinary traditions of the ancient world.';
---

<BaseLayout title={undefined} description={HOME_DESCRIPTION}>
  <Header />

  <main id="main" class="home-page">
    <!-- Fresh landing page canvas. New sections will be built here from scratch. -->
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .home-page {
    min-height: 1px;
    background: #f2ecdf;
  }
</style>
