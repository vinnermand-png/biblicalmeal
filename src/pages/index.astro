---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import SiteFooter from '../components/common/SiteFooter.astro';

const HOME_DESCRIPTION =
  'Explore the foods of the Bible — ingredients, recipes, history, and culinary traditions of the ancient world, brought thoughtfully to the modern table.';
---

<BaseLayout title={undefined} description={HOME_DESCRIPTION}>
  <Header />
  <main id="main" class="home-reset">
    <section class="home-reset__canvas" aria-label="BiblicalMeal">
      <div class="container-site home-reset__inner">
        <p class="home-reset__eyebrow">BiblicalMeal</p>
        <h1>A new table is being prepared.</h1>
        <p>
          The landing page is being rebuilt from the ground up around one new visual direction.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .home-reset {
    min-height: 100vh;
    background: var(--color-background, #f5f0e6);
  }

  .home-reset__canvas {
    display: flex;
    min-height: min(72vh, 760px);
    align-items: center;
    padding: 7rem 0 5rem;
  }

  .home-reset__inner {
    max-width: 46rem;
  }

  .home-reset__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-terracotta, #a85d38);
  }

  .home-reset h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: var(--color-ink, #27241f);
  }

  .home-reset__inner > p:last-child {
    max-width: 34rem;
    margin: 2rem 0 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-ink-muted, #746e65);
  }

  @media (max-width: 640px) {
    .home-reset__canvas {
      min-height: 64vh;
      padding: 6rem 0 4rem;
    }

    .home-reset__inner > p:last-child {
      font-size: 0.98rem;
    }
  }
</style>
