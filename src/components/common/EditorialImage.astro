---
import {
  getEditorialImage,
  getEditorialImageAlt,
  getEditorialImageDimensions,
} from '../../lib/editorial-images';
import type { ArtKind } from '../../lib/visuals';
import FoodIllustration from './FoodIllustration.astro';

interface Props {
  id?: string;
  fallbackArt: ArtKind;
  alt?: string;
  decorative?: boolean;
  ratio?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fit?: 'cover' | 'contain';
}

const {
  id,
  fallbackArt,
  alt,
  decorative = false,
  ratio,
  class: className = '',
  loading = 'lazy',
  fit = 'cover',
} = Astro.props;
const asset = getEditorialImage(id);
const dimensions = getEditorialImageDimensions(asset);
const useGenerated = asset?.status === 'generated';
const imageAlt = decorative ? '' : getEditorialImageAlt(asset, alt);
const fetchPriority = loading === 'eager' ? 'high' : 'auto';
const imageFitClass = fit === 'contain' ? 'object-contain' : 'object-cover';
---

<div
  class:list={['relative overflow-hidden', className]}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  {
    useGenerated && asset ? (
      <img
        src={asset.publicPath}
        alt={imageAlt}
        width={dimensions?.width}
        height={dimensions?.height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchPriority}
        class:list={[
          'absolute inset-0 h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.025]',
          imageFitClass,
        ]}
      />
    ) : decorative ? (
      <div aria-hidden="true" class="absolute inset-0">
        <FoodIllustration kind={fallbackArt} ratio={ratio} />
      </div>
    ) : (
      <FoodIllustration
        kind={fallbackArt}
        label={imageAlt || undefined}
        ratio={ratio}
      />
    )
  }
</div>
