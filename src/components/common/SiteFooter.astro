---
import { SITE } from '../../config';
---

<footer class="bm-home-footer">
  <div class="bm-home-container bm-home-footer__grid">
    <div>
      <a href="/" class="bm-footer-brand">BIBLICALMEAL<span>.</span></a>
      <p>Bringing the biblical world to the modern table.</p>
    </div>
    <nav aria-label="Explore">
      <h2>Explore</h2>
      <a href="/ingredients/">Ingredients</a>
      <a href="/recipes/">Recipes</a>
      <a href="/articles/">Journal</a>
      <a href="/sources/">Scripture</a>
    </nav>
    <nav aria-label="About">
      <h2>About</h2>
      <a href="/editorial-method/">About BiblicalMeal</a>
      <a href="/editorial-method/">Our Mission</a>
      <a href="/privacy">Contact</a>
    </nav>
    <nav aria-label="Resources">
      <h2>Resources</h2>
      <a href="/sources/">Research</a>
      <a href="/sources/">Glossary</a>
      <a href="/editorial-method/">Team</a>
      <a href="/faq/">FAQ</a>
    </nav>
    <div id="newsletter" class="bm-footer-subscribe">
      <h2>Stay connected</h2>
      <p>Subscribe for new articles, recipes and updates.</p>
      <form>
        <label>
          <span class="sr-only">Email address</span>
          <input
            id="footer-email"
            type="email"
            placeholder="Email address"
            autocomplete="email"
          />
        </label>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>
  <div class="bm-home-container bm-home-footer__bottom">
    <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
    <div>
      <button type="button" aria-label="Instagram">IG</button>
      <button type="button" aria-label="Pinterest">P</button>
      <button type="button" aria-label="YouTube">YT</button>
      <button type="button" aria-label="Facebook">F</button>
    </div>
  </div>
</footer>
