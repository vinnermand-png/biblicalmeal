---
import type { ArtKind } from '../../lib/visuals';
import FoodIllustration from './FoodIllustration.astro';
type HeroVariant='editorial'|'food'|'recipe'|'article'|'listing';
interface Props{eyebrow:string;title:string;lead?:string;art?:ArtKind;variant?:HeroVariant;}
const {eyebrow,title,lead,art}=Astro.props;
const variant:HeroVariant=Astro.props.variant??(eyebrow.includes('Foods of')?'food':art?'editorial':'listing');
const variantClass=`content-hero content-hero--${variant}`;
---
<section class={variantClass}><div class="content-hero__wash" aria-hidden="true"></div><div class="container-site content-hero__grid"><div class="content-hero__copy"><slot name="breadcrumbs"/><p class="mt-5 font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase first:mt-0">{eyebrow}</p><h1 class="mt-3 max-w-4xl font-display text-h1 text-ink">{title}</h1>{lead&&<p class="mt-5 max-w-2xl text-body-lg text-ink-muted">{lead}</p>}<slot name="meta"/></div>{art&&<div class="content-hero__art media-frame"><FoodIllustration kind={art} ratio={variant==='recipe'?'4 / 5':variant==='food'?'1 / 1':'4 / 3'}/></div>}</div></section>
