---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import { statusChip } from '../../lib/content';
import Chip from './Chip.astro';
import EditorialImage from './EditorialImage.astro';

type RecipeEntry = CollectionEntry<'recipes'>;
const TYPE_CHIPS = {
  inspired: { variant: 'inspired', label: 'Biblical-inspired' },
  researched: { variant: 'inspired', label: 'Historically researched' },
  reconstructed: { variant: 'review', label: 'Reconstruction' },
} as const;
interface Props {
  entry: RecipeEntry;
}
const { entry } = Astro.props;
const href = `/recipes/${entry.id}/`;
const art: ArtKind = entry.data.art ?? 'stew';
const chip = statusChip(entry.data.status);
const meta = [
  entry.data.prepMinutes != null && `Prep ${entry.data.prepMinutes} min`,
  entry.data.cookMinutes != null && `Cook ${entry.data.cookMinutes} min`,
  entry.data.servings != null && `Serves ${entry.data.servings}`,
].filter(Boolean) as string[];
---

<a href={href} class="recipe-card group">
  <div class="recipe-card__media">
    <EditorialImage
      id="journal-meal-preparation"
      fallbackArt={art}
      ratio="4 / 3"
      alt="A restrained still life of ingredients and handmade vessels in a BiblicalMeal kitchen"
    />
    <div class="recipe-card__chips">
      {chip && <Chip variant={chip} class="recipe-chip" />}
      <Chip
        variant={TYPE_CHIPS[entry.data.recipeType].variant}
        label={TYPE_CHIPS[entry.data.recipeType].label}
        class="recipe-chip"
      />
    </div>
  </div>
  <div class="recipe-card__body">
    <p class="recipe-card__eyebrow">From the kitchen</p>
    <h3 class="recipe-card__title">{entry.data.title}</h3>
    <p class="recipe-card__desc">{entry.data.description}</p>
    {meta.length > 0 && <p class="recipe-card__meta">{meta.join(' · ')}</p>}
  </div>
</a>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color 280ms ease,
      box-shadow 280ms ease,
      transform 280ms ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .recipe-card:hover {
      border-color: color-mix(
        in srgb,
        var(--color-olive) 28%,
        var(--color-line)
      );
      box-shadow: 0 12px 36px rgb(41 32 24 / 0.07);
      transform: translateY(-3px);
    }
    .recipe-card:hover :global(img) {
      transform: scale(1.025);
    }
  }

  .recipe-card__media {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }
  .recipe-card__media :global(img) {
    transition: transform 380ms ease-out;
    filter: saturate(0.92) contrast(0.98);
  }

  .recipe-card__chips {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .recipe-card__chips :global(.recipe-chip) {
    border-radius: 4px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(28 26 22 / 0.65);
    backdrop-filter: blur(6px);
    color: rgb(244 240 231 / 0.88);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    padding: 3px 8px;
  }

  .recipe-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    padding: clamp(20px, 3vw, 28px);
  }

  .recipe-card__eyebrow {
    margin: 0;
    color: var(--color-olive-dark);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .recipe-card__title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color 220ms ease;
  }
  .recipe-card:hover .recipe-card__title {
    color: var(--color-terracotta-dark);
  }

  .recipe-card__desc {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe-card__meta {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    color: var(--color-olive-dark);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
</style>
