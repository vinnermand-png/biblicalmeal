---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import { statusChip } from '../../lib/content';
import Chip from './Chip.astro';
import EditorialImage from './EditorialImage.astro';
import FoodIllustration from './FoodIllustration.astro';

type RecipeEntry = CollectionEntry<'recipes'>;
const TYPE_CHIPS = {
  inspired: { variant: 'inspired', label: 'Biblical-inspired' },
  researched: { variant: 'inspired', label: 'Historically researched' },
  reconstructed: { variant: 'review', label: 'Reconstruction' },
} as const;
interface Props {
  entry: RecipeEntry;
}
const { entry } = Astro.props;
const href = `/recipes/${entry.id}/`;
const art: ArtKind = entry.data.art ?? 'stew';
const chip = statusChip(entry.data.status);
const meta = [
  entry.data.prepMinutes != null && `Prep ${entry.data.prepMinutes} min`,
  entry.data.cookMinutes != null && `Cook ${entry.data.cookMinutes} min`,
  entry.data.servings != null && `Serves ${entry.data.servings}`,
].filter(Boolean) as string[];
---

<a
  href={href}
  class="editorial-card group relative flex h-full flex-col overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
>
  <div class="relative overflow-hidden border-b border-line bg-background-alt">
    <div class="recipe-card__photo">
      <EditorialImage
        id="journal-meal-preparation"
        fallbackArt={art}
        ratio="4 / 3"
        alt="A restrained still life of ingredients and handmade vessels in a BiblicalMeal kitchen"
      />
    </div>
    <div class="recipe-card__illustration" aria-hidden="true">
      <FoodIllustration kind={art} ratio="4 / 3" />
    </div>
    <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
      {chip && <Chip variant={chip} class="bg-surface/95 shadow-xs" />}
      <Chip
        variant={TYPE_CHIPS[entry.data.recipeType].variant}
        label={TYPE_CHIPS[entry.data.recipeType].label}
        class="bg-surface/95 shadow-xs"
      />
    </div>
  </div>
  <div class="flex grow flex-col gap-3 p-6">
    <p
      class="font-sans text-caption font-semibold tracking-eyebrow text-olive-dark uppercase"
    >
      From the kitchen
    </p>
    <h3
      class="font-display text-h3 text-ink transition-colors duration-200 group-hover:text-terracotta-dark"
    >
      {entry.data.title}
    </h3>
    <p class="line-clamp-2 text-body text-ink-muted">
      {entry.data.description}
    </p>
    {
      meta.length > 0 && (
        <p class="mt-auto border-t border-line pt-4 font-sans text-caption font-medium tracking-wide text-olive-dark">
          {meta.join(' · ')}
        </p>
      )
    }
  </div>
</a>

<style>
  .recipe-card__photo {
    position: relative;
    z-index: 0;
  }
  .recipe-card__photo :global(img) {
    filter: saturate(0.9) contrast(0.98);
  }
  .recipe-card__illustration {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.24;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .recipe-card__illustration :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
