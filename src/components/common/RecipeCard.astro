---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import EditorialImage from './EditorialImage.astro';

type RecipeEntry = CollectionEntry<'recipes'>;

interface Props {
  entry: RecipeEntry;
}

const { entry } = Astro.props;
const href = `/recipes/${entry.id}/`;
const art: ArtKind = entry.data.art ?? 'stew';
const classification = {
  inspired: 'Biblical-inspired',
  researched: 'Historically researched',
  reconstructed: 'Historical reconstruction',
} as const;
const meta = [
  entry.data.prepMinutes != null && `Prep ${entry.data.prepMinutes} min`,
  entry.data.cookMinutes != null && `Cook ${entry.data.cookMinutes} min`,
  entry.data.servings != null && `Serves ${entry.data.servings}`,
].filter(Boolean) as string[];
---

<a href={href} class="recipe-card group">
  <div class="recipe-card__media">
    <EditorialImage
      id="journal-meal-preparation"
      fallbackArt={art}
      ratio="4 / 3"
      alt={`A restrained still life for ${entry.data.title}`}
    />
  </div>
  <div class="recipe-card__body">
    <div class="recipe-card__labels">
      <p class="recipe-card__eyebrow">From the kitchen</p>
      <span class="recipe-card__classification">{classification[entry.data.recipeType]}</span>
    </div>
    <h3 class="recipe-card__title">{entry.data.title}</h3>
    <p class="recipe-card__desc">{entry.data.description}</p>
    {meta.length > 0 && <p class="recipe-card__meta">{meta.join(' · ')}</p>}
  </div>
</a>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .recipe-card:hover {
      border-color: color-mix(in srgb, var(--color-olive) 28%, var(--color-line));
      box-shadow: 0 14px 34px rgb(41 32 24 / 0.07);
      transform: translateY(-3px);
    }

    .recipe-card:hover :global(img) {
      transform: scale(1.025);
    }
  }

  .recipe-card__media {
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
  }

  .recipe-card__media :global(img) {
    transition: transform 380ms ease-out;
    filter: saturate(0.92) contrast(0.98);
  }

  .recipe-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.25rem, 2.3vw, 1.75rem);
  }

  .recipe-card__labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .recipe-card__eyebrow,
  .recipe-card__classification {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .recipe-card__eyebrow {
    color: var(--color-olive-dark);
  }

  .recipe-card__classification {
    color: var(--color-ink-muted);
    text-align: right;
  }

  .recipe-card__title {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.75vw, 1.8rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    transition: color 180ms ease;
  }

  .recipe-card:hover .recipe-card__title {
    color: var(--color-terracotta-dark);
  }

  .recipe-card__desc {
    display: -webkit-box;
    margin: 0.75rem 0 0;
    overflow: hidden;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .recipe-card__meta {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-olive-dark);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.5;
  }

  @media (max-width: 479px) {
    .recipe-card__labels {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .recipe-card__classification {
      text-align: left;
    }
  }
</style>
