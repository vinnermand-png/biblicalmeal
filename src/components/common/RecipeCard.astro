---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import { statusChip } from '../../lib/content';
import Chip from './Chip.astro';
import FoodIllustration from './FoodIllustration.astro';

type RecipeEntry = CollectionEntry<'recipes'>;

const TYPE_CHIPS = {
  inspired: { variant: 'inspired', label: 'Biblical-inspired' },
  researched: { variant: 'inspired', label: 'Historically researched' },
  reconstructed: { variant: 'review', label: 'Reconstruction' },
} as const;

interface Props {
  entry: RecipeEntry;
}

const { entry } = Astro.props;
const href = `/recipes/${entry.id}/`;
const art: ArtKind = entry.data.art ?? 'stew';
const chip = statusChip(entry.data.status);
const meta = [
  entry.data.prepMinutes != null && `Prep ${entry.data.prepMinutes} min`,
  entry.data.cookMinutes != null && `Cook ${entry.data.cookMinutes} min`,
  entry.data.servings != null && `Serves ${entry.data.servings}`,
].filter(Boolean) as string[];
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface shadow-xs transition-shadow duration-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
>
  <FoodIllustration kind={art} ratio="4 / 3" />
  <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
    {chip && <Chip variant={chip} class="bg-surface/90 backdrop-blur-sm" />}
    <Chip
      variant={TYPE_CHIPS[entry.data.recipeType].variant}
      label={TYPE_CHIPS[entry.data.recipeType].label}
      class="bg-surface/90 backdrop-blur-sm"
    />
  </div>
  <div class="flex grow flex-col gap-2 p-5">
    <h3 class="font-display text-h3 text-ink">{entry.data.title}</h3>
    <p class="line-clamp-2 text-body text-ink-muted">
      {entry.data.description}
    </p>
    {
      meta.length > 0 && (
        <p class="mt-auto pt-2 font-sans text-caption font-medium tracking-wide text-olive-dark">
          {meta.join(' · ')}
        </p>
      )
    }
  </div>
</a>
