---
interface LinkItem {
  title: string;
  href: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <nav class="border-t border-line pt-5" aria-label="Related BiblicalMeal content">
    <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">
      Continue exploring
    </p>
    <ul class="mt-3 space-y-3">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="group block rounded-lg bg-background-alt p-5 transition-colors hover:bg-gold/20"
          >
            <span class="font-display text-h3 text-ink">{link.title}</span>
            <span class="mt-2 block text-caption text-ink-muted">
              Explore this profile
              <span class="ml-1 text-terracotta transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
