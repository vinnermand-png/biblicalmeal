---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'secondary-dark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition-all duration-200 hover:-translate-y-px active:translate-y-0';

const variants = {
  primary:
    'bg-terracotta text-cream shadow-sm hover:bg-terracotta-dark focus-visible:outline-terracotta-dark',
  secondary:
    'border border-line bg-transparent text-ink hover:border-terracotta hover:text-terracotta-dark',
  'secondary-dark':
    'border border-line-dark bg-transparent text-cream hover:border-gold hover:text-gold',
} as const;

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2.5 text-[0.9375rem]',
  lg: 'px-7 py-3 text-base',
} as const;
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
  <slot />
</a>
