---
import MobileMenu from '../islands/MobileMenu.tsx';
import { NAV_LINKS, SITE } from '../../config';
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-background/88 backdrop-blur-md"
>
  <div class="container-site flex h-[4.5rem] items-center justify-between lg:h-[5rem]">
    <a
      href="/"
      class="font-display text-[1.05rem] font-semibold tracking-tight text-ink md:text-xl"
      aria-label={`${SITE.name} — home`}
    >
      BiblicalMeal<span class="text-terracotta">.</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="relative py-2 font-sans text-[0.62rem] font-semibold tracking-[0.16em] text-ink-muted uppercase transition-colors after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-terracotta after:transition-transform after:duration-200 hover:text-ink hover:after:scale-x-100"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#newsletter"
        class="bg-terracotta px-5 py-2.5 font-sans text-[0.6rem] font-semibold tracking-[0.16em] text-cream uppercase shadow-sm transition-all duration-200 hover:-translate-y-px hover:bg-terracotta-dark"
      >
        Newsletter
      </a>
    </nav>

    <MobileMenu client:load links={NAV_LINKS} />
  </div>
</header>
