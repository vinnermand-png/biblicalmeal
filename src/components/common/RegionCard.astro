---
import type { ArtKind } from '../../lib/visuals';
import FoodIllustration from './FoodIllustration.astro';
interface Props { name: string; description: string; art: ArtKind; }
const { name, description, art } = Astro.props;
---

<article class="region-card reveal group relative overflow-hidden border border-line bg-surface">
  <div class="region-card__art relative overflow-hidden"><FoodIllustration kind={art} ratio="16 / 9" /><div class="region-card__horizon" aria-hidden="true"></div></div>
  <div class="relative space-y-3 p-6"><p class="text-eyebrow font-semibold tracking-eyebrow text-terracotta/80 uppercase">Culinary geography</p><div class="flex items-start justify-between gap-4"><h3 class="font-display text-h3 text-ink">{name}</h3><span class="mt-3 h-px w-9 bg-gold/70"></span></div><p class="text-body text-ink-muted">{description}</p><p class="pt-2 text-caption text-ink-muted/70">Regional guide in development</p></div>
</article>

<style>
  .region-card { border-radius:var(--bm-card-radius); box-shadow:var(--bm-card-shadow); transition:transform var(--bm-motion-standard) ease, box-shadow var(--bm-motion-standard) ease; }
  .region-card__art { border-bottom:1px solid var(--color-line); background:var(--color-background-alt); }
  .region-card__horizon { position:absolute; left:0; right:0; bottom:0; height:22%; background:linear-gradient(180deg, transparent, rgb(41 32 24 / .08)); pointer-events:none; }
  @media (prefers-reduced-motion:no-preference) { .region-card:hover { transform:translateY(-3px); box-shadow:var(--bm-card-shadow-hover); } }
</style>
