---
import type { ArtKind } from '../../lib/visuals';
import FoodIllustration from './FoodIllustration.astro';
import EditorialImage from './EditorialImage.astro';

interface Props {
  name: string;
  description: string;
  art: ArtKind;
  imageId?: string;
}

const { name, description, art, imageId } = Astro.props;
---

<article class="region-card reveal group relative overflow-hidden border border-line bg-surface">
  <div class="region-card__art relative overflow-hidden">
    {imageId ? (
      <EditorialImage
        id={imageId}
        fallbackArt={art}
        ratio="16 / 10"
        alt={`${name} editorial atmosphere`}
        class="region-card__photo h-full"
      />
    ) : (
      <FoodIllustration kind={art} ratio="16 / 10" />
    )}
    <div class="region-card__horizon" aria-hidden="true"></div>
  </div>

  <div class="relative space-y-4 p-6 sm:p-7">
    <p class="text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">
      Culinary geography
    </p>
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-h3 text-ink">{name}</h3>
      <span class="mt-3 h-px w-8 shrink-0 bg-gold/70"></span>
    </div>
    <p class="text-body leading-relaxed text-ink-muted">{description}</p>
    <span class="inline-flex items-center gap-2 pt-1 font-sans text-caption font-semibold tracking-wide text-terracotta uppercase">
      Explore <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</article>

<style>
  .region-card {
    border-radius: 0.45rem;
    box-shadow: 0 10px 26px rgb(41 32 24 / 0.045);
    transition:
      transform var(--bm-motion-standard) ease,
      box-shadow var(--bm-motion-standard) ease,
      border-color var(--bm-motion-standard) ease;
  }
  .region-card__art {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-background-alt);
  }
  .region-card__photo {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  .region-card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) sepia(0.04);
    transition: transform 700ms ease;
  }
  .region-card__horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, rgb(28 24 18 / 0.18));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .region-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 38px rgb(41 32 24 / 0.09);
      border-color: color-mix(in srgb, var(--color-terracotta) 24%, var(--color-line));
    }
    .region-card:hover .region-card__photo :global(img) {
      transform: scale(1.025);
    }
  }
</style>
