---
import Chip from './Chip.astro';

interface Props {
  title?: string;
  message: string;
  showDevChip?: boolean;
}

const {
  title = 'Research in progress',
  message,
  showDevChip = false,
} = Astro.props;
---

<div
  class="rounded-xl border border-dashed border-line-dark bg-background-alt p-6 sm:p-8"
>
  <div class="flex flex-wrap items-center gap-3">
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="size-6 text-gold"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 21v-8m0 0a5 5 0 0 1-5-5V5a5 5 0 0 1 5 5m0 3a5 5 0 0 0 5-5V5a5 5 0 0 0-5 5"
      ></path>
    </svg>
    <h2 class="font-display text-h3 text-ink">{title}</h2>
    {showDevChip && <Chip variant="dev" />}
  </div>
  <p class="mt-3 max-w-prose text-body text-ink-muted">{message}</p>
</div>
