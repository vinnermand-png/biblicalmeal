---
interface Props {
  label?: string;
  ratio?: string;
  variant?: 'light' | 'dark';
  class?: string;
}

const {
  label = 'Editorial image',
  ratio = '4 / 5',
  variant = 'light',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['bm-image-placeholder', `bm-image-placeholder--${variant}`, className]}
  style={`aspect-ratio:${ratio}`}
  aria-label={`${label} placeholder`}
  role="img"
>
  <span>{label}</span>
</div>

<style>
  .bm-image-placeholder {
    position: relative;
    display: grid;
    place-items: end start;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid #d8d0c2;
    background:
      radial-gradient(circle at 75% 18%, rgb(255 255 255 / 0.5), transparent 32%),
      linear-gradient(145deg, #ece7dc, #ddd5c7 72%, #d6cdbf);
  }
  .bm-image-placeholder::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: '';
    opacity: 0.2;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgb(88 74 56 / 0.05) 4px 5px);
    mix-blend-mode: multiply;
  }
  .bm-image-placeholder > span {
    position: relative;
    z-index: 1;
    margin: 1rem;
    padding: 0.42rem 0.6rem;
    border: 1px solid rgb(111 101 88 / 0.14);
    background: rgb(245 242 234 / 0.7);
    color: #756c60;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bm-image-placeholder--dark {
    border-color: rgb(255 255 255 / 0.12);
    background:
      radial-gradient(circle at 72% 20%, rgb(186 165 122 / 0.16), transparent 34%),
      linear-gradient(145deg, #4b463d, #2e2b26 72%, #27241f);
  }
  .bm-image-placeholder--dark > span {
    border-color: rgb(245 242 234 / 0.14);
    background: rgb(28 26 22 / 0.45);
    color: rgb(245 242 234 / 0.7);
  }
</style>
