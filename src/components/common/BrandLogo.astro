---
interface Props {
  variant?: 'light' | 'dark';
  compact?: boolean;
}

const { variant = 'dark', compact = false } = Astro.props;
---

<a
  href="/"
  class:list={['brand-logo', `brand-logo--${variant}`, { 'brand-logo--compact': compact }]}
  aria-label="BiblicalMeal — home"
>
  <span class="brand-logo__seal" aria-hidden="true">
    <svg viewBox="0 0 48 48" role="presentation" focusable="false">
      <circle cx="24" cy="24" r="21.5" fill="none" />
      <path d="M24 12.5v22.5" />
      <path d="M24 18.5c-4.2-1.6-7.2-4.2-9.1-7.6" />
      <path d="M24 23c4.2-1.6 7.2-4.2 9.1-7.6" />
      <path d="M24 27.5c-4.2-1.6-7.2-4.2-9.1-7.6" />
      <path d="M24 32c4.2-1.6 7.2-4.2 9.1-7.6" />
      <path d="M17.7 35.7c2.3 1.1 4.4 1.7 6.3 1.8 1.9-.1 4-.7 6.3-1.8" />
    </svg>
  </span>

  <span class="brand-logo__wordmark">
    <span class="brand-logo__name">BiblicalMeal</span><span class="brand-logo__dot">.</span>
    <span class="brand-logo__descriptor">Foods of the Bible</span>
  </span>
</a>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: .72rem;
    min-width: 0;
    color: #202117;
    text-decoration: none;
  }

  .brand-logo--light { color: #f4eee0; }

  .brand-logo__seal {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    place-items: center;
    color: #b88a49;
    opacity: .95;
  }

  .brand-logo__seal svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-logo__wordmark {
    display: grid;
    gap: .16rem;
    line-height: 1;
  }

  .brand-logo__name {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.14rem;
    font-weight: 600;
    letter-spacing: -.035em;
  }

  .brand-logo__dot { color: #c49a57; }

  .brand-logo__descriptor {
    color: currentColor;
    font-family: var(--font-sans, Arial, sans-serif);
    font-size: .42rem;
    font-weight: 700;
    letter-spacing: .19em;
    opacity: .55;
    text-transform: uppercase;
  }

  .brand-logo--compact .brand-logo__seal { width: 2rem; height: 2rem; }
  .brand-logo--compact .brand-logo__name { font-size: 1rem; }
  .brand-logo--compact .brand-logo__descriptor { display: none; }

  @media (max-width: 640px) {
    .brand-logo { gap: .55rem; }
    .brand-logo__seal { width: 2.1rem; height: 2.1rem; }
    .brand-logo__name { font-size: 1.02rem; }
  }
</style>
