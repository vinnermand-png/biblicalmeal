---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import {
  INGREDIENT_ART,
  INGREDIENT_PREMIUM_IMAGE_IDS,
} from '../../lib/visuals';
import { statusChip } from '../../lib/content';
import Chip from './Chip.astro';
import EditorialImage from './EditorialImage.astro';

type IngredientEntry = CollectionEntry<'ingredients'>;
interface Props {
  entry: IngredientEntry;
  baseHref?: string;
  allowGeneratedOnSubpage?: boolean;
}
const {
  entry,
  baseHref = '/ingredients',
  allowGeneratedOnSubpage = false,
} = Astro.props;
const publicFoodPath = ['figs', 'dates'].includes(entry.id)
  ? `/foods/${entry.id}/`
  : `${baseHref}/${entry.id}/`;
const href = publicFoodPath;
const art: ArtKind = entry.data.art ?? INGREDIENT_ART[entry.id] ?? 'still-life';
const chip = statusChip(entry.data.status);
const premiumImageId = INGREDIENT_PREMIUM_IMAGE_IDS[entry.id];
---

<a
  href={href}
  class="ingredient-card group relative block overflow-hidden border border-line bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
>
  <div class="ingredient-card__art relative overflow-hidden">
    <EditorialImage
      id={premiumImageId}
      fallbackArt={art}
      ratio="1 / 1"
      fit="contain"
      alt={`${entry.data.name} ingredient portrait`}
      allowGeneratedOnSubpage={allowGeneratedOnSubpage}
    />
    <span class="ingredient-card__wash" aria-hidden="true"></span>
    <span class="ingredient-card__veil" aria-hidden="true"></span>
  </div>
  {
    chip && (
      <Chip
        variant={chip}
        class="absolute top-4 left-4 z-10 bg-surface/92 backdrop-blur-sm"
      />
    )
  }
  <div class="space-y-3 p-5 sm:p-6">
    <h3 class="font-display text-h3 text-ink">{entry.data.name}</h3>
    <p
      class="line-clamp-3 min-h-[3.5rem] text-body leading-relaxed text-ink-muted"
    >
      {entry.data.description}
    </p>
    <span
      class="inline-flex items-center gap-2 pt-1 font-sans text-caption font-semibold tracking-wide text-terracotta uppercase"
      ><span>Explore</span><span
        class="transition-transform duration-300 group-hover:translate-x-1"
        >→</span
      ></span
    >
  </div>
</a>

<style>
  .ingredient-card {
    min-width: 0;
    border-radius: 0.45rem;
    box-shadow: 0 10px 26px rgb(41 32 24 / 0.045);
    transition:
      transform var(--bm-motion-standard) ease,
      box-shadow var(--bm-motion-standard) ease,
      border-color var(--bm-motion-standard) ease;
  }
  .ingredient-card__art {
    min-height: 14rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-background-alt);
  }
  .ingredient-card__art :global(img) {
    object-fit: contain;
    padding: 0.55rem;
  }
  .ingredient-card__wash,
  .ingredient-card__veil {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ingredient-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 38px rgb(41 32 24 / 0.1);
      border-color: color-mix(
        in srgb,
        var(--color-terracotta) 26%,
        var(--color-line)
      );
    }
  }
</style>
