---
import type { CollectionEntry } from 'astro:content';
import type { ArtKind } from '../../lib/visuals';
import { INGREDIENT_ART } from '../../lib/visuals';
import { statusChip } from '../../lib/content';
import Chip from './Chip.astro';
import FoodIllustration from './FoodIllustration.astro';

type IngredientEntry = CollectionEntry<'ingredients'>;
interface Props { entry: IngredientEntry; baseHref?: string; }
const { entry, baseHref = '/ingredients' } = Astro.props;
const publicFoodPath = ['figs', 'dates'].includes(entry.id) ? `/foods/${entry.id}/` : `${baseHref}/${entry.id}/`;
const href = publicFoodPath;
const art: ArtKind = entry.data.art ?? INGREDIENT_ART[entry.id] ?? 'still-life';
const chip = statusChip(entry.data.status);
---

<a href={href} class="ingredient-card group relative block overflow-hidden border border-line bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta">
  <div class="ingredient-card__art relative overflow-hidden"><FoodIllustration kind={art} ratio="4 / 3" /><span class="ingredient-card__wash" aria-hidden="true"></span></div>
  {chip && <Chip variant={chip} class="absolute top-4 left-4 z-10 bg-surface/92 backdrop-blur-sm" />}
  <div class="space-y-3 p-6"><div class="flex items-start justify-between gap-4"><h3 class="font-display text-h3 text-ink">{entry.data.name}</h3><span class="mt-2 h-px w-8 bg-gold/70 transition-all duration-300 group-hover:w-11"></span></div><p class="line-clamp-3 text-body text-ink-muted">{entry.data.description}</p><span aria-hidden="true" class="inline-flex items-center gap-2 pt-2 font-sans text-caption font-semibold tracking-wide text-terracotta uppercase"><span>Explore</span><span class="transition-transform duration-300 group-hover:translate-x-1">→</span></span></div>
</a>

<style>
  .ingredient-card { border-radius:var(--bm-card-radius); box-shadow:var(--bm-card-shadow); transition:transform var(--bm-motion-standard) ease, box-shadow var(--bm-motion-standard) ease, border-color var(--bm-motion-standard) ease; }
  .ingredient-card__art { border-bottom:1px solid var(--color-line); background:var(--color-background-alt); }
  .ingredient-card__wash { position:absolute; inset:auto -20% -45%; height:70%; border-radius:50%; background:radial-gradient(circle, rgb(201 162 75 / .15), transparent 68%); pointer-events:none; }
  @media (prefers-reduced-motion:no-preference) { .ingredient-card:hover { transform:translateY(-4px); box-shadow:var(--bm-card-shadow-hover); border-color:color-mix(in srgb, var(--color-terracotta) 32%, var(--color-line)); } }
</style>
