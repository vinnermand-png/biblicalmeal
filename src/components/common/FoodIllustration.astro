---
import { ART_REGISTRY, type ArtKind } from '../../lib/visuals';

interface Props {
  kind: ArtKind;
  /** Override the registry's accessible description if needed. */
  label?: string;
  /** Fixed aspect ratio via inline style (e.g. "4 / 3"). Omit to control via class. */
  ratio?: string;
  class?: string;
}

const { kind, label, ratio, class: className = '' } = Astro.props;

const meta = ART_REGISTRY[kind];
const alt = label ?? meta.label;

// Stable-per-build unique suffix so gradient ids never collide across instances.
const uid = Math.random().toString(36).slice(2, 9);
const [backdropFrom, backdropTo] = meta.backdrop;
---

<div
  class:list={['relative overflow-hidden', className]}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 400 400"
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-label={alt}
    class="absolute inset-0 h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]"
  >
    <defs>
      <linearGradient id={`bg-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={backdropFrom}></stop>
        <stop offset="1" stop-color={backdropTo}></stop>
      </linearGradient>
      <radialGradient id={`sun-${uid}`} cx="0.74" cy="0.18" r="0.75">
        <stop offset="0" stop-color="#fff6de" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#fff6de" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`floor-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#000000" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#3a2a18" stop-opacity="0.10"></stop>
      </linearGradient>
    </defs>

    <rect width="400" height="400" fill={`url(#bg-${uid})`}></rect>
    <rect width="400" height="400" fill={`url(#sun-${uid})`}></rect>

    {
      kind === 'figs' && (
        <g>
          <ellipse cx="205" cy="308" rx="105" ry="15" fill="#00000017" />
          <path
            d="M200 148 C248 162 264 216 237 258 C221 282 179 282 163 258 C136 216 152 162 200 148 Z"
            fill="#5b2a46"
          />
          <ellipse
            cx="184"
            cy="198"
            rx="13"
            ry="27"
            fill="#7a3e5f"
            opacity="0.85"
            transform="rotate(-14 184 198)"
          />
          <rect
            x="196"
            y="132"
            width="8"
            height="20"
            rx="4"
            fill="#6e604f"
            transform="rotate(6 200 142)"
          />
          <ellipse
            cx="146"
            cy="168"
            rx="22"
            ry="9"
            fill="#7e8757"
            opacity="0.9"
            transform="rotate(-32 146 168)"
          />
          <g transform="translate(292 258)">
            <circle r="38" fill="#c79aa6" stroke="#5b2a46" stroke-width="5" />
            <circle r="30" fill="#d8b3bc" />
            {[0, 1, 2, 3, 4, 5, 6].map((i) => (
              <circle
                cx={Math.cos((i / 7) * Math.PI * 2) * 16}
                cy={Math.sin((i / 7) * Math.PI * 2) * 16}
                r="3"
                fill="#5b2a46"
              />
            ))}
            <circle cx="0" cy="0" r="3" fill="#5b2a46" />
          </g>
          <path
            d="M118 250 C104 262 100 282 112 296 C126 288 130 264 122 250 Z"
            fill="#6b3556"
          />
        </g>
      )
    }

    {
      kind === 'olives' && (
        <g>
          <ellipse cx="185" cy="315" rx="120" ry="14" fill="#00000012" />
          <path
            d="M110 84 C170 138 232 190 302 262"
            stroke="#55603a"
            stroke-width="5"
            fill="none"
            stroke-linecap="round"
          />
          {[
            [128, 96, -42],
            [156, 122, 38],
            [176, 140, -40],
            [206, 166, 36],
            [228, 186, -38],
            [256, 212, 34],
          ].map(([x, y, r]) => (
            <>
              <ellipse
                cx={x}
                cy={y}
                rx="24"
                ry="7.5"
                fill="#6b7a44"
                transform={`rotate(${r} ${x} ${y})`}
              />
              <ellipse
                cx={x + 14}
                cy={y + 12}
                rx="21"
                ry="6.5"
                fill="#8a9663"
                opacity="0.9"
                transform={`rotate(${r + 52} ${x + 14} ${y + 12})`}
              />
            </>
          ))}
          <circle cx="214" cy="222" r="14" fill="#77843f" />
          <circle cx="210" cy="217" r="3.5" fill="#ffffff" opacity="0.35" />
          <circle cx="250" cy="252" r="14" fill="#3e4726" />
          <circle cx="246" cy="247" r="3.5" fill="#ffffff" opacity="0.3" />
          <circle cx="288" cy="218" r="12" fill="#77843f" />
          <circle cx="285" cy="214" r="3" fill="#ffffff" opacity="0.35" />
          <ellipse
            cx="150"
            cy="312"
            rx="62"
            ry="11"
            fill="#b08d3a"
            opacity="0.32"
          />
          <ellipse
            cx="150"
            cy="310"
            rx="44"
            ry="7"
            fill="#caa54f"
            opacity="0.45"
          />
        </g>
      )
    }

    {
      kind === 'lentils' && (
        <g>
          <rect
            x="0"
            y="272"
            width="400"
            height="128"
            fill="#f2ebdc"
            opacity="0.85"
          />
          {[290, 306, 322, 338, 354, 370].map((y) => (
            <line
              x1="0"
              y1={y}
              x2="400"
              y2={y}
              stroke="#000000"
              stroke-opacity="0.05"
              stroke-width="1.5"
            />
          ))}
          <ellipse cx="200" cy="296" rx="118" ry="13" fill="#00000014" />
          <path d="M116 292 Q200 220 284 292 Z" fill="#8a6b3f" />
          {[
            [160, 268],
            [188, 256],
            [216, 260],
            [240, 272],
            [148, 282],
            [178, 276],
            [208, 274],
            [236, 282],
            [170, 288],
            [200, 286],
            [228, 290],
            [254, 288],
            [300, 300],
            [320, 308],
            [92, 304],
            [76, 312],
          ].map(([x, y], i) => (
            <ellipse
              cx={x}
              cy={y}
              rx="7.5"
              ry="4.5"
              fill={['#7a5c33', '#93764a', '#6b5028'][i % 3]}
              transform={`rotate(${(i * 47) % 180} ${x} ${y})`}
            />
          ))}
        </g>
      )
    }

    {
      kind === 'dates' && (
        <g>
          <g
            stroke="#7e8757"
            stroke-width="5"
            opacity="0.35"
            fill="none"
            stroke-linecap="round"
          >
            <path d="M70 96 C160 60 280 66 360 118" />
            <path d="M96 108 C180 82 288 90 348 132" stroke-width="3" />
          </g>
          <ellipse cx="204" cy="316" rx="118" ry="14" fill="#00000015" />
          {[
            [158, 232, '#6e4423'],
            [202, 222, '#7e5230'],
            [246, 234, '#5f3a1e'],
          ].map(([x, y, fill]) => (
            <g>
              <rect
                x={Number(x) - 14}
                y={Number(y)}
                width="28"
                height="68"
                rx="14"
                fill={String(fill)}
              />
              <ellipse
                cx={Number(x) - 5}
                cy={Number(y) + 18}
                rx="3.5"
                ry="14"
                fill="#ffffff"
                opacity="0.22"
              />
              <path
                d={`M${Number(x) - 8} ${Number(y) + 30} q8 4 16 0 M${Number(x) - 8} ${Number(y) + 44} q8 4 16 0`}
                stroke="#4a2c13"
                stroke-width="1.6"
                opacity="0.5"
                fill="none"
              />
            </g>
          ))}
          <ellipse cx="202" cy="306" rx="86" ry="10" fill="#00000012" />
        </g>
      )
    }

    {
      kind === 'honey' && (
        <g>
          <ellipse cx="200" cy="330" rx="120" ry="14" fill="#00000015" />
          <path
            d="M124 252 C124 316 158 330 200 330 C242 330 276 316 276 252 Z"
            fill="#d8cbb0"
          />
          <ellipse cx="200" cy="252" rx="76" ry="15" fill="#c9b998" />
          <ellipse cx="200" cy="252" rx="64" ry="11" fill="#e9b94e" />
          <path
            d="M164 250 q36 -8 72 0"
            stroke="#f2ce7b"
            stroke-width="4"
            fill="none"
            stroke-linecap="round"
          />
          <rect x="176" y="326" width="48" height="12" rx="6" fill="#c9b998" />
          <line
            x1="288"
            y1="118"
            x2="258"
            y2="204"
            stroke="#8a6b3f"
            stroke-width="8"
            stroke-linecap="round"
          />
          {[
            [252, 210, 17],
            [255, 220, 14],
            [257, 229, 11],
            [258, 237, 8],
          ].map(([x, y, rx]) => (
            <ellipse
              cx={Number(x)}
              cy={Number(y)}
              rx={Number(rx)}
              ry="5.5"
              fill="#a97c4f"
            />
          ))}
          <path
            d="M258 246 c7 11 7 18 0 23 c-7 -5 -7 -12 0 -23 Z"
            fill="#d9a83f"
          />
          <circle cx="258" cy="284" r="4.5" fill="#d9a83f" />
          <path
            d="M120 140 l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4 Z"
            fill="#fff6de"
            opacity="0.7"
          />
          <circle cx="310" cy="180" r="3.5" fill="#fff6de" opacity="0.6" />
        </g>
      )
    }

    {
      kind === 'barley' && (
        <g>
          <ellipse cx="200" cy="352" rx="130" ry="12" fill="#00000010" />
          {[
            ['M140 348 C136 280 142 220 158 158', 158, 158],
            ['M204 350 C204 280 206 214 210 148', 210, 148],
            ['M266 348 C270 282 262 224 248 162', 248, 162],
          ].map(([d, hx, hy]) => (
            <g>
              <path
                d={String(d)}
                stroke="#a8852f"
                stroke-width="3.5"
                fill="none"
                stroke-linecap="round"
              />
              {[0, 1, 2, 3, 4].map((i) => (
                <g transform={`translate(${hx} ${Number(hy) + i * 13})`}>
                  <ellipse
                    cx="-6"
                    cy="0"
                    rx="4.5"
                    ry="8"
                    fill="#c9a24b"
                    transform="rotate(-28)"
                  />
                  <ellipse
                    cx="6"
                    cy="-3"
                    rx="4.5"
                    ry="8"
                    fill="#b8922f"
                    transform="rotate(28)"
                  />
                  <line
                    x1="0"
                    y1="-4"
                    x2="-9"
                    y2="-22"
                    stroke="#c9a24b"
                    stroke-width="1.4"
                  />
                  <line
                    x1="0"
                    y1="-4"
                    x2="9"
                    y2="-24"
                    stroke="#b8922f"
                    stroke-width="1.4"
                  />
                  <line
                    x1="0"
                    y1="-4"
                    x2="0"
                    y2="-26"
                    stroke="#a8852f"
                    stroke-width="1.4"
                  />
                </g>
              ))}
            </g>
          ))}
        </g>
      )
    }

    {
      kind === 'stew' && (
        <g>
          <rect x="0" y="286" width="400" height="114" fill="#8a6b4a" />
          {[70, 150, 230, 310].map((x) => (
            <line
              x1={x}
              y1="286"
              x2={x}
              y2="400"
              stroke="#000000"
              stroke-opacity="0.08"
              stroke-width="2"
            />
          ))}
          <path d="M104 330 L296 330 L318 372 L82 372 Z" fill="#f2ebdc" />
          <path
            d="M130 340 L120 364 M200 342 L200 366 M272 340 L282 364"
            stroke="#000000"
            stroke-opacity="0.06"
            stroke-width="3"
          />
          <ellipse cx="200" cy="366" rx="88" ry="12" fill="#00000018" />
          <path d="M124 296 A78 64 0 0 0 276 296 Z" fill="#b96b43" />
          <path
            d="M136 300 A66 52 0 0 0 264 300 L264 298 A66 54 0 0 1 136 298 Z"
            fill="#8c4023"
            opacity="0.6"
          />
          <ellipse cx="200" cy="298" rx="77" ry="17" fill="#8c4023" />
          <ellipse cx="200" cy="298" rx="65" ry="13" fill="#5e3a20" />
          {[
            [172, 296],
            [198, 301],
            [224, 295],
            [186, 303],
            [212, 293],
            [236, 301],
          ].map(([x, y], i) => (
            <ellipse
              cx={x}
              cy={y}
              rx="6"
              ry="3.5"
              fill={i % 2 ? '#93764a' : '#7a5c33'}
              transform={`rotate(${(i * 61) % 180} ${x} ${y})`}
            />
          ))}
          <g fill="#6b7a44">
            <ellipse
              cx="232"
              cy="292"
              rx="9"
              ry="3.5"
              transform="rotate(-24 232 292)"
            />
            <ellipse
              cx="240"
              cy="296"
              rx="8"
              ry="3"
              transform="rotate(18 240 296)"
            />
          </g>
          <g
            stroke="#f7f2e9"
            stroke-width="4"
            fill="none"
            stroke-linecap="round"
            opacity="0.35"
          >
            <path d="M182 252 c-9 -16 9 -24 0 -42 c-7 -14 5 -22 2 -32" />
            <path d="M218 258 c-8 -14 8 -22 0 -38 c-6 -12 4 -20 2 -28" />
          </g>
          <g transform="rotate(-8 330 344)">
            <rect
              x="296"
              y="340"
              width="66"
              height="7"
              rx="3.5"
              fill="#8a6b3f"
            />
            <ellipse cx="368" cy="343" rx="17" ry="11" fill="#a97c4f" />
          </g>
        </g>
      )
    }

    {
      kind === 'still-life' && (
        <g>
          <circle cx="298" cy="92" r="74" fill="#fff3d6" opacity="0.5" />
          <rect x="0" y="298" width="400" height="102" fill="#cdbb92" />
          <line
            x1="0"
            y1="298"
            x2="400"
            y2="298"
            stroke="#000000"
            stroke-opacity="0.07"
            stroke-width="2"
          />
          <path d="M56 300 L154 300 L144 384 L46 384 Z" fill="#f2ebdc" />
          <path
            d="M84 312 L80 372 M116 314 L112 374"
            stroke="#000000"
            stroke-opacity="0.06"
            stroke-width="4"
          />
          <g>
            <ellipse cx="200" cy="368" rx="58" ry="9" fill="#00000018" />
            <path
              d="M200 236 c-32 8 -40 36 -38 56 c2 17 19 28 38 28 s36 -11 38 -28 c2 -20 -6 -48 -38 -56 Z"
              fill="#b98a5c"
            />
            <ellipse cx="200" cy="238" rx="17" ry="6" fill="#7e5230" />
            <path
              d="M162 262 c-16 4 -20 18 -16 30 M238 262 c16 4 20 18 16 30"
              stroke="#a97c4f"
              stroke-width="7"
              fill="none"
              stroke-linecap="round"
            />
            <ellipse
              cx="188"
              cy="290"
              rx="7"
              ry="22"
              fill="#ffffff"
              opacity="0.15"
            />
          </g>
          <g>
            <ellipse cx="308" cy="352" rx="52" ry="8" fill="#00000015" />
            <path d="M262 322 A48 40 0 0 0 354 322 Z" fill="#b96b43" />
            <ellipse cx="308" cy="322" rx="47" ry="11" fill="#8c4023" />
            <circle cx="292" cy="312" r="13" fill="#5b2a46" />
            <circle cx="318" cy="310" r="12" fill="#6b3556" />
            <circle cx="288" cy="308" r="3" fill="#7a3e5f" />
          </g>
          <g>
            <ellipse cx="200" cy="352" rx="58" ry="9" fill="#00000015" />
            <ellipse cx="200" cy="336" rx="56" ry="21" fill="#c08a4e" />
            <path
              d="M172 328 q10 -8 20 0 M192 324 q10 -8 20 0 M212 328 q10 -8 20 0"
              stroke="#8a6238"
              stroke-width="3"
              fill="none"
              stroke-linecap="round"
            />
            <ellipse
              cx="182"
              cy="330"
              rx="18"
              ry="6"
              fill="#ffffff"
              opacity="0.12"
            />
          </g>
          {[258, 272, 284].map((x, i) => (
            <g>
              <circle
                cx={x}
                cy={352 - (i % 2) * 6}
                r="7.5"
                fill={i === 1 ? '#77843f' : '#3e4726'}
              />
              <circle
                cx={x - 2}
                cy={349 - (i % 2) * 6}
                r="2"
                fill="#ffffff"
                opacity="0.3"
              />
            </g>
          ))}
          <g transform="rotate(24 96 250)">
            <path
              d="M96 190 L96 320"
              stroke="#55603a"
              stroke-width="4"
              stroke-linecap="round"
            />
            {[0, 1, 2, 3].map((i) => (
              <g transform={`translate(96 ${206 + i * 30})`}>
                <ellipse
                  cx="-14"
                  cy="0"
                  rx="17"
                  ry="5.5"
                  fill="#6b7a44"
                  transform="rotate(-30)"
                />
                <ellipse
                  cx="14"
                  cy="6"
                  rx="15"
                  ry="5"
                  fill="#8a9663"
                  transform="rotate(30)"
                />
              </g>
            ))}
          </g>
        </g>
      )
    }

    {
      kind === 'israel' && (
        <g>
          <circle cx="296" cy="104" r="36" fill="#e9c87c" opacity="0.85" />
          <path
            d="M0 252 Q110 176 226 244 Q320 292 400 240 L400 400 L0 400 Z"
            fill="#b99c63"
          />
          <path
            d="M0 306 Q150 244 306 306 Q360 324 400 314 L400 400 L0 400 Z"
            fill="#a3874f"
          />
          {[
            [96, 296],
            [176, 282],
            [268, 300],
          ].map(([x, y]) => (
            <g>
              <line
                x1={x}
                y1={y}
                x2={x}
                y2={y + 14}
                stroke="#55603a"
                stroke-width="3"
              />
              <circle cx={x} cy={y - 4} r="10" fill="#6b7a44" />
            </g>
          ))}
        </g>
      )
    }

    {
      kind === 'galilee' && (
        <g>
          <circle cx="120" cy="96" r="30" fill="#f2e2b8" opacity="0.8" />
          <path
            d="M0 226 Q120 170 240 222 T400 210 L400 400 L0 400 Z"
            fill="#a8ad91"
          />
          <rect x="0" y="268" width="400" height="86" fill="#7c948f" />
          {[282, 298, 314, 330].map((y) => (
            <g>
              <line
                x1={40 + (y % 60)}
                y1={y}
                x2={120 + (y % 60)}
                y2={y}
                stroke="#ffffff"
                stroke-opacity="0.25"
                stroke-width="2.5"
                stroke-linecap="round"
              />
              <line
                x1={210 + (y % 50)}
                y1={y}
                x2={280 + (y % 50)}
                y2={y}
                stroke="#ffffff"
                stroke-opacity="0.2"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </g>
          ))}
          <path d="M0 354 Q200 336 400 354 L400 400 L0 400 Z" fill="#d8c49a" />
        </g>
      )
    }

    {
      kind === 'judea' && (
        <g>
          <circle cx="310" cy="98" r="34" fill="#e9c87c" opacity="0.85" />
          <path
            d="M0 300 Q120 190 260 262 Q340 298 400 280 L400 400 L0 400 Z"
            fill="#c4a96f"
          />
          {[
            'M60 322 Q170 268 300 322',
            'M40 344 Q170 292 320 344',
            'M24 366 Q170 316 340 366',
          ].map((d) => (
            <path
              d={d}
              stroke="#8f7645"
              stroke-width="4"
              fill="none"
              opacity="0.7"
            />
          ))}
          <g>
            <line
              x1="286"
              y1="286"
              x2="286"
              y2="300"
              stroke="#55603a"
              stroke-width="3"
            />
            <circle cx="286" cy="282" r="11" fill="#6b7a44" />
          </g>
        </g>
      )
    }

    {
      kind === 'mediterranean' && (
        <g>
          <rect x="0" y="212" width="400" height="188" fill="#5e828c" />
          <rect
            x="0"
            y="212"
            width="400"
            height="60"
            fill="#7fa0a8"
            opacity="0.55"
          />
          <path
            d="M252 212 Q330 200 400 208 L400 232 L246 226 Z"
            fill="#b99c63"
            opacity="0.85"
          />
          {[236, 258, 282, 308, 336, 366].map((y, i) => (
            <g>
              <line
                x1={196 - i * 4}
                y1={y}
                x2={204 + i * 4}
                y2={y}
                stroke="#f7f2e9"
                stroke-opacity="0.4"
                stroke-width="3"
                stroke-linecap="round"
              />
              <line
                x1={150 - i * 6}
                y1={y + 8}
                x2={166 - i * 6}
                y2={y + 8}
                stroke="#f7f2e9"
                stroke-opacity="0.18"
                stroke-width="2.5"
                stroke-linecap="round"
              />
              <line
                x1={244 + i * 6}
                y1={y + 8}
                x2={262 + i * 6}
                y2={y + 8}
                stroke="#f7f2e9"
                stroke-opacity="0.18"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </g>
          ))}
          <circle cx="200" cy="120" r="38" fill="#f2e2b8" opacity="0.85" />
        </g>
      )
    }

    <rect width="400" height="400" fill={`url(#floor-${uid})`}></rect>
    <rect width="400" height="400" filter="url(#bm-grain)" opacity="0.05"
    ></rect>
  </svg>
</div>
