---
/**
 * V3C.45D — Book Viewer
 *
 * Interactive preview of the BiblicalMeal cookbook.
 * Uses vanilla JS via Astro's client:load island pattern.
 * No external frameworks.
 */
import BookPageRenderer from './BookPageRenderer.astro';
import PreviewBoundary from './PreviewBoundary.astro';
import FoodIllustration from '../common/FoodIllustration.astro';
import { BOOK_METADATA } from '../../data/cookbook/book-metadata';

/**
 * Preview page IDs — the deterministic preview boundary.
 * These are the pages visible in the free preview.
 */
const PREVIEW_PAGES = [
  { id: 'title-page', kind: 'front-matter' as const, title: 'Title Page' },
  { id: 'introduction', kind: 'front-matter' as const, title: 'Introduction' },
  {
    id: 'classification-guide',
    kind: 'front-matter' as const,
    title: 'Classification Guide',
  },
  { id: 'grains-breads', kind: 'chapter' as const, title: 'Grains & Breads' },
  {
    id: 'recipe-content-unleavened-bread',
    kind: 'recipe' as const,
    title: 'Unleavened Bread',
  },
  {
    id: 'recipe-content-barley-bread',
    kind: 'recipe' as const,
    title: 'Barley Bread',
  },
  {
    id: 'recipe-content-wheat-flatbread',
    kind: 'recipe' as const,
    title: 'Wheat Flatbread',
  },
  {
    id: 'legumes-one-pot-meals',
    kind: 'chapter' as const,
    title: 'Legumes & One-Pot Meals',
  },
  {
    id: 'recipe-content-lentil-pottage',
    kind: 'recipe' as const,
    title: 'Lentil Pottage',
  },
];

const totalPages = PREVIEW_PAGES.length;
---

<div
  id="book-viewer"
  class="book-viewer"
  data-total={totalPages}
  aria-label="Book preview"
>
  {/* Cover — always visible above the viewer */}
  <div class="book-viewer__cover">
    <div class="book-viewer__cover-inner">
      <div class="relative overflow-hidden rounded-lg bg-background-alt">
        <div class="absolute inset-0 opacity-20">
          <FoodIllustration kind="still-life" ratio="16 / 9" />
        </div>
        <div class="relative z-10 p-8 text-center sm:p-12">
          <p
            class="font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
          >
            The BiblicalMeal Cookbook
          </p>
          <h1 class="mt-4 font-display text-display text-ink">
            Biblical Meals
          </h1>
          <p class="mt-2 font-display text-h2 text-ink-muted">
            {BOOK_METADATA.subtitle}
          </p>
          <p class="mx-auto mt-6 max-w-xl text-body text-ink-muted">
            Nine evidence-aware recipes rooted in Scripture, history, and the
            culinary traditions of the ancient world.
          </p>
          <div class="mt-8">
            <button
              id="viewer-start"
              class="inline-flex items-center rounded-full bg-terracotta px-8 py-4 text-sm font-medium text-cream shadow-sm transition-all duration-200 hover:-translate-y-px hover:bg-terracotta-dark"
              aria-label="Start reading the preview"
            >
              Read Preview
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Page container */}
  <div id="viewer-pages" class="book-viewer__pages" hidden>
    {
      PREVIEW_PAGES.map((page, index) => (
        <div
          class="book-viewer__page"
          data-index={index}
          data-kind={page.kind}
          data-page-id={page.id}
          hidden={index !== 0}
          aria-label={`Page ${index + 1} of ${totalPages}: ${page.title}`}
        >
          <div class="book-page">
            <BookPageRenderer kind={page.kind} id={page.id} isPreview />
          </div>
        </div>
      ))
    }

    {/* Boundary page */}
    <div
      class="book-viewer__page book-viewer__boundary"
      data-index={totalPages}
      hidden
      aria-label="Preview ended"
    >
      <div class="book-page">
        <PreviewBoundary />
      </div>
    </div>
  </div>

  {/* Navigation controls */}
  <div id="viewer-controls" class="book-viewer__controls" hidden>
    <div class="book-viewer__controls-inner">
      <button
        id="viewer-prev"
        class="book-viewer__btn"
        disabled
        aria-label="Previous page"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="hidden sm:inline">Previous</span>
      </button>

      <span
        id="viewer-counter"
        class="book-viewer__counter"
        aria-live="polite"
        aria-atomic="true"
      >
        1 / {totalPages}
      </span>

      <button id="viewer-next" class="book-viewer__btn" aria-label="Next page">
        <span class="hidden sm:inline">Next</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // V3C.45D — Book Viewer Client Logic
  // Vanilla JS, no frameworks.

  function initViewer() {
    const viewer = document.getElementById('book-viewer') as HTMLElement | null;
    if (!viewer) return;

    const totalPages = parseInt(viewer.dataset.total || '0', 10);
    const pages = viewer.querySelectorAll('.book-viewer__page');
    const startBtn = document.getElementById('viewer-start');
    const pagesContainer = document.getElementById('viewer-pages');
    const controls = document.getElementById('viewer-controls');
    const prevBtn = document.getElementById('viewer-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('viewer-next') as HTMLButtonElement;
    const counter = document.getElementById('viewer-counter');

    if (
      !startBtn ||
      !pagesContainer ||
      !controls ||
      !prevBtn ||
      !nextBtn ||
      !counter
    )
      return;

    let currentPage = 0;
    const maxIndex = pages.length - 1; // includes boundary page

    function showPage(index: number) {
      // Hide all pages
      pages.forEach((p) => p.setAttribute('hidden', ''));

      // Show target page
      const target = pages[index] as HTMLElement;
      if (target) {
        target.removeAttribute('hidden');
      }

      currentPage = index;

      // Update counter
      const displayIndex = Math.min(index + 1, totalPages);
      counter!.textContent = `${displayIndex} / ${totalPages}`;

      // Update button states
      prevBtn.disabled = index === 0;

      // If on boundary page, hide next
      if (index >= maxIndex) {
        nextBtn.disabled = true;
      } else {
        nextBtn.disabled = false;
      }

      // Scroll to top of viewer
      viewer!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Start button
    startBtn.addEventListener('click', () => {
      pagesContainer.removeAttribute('hidden');
      controls.removeAttribute('hidden');
      startBtn.closest('.book-viewer__cover')?.setAttribute('hidden', '');
      showPage(0);
    });

    // Previous
    prevBtn.addEventListener('click', () => {
      if (currentPage > 0) showPage(currentPage - 1);
    });

    // Next
    nextBtn.addEventListener('click', () => {
      if (currentPage < maxIndex) showPage(currentPage + 1);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (pagesContainer.hasAttribute('hidden')) return;

      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        if (currentPage > 0) showPage(currentPage - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        if (currentPage < maxIndex) showPage(currentPage + 1);
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViewer);
  } else {
    initViewer();
  }
</script>
