---
interface Props {
  recipeId: string;
  classification: string;
}

const { recipeId, classification } = Astro.props;
---

<section aria-labelledby="source-heading" class="border-t border-line pt-8">
  <h2
    id="source-heading"
    class="font-sans text-caption font-semibold tracking-eyebrow text-olive-dark uppercase"
  >
    Source Notes
  </h2>
  <p class="mt-2 text-body text-ink-muted">
    This recipe is derived from canonical research record
    <code
      class="rounded border border-line bg-background-alt px-1.5 py-0.5 font-mono text-caption text-ink"
    >
      {recipeId}
    </code>
    and classified as <em>{classification}</em>.
  </p>
  <p class="mt-2 text-caption text-ink-muted">
    Full bibliography and source details will be available in the Sources
    section.
  </p>
</section>
