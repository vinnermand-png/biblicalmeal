---
/**
 * V3C.45D — Recipe Cooking Page
 *
 * Physical page 2 of a recipe: ingredients + method.
 * Designed for the 8:10 book frame with editorial two-column on desktop.
 */
import type { RecipeContentRecord } from '../../data/recipe-content/types';

interface Props {
  recipe: RecipeContentRecord;
}

const { recipe } = Astro.props;
---

<div class="recipe-cooking-page">
  <h2 class="recipe-cooking-page__section-title">Ingredients</h2>
  <ul class="recipe-cooking-page__ingredients">
    {
      recipe.ingredients.map((ing) => (
        <li class="recipe-cooking-page__ingredient">
          <span
            class="recipe-cooking-page__ingredient-dot"
            aria-hidden="true"
          />
          <span class="recipe-cooking-page__ingredient-text">
            <strong>{ing.label}</strong>
            {ing.quantity && (
              <span class="recipe-cooking-page__ingredient-qty">
                {' '}
                — {ing.quantity}
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ul>

  {
    recipe.servings && (
      <p class="recipe-cooking-page__serves">
        <span class="recipe-cooking-page__serves-label">Serves:</span>{' '}
        {recipe.servings}
      </p>
    )
  }

  <h2 class="recipe-cooking-page__section-title">Method</h2>
  <ol class="recipe-cooking-page__method">
    {
      recipe.preparationSteps.map((step) => (
        <li class="recipe-cooking-page__step">
          <span class="recipe-cooking-page__step-num">{step.order}</span>
          <span class="recipe-cooking-page__step-text">{step.instruction}</span>
        </li>
      ))
    }
  </ol>

  {
    recipe.servingGuidance && (
      <div class="recipe-cooking-page__serving">
        <p class="recipe-cooking-page__serving-label">Serving</p>
        <p class="recipe-cooking-page__serving-text">
          {recipe.servingGuidance}
        </p>
      </div>
    )
  }
</div>

<style>
  .recipe-cooking-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    gap: clamp(0.375rem, 1.5vw, 0.75rem);
    overflow: hidden;
  }
  .recipe-cooking-page__section-title {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2.2vw, 1.2rem);
    line-height: 1.25;
    color: var(--color-ink);
    margin-bottom: 0;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .recipe-cooking-page__ingredients {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.2rem, 0.8vw, 0.4rem);
  }
  @media (max-width: 500px) {
    .recipe-cooking-page__ingredients {
      grid-template-columns: 1fr;
    }
  }
  .recipe-cooking-page__ingredient {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .recipe-cooking-page__ingredient-dot {
    width: 5px;
    height: 5px;
    min-width: 5px;
    border-radius: 50%;
    background: var(--color-olive);
    margin-top: 0.35em;
  }
  .recipe-cooking-page__ingredient-qty {
    color: var(--color-ink-muted);
  }
  .recipe-cooking-page__serves {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .recipe-cooking-page__serves-label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85em;
  }
  .recipe-cooking-page__method {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.375rem, 1.2vw, 0.625rem);
    flex: 1;
  }
  .recipe-cooking-page__step {
    display: flex;
    gap: clamp(0.375rem, 1vw, 0.625rem);
    font-size: clamp(0.7rem, 1.5vw, 0.825rem);
    line-height: 1.55;
    color: var(--color-ink);
  }
  .recipe-cooking-page__step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(1.25rem, 3vw, 1.5rem);
    height: clamp(1.25rem, 3vw, 1.5rem);
    min-width: clamp(1.25rem, 3vw, 1.5rem);
    border-radius: 50%;
    background: rgba(92, 107, 60, 0.1);
    color: var(--color-olive-dark);
    font-family: var(--font-sans);
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    font-weight: 600;
  }
  .recipe-cooking-page__serving {
    margin-top: auto;
    padding-top: clamp(0.25rem, 1vw, 0.5rem);
    border-top: 1px solid var(--color-line);
    background: rgba(239, 231, 216, 0.5);
    padding: clamp(0.375rem, 1vw, 0.625rem);
    border-radius: 0.375rem;
  }
  .recipe-cooking-page__serving-label {
    font-family: var(--font-sans);
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }
  .recipe-cooking-page__serving-text {
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0.125rem 0 0;
  }
</style>
