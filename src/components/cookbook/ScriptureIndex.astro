---
import CookbookShell from './CookbookShell.astro';
import { generateScriptureIndex } from '../../lib/cookbook-indexes';

const scriptureRefs = generateScriptureIndex();

/** Capitalise book names for display. */
function formatBookName(book: string): string {
  return book
    .split(' ')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}
---

<CookbookShell title={`Scripture Index | BiblicalMeal Cookbook`}>
  <section class="cookbook-content px-5 py-16 sm:px-8 sm:py-24">
    <h1 class="font-display text-h1 text-ink">Scripture Index</h1>

    <p class="prose-bm mt-4 max-w-2xl text-body-lg text-ink-muted">
      Scripture references sorted in biblical order, with recipes that cite each
      passage.
    </p>

    <div class="mt-10 divide-y divide-line">
      {
        scriptureRefs.map((entry) => (
          <div class="py-4">
            <p class="text-body font-medium text-ink">
              {formatBookName(entry.book)} {entry.chapter}
              {entry.verse ? `:${entry.verse}` : ''}
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              {entry.recipes.map((recipe) => (
                <a
                  href={recipe.route}
                  class="inline-flex items-center rounded-full border border-line bg-surface px-3 py-1 text-caption text-ink-muted transition-colors hover:border-olive/40 hover:text-olive-dark"
                >
                  {recipe.title}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {
      scriptureRefs.length === 0 && (
        <p class="mt-10 text-body text-ink-muted">
          Scripture references will appear here as recipe research records are
          completed.
        </p>
      )
    }
  </section>
</CookbookShell>
