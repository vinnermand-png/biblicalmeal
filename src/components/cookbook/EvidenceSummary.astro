---
interface Props {
  classification: string;
  editorialNotes: string[];
}

const { classification, editorialNotes } = Astro.props;

const EVIDENCE_ITEMS = [
  {
    label: 'Directly Attested',
    description: 'Explicitly stated in biblical text',
    color: 'olive',
    icon: '✓',
  },
  {
    label: 'Inferred',
    description: 'Reasonable from historical evidence',
    color: 'terracotta',
    icon: '→',
  },
  {
    label: 'Practical Adaptation',
    description: 'Modern kitchen choice',
    color: 'ink-muted',
    icon: '◆',
  },
  {
    label: 'Unresolved',
    description: 'Cannot currently be answered',
    color: 'gold',
    icon: '?',
  },
];
---

<section
  aria-labelledby="evidence-heading"
  class="rounded-xl border border-line bg-background-alt p-6 sm:p-8"
>
  <h2 id="evidence-heading" class="font-display text-h3 text-ink">
    Evidence Notes
  </h2>
  <p class="mt-2 max-w-2xl text-body text-ink-muted">
    This recipe is classified as <strong>{classification}</strong>. Every
    ingredient and preparation step is labelled with its evidence basis.
  </p>

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      EVIDENCE_ITEMS.map((item) => (
        <div class="flex items-start gap-3">
          <span
            class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border text-xs font-semibold ${
              item.color === 'olive'
                ? 'border-olive/40 bg-olive/10 text-olive-dark'
                : item.color === 'terracotta'
                  ? 'border-terracotta/30 bg-terracotta/10 text-terracotta-dark'
                  : item.color === 'gold'
                    ? 'border-gold/40 bg-gold/10 text-ink'
                    : 'border-line bg-surface text-ink-muted'
            }`}
            aria-hidden="true"
          >
            {item.icon}
          </span>
          <div>
            <p class="text-sm font-medium text-ink">{item.label}</p>
            <p class="text-caption text-ink-muted">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>

  {
    editorialNotes.length > 0 && (
      <div class="mt-6 border-t border-line pt-6">
        <p class="font-sans text-caption font-semibold tracking-eyebrow text-olive-dark uppercase">
          Editorial Notes
        </p>
        <ul class="mt-3 space-y-2">
          {editorialNotes.map((note) => (
            <li class="text-body text-ink-muted">{note}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
