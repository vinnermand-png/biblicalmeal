---
/**
 * V3C.45D — Recipe Hero Page
 *
 * Physical page 1 of a recipe: title, classification, introduction.
 * Designed for the 8:10 book frame.
 */
import type { RecipeContentRecord } from '../../data/recipe-content/types';
import { CLASSIFICATION_LABELS } from '../../lib/cookbook';
import FoodIllustration from '../common/FoodIllustration.astro';
import { getRecipeArt } from '../../lib/cookbook';

interface Props {
  recipe: RecipeContentRecord;
  chapterTitle?: string;
}

const { recipe, chapterTitle } = Astro.props;

const artKind = getRecipeArt(recipe.classification) as
  'stew' | 'barley' | 'still-life';

const classLabel =
  CLASSIFICATION_LABELS[recipe.classification] ?? recipe.classification;
---

<div class="recipe-hero-page">
  {chapterTitle && <p class="recipe-hero-page__chapter">{chapterTitle}</p>}

  <span
    class={`recipe-hero-page__badge ${recipe.classification === 'historically-informed-reconstruction' ? 'recipe-hero-page__badge--reconstruction' : 'recipe-hero-page__badge--inspired'}`}
  >
    {classLabel}
  </span>

  <h1 class="recipe-hero-page__title">{recipe.title}</h1>

  {
    recipe.introduction && (
      <p class="recipe-hero-page__intro">{recipe.introduction}</p>
    )
  }

  <div class="recipe-hero-page__illustration">
    <FoodIllustration kind={artKind} ratio="4 / 3" />
  </div>

  {
    (recipe.servings || recipe.timingGuidance) && (
      <div class="recipe-hero-page__meta">
        {recipe.servings && (
          <div class="recipe-hero-page__meta-item">
            <span class="recipe-hero-page__meta-label">Serves</span>
            <span class="recipe-hero-page__meta-value">{recipe.servings}</span>
          </div>
        )}
        {recipe.timingGuidance && (
          <div class="recipe-hero-page__meta-item">
            <span class="recipe-hero-page__meta-label">Timing</span>
            <span class="recipe-hero-page__meta-value">
              {recipe.timingGuidance}
            </span>
          </div>
        )}
      </div>
    )
  }
</div>

<style>
  .recipe-hero-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    gap: clamp(0.5rem, 2vw, 1rem);
  }
  .recipe-hero-page__chapter {
    font-family: var(--font-sans);
    font-size: clamp(0.7rem, 1.5vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-olive-dark);
    font-weight: 600;
  }
  .recipe-hero-page__badge {
    display: inline-block;
    width: fit-content;
    margin-inline: auto;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    font-weight: 600;
  }
  .recipe-hero-page__badge--inspired {
    background: rgba(92, 107, 60, 0.12);
    border: 1px solid rgba(92, 107, 60, 0.35);
    color: var(--color-olive-dark);
  }
  .recipe-hero-page__badge--reconstruction {
    background: rgba(169, 80, 45, 0.1);
    border: 1px solid rgba(169, 80, 45, 0.3);
    color: var(--color-terracotta-dark);
  }
  .recipe-hero-page__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .recipe-hero-page__intro {
    font-size: clamp(0.75rem, 1.6vw, 0.875rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 36ch;
    margin-inline: auto;
  }
  .recipe-hero-page__illustration {
    flex: 1;
    min-height: 0;
    max-height: 40%;
    border-radius: 0.5rem;
    overflow: hidden;
    opacity: 0.85;
  }
  .recipe-hero-page__meta {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2rem);
    padding-top: clamp(0.25rem, 1vw, 0.5rem);
    border-top: 1px solid var(--color-line);
  }
  .recipe-hero-page__meta-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }
  .recipe-hero-page__meta-label {
    font-family: var(--font-sans);
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
    font-weight: 600;
  }
  .recipe-hero-page__meta-value {
    font-family: var(--font-sans);
    font-size: clamp(0.7rem, 1.4vw, 0.8rem);
    color: var(--color-ink);
  }
</style>
