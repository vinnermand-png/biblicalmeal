---
/**
 * V3C.45D — Book Page Renderer (Upgraded)
 *
 * Renders a single physical book page content based on page type.
 * For recipes, renders the appropriate sub-page (hero/cooking/evidence/closing).
 * Uses existing canonical components — no duplication.
 */
import type { BookPageKind } from '../../lib/cookbook-book-order';
import { COOKBOOK_CHAPTERS } from '../../data/cookbook/structure';
import { COOKBOOK_RECIPE_INCLUSIONS } from '../../data/cookbook-production/records';
import { RECIPE_CONTENT_RECORDS } from '../../data/recipe-content/records';
import {
  getRecipesForChapter,
  getChapterArt,
  CLASSIFICATION_VARIANTS,
} from '../../lib/cookbook';
import { CLASSIFICATION_DEFINITIONS } from '../../data/cookbook/classification-guide';
import { BOOK_METADATA } from '../../data/cookbook/book-metadata';
import Chip from '../common/Chip.astro';
import FoodIllustration from '../common/FoodIllustration.astro';
import RecipePageHero from './RecipePageHero.astro';
import RecipePageCooking from './RecipePageCooking.astro';
import RecipePageEvidence from './RecipePageEvidence.astro';
import RecipePageClosing from './RecipePageClosing.astro';
import type { PhysicalPageType } from '../../lib/cookbook-pagination';

interface Props {
  kind: BookPageKind;
  id: string;
  physicalPageType?: PhysicalPageType;
  isPreview?: boolean;
}

const { kind, id, physicalPageType } = Astro.props;

// ─── Resolve page data ───────────────────────────────────────────

const SECTION_TO_CHAPTER: Record<string, string> = {
  'cookbook-section-simple-preparations': 'legumes-one-pot-meals',
  'cookbook-section-breads-and-grains': 'grains-breads',
  'cookbook-section-seafood-preparations': 'fish-seafood',
  'cookbook-section-fruits-and-preserves': 'fruits-preserves',
  'cookbook-section-herbs-oils-seasonings': 'herbs-oils-seasonings',
  'cookbook-section-feasts-and-gatherings': 'feasts-gatherings',
};

const recipeContentById = new Map(RECIPE_CONTENT_RECORDS.map((r) => [r.id, r]));

let chapter = COOKBOOK_CHAPTERS.find((c) => c.id === id);
let recipe = recipeContentById.get(id);
let recipeChapter: (typeof COOKBOOK_CHAPTERS)[number] | null = null;
if (recipe) {
  const inclusion = COOKBOOK_RECIPE_INCLUSIONS.find(
    (i) => i.recipeContentId === id,
  );
  if (inclusion) {
    const chapterId = SECTION_TO_CHAPTER[inclusion.sectionId];
    recipeChapter = COOKBOOK_CHAPTERS.find((c) => c.id === chapterId) ?? null;
  }
}
---

{/* ─── RECIPE PHYSICAL PAGES ──────────────────────── */}

{
  kind === 'recipe' && recipe && physicalPageType === 'recipe-hero' && (
    <RecipePageHero recipe={recipe} chapterTitle={recipeChapter?.title} />
  )
}

{
  kind === 'recipe' && recipe && physicalPageType === 'recipe-cooking' && (
    <RecipePageCooking recipe={recipe} />
  )
}

{
  kind === 'recipe' && recipe && physicalPageType === 'recipe-evidence' && (
    <RecipePageEvidence recipe={recipe} />
  )
}

{
  kind === 'recipe' && recipe && physicalPageType === 'recipe-closing' && (
    <RecipePageClosing recipe={recipe} />
  )
}

{/* ─── CHAPTER OPENER ─────────────────────────────── */}
{
  kind === 'chapter' && physicalPageType === 'chapter-opener' && chapter && (
    <div class="book-page-inner book-page-inner--centered">
      <div class="chapter-opener-page">
        <span class="chapter-opener-page__number">
          {String(chapter.order).padStart(2, '0')}
        </span>
        <h1 class="chapter-opener-page__title">{chapter.title}</h1>
        <p class="chapter-opener-page__desc">{chapter.description}</p>
        <div class="chapter-opener-page__art">
          <FoodIllustration
            kind={
              getChapterArt(chapter.id) as
                | 'barley'
                | 'lentils'
                | 'honey'
                | 'galilee'
                | 'olives'
                | 'still-life'
            }
            ratio="16 / 9"
          />
        </div>
        <p class="chapter-opener-page__count">
          {getRecipesForChapter(chapter.id).length}{' '}
          {getRecipesForChapter(chapter.id).length === 1 ? 'recipe' : 'recipes'}{' '}
          in this chapter
        </p>
      </div>
    </div>
  )
}

{/* ─── FRONT MATTER PAGES ─────────────────────────── */}
{
  kind === 'front-matter' && id === 'title-page' && (
    <div class="book-page-inner book-page-inner--centered">
      <div class="title-page-content">
        <p class="title-page-content__publisher">The BiblicalMeal Cookbook</p>
        <h1 class="title-page-content__title">Biblical Meals</h1>
        <p class="title-page-content__subtitle">
          Recipes Inspired by the Foods of the Bible
        </p>
        <div class="title-page-content__divider" />
        <p class="title-page-content__meta">{BOOK_METADATA.publisher}</p>
        <p class="title-page-content__meta">{BOOK_METADATA.edition}</p>
        <p class="title-page-content__year">{BOOK_METADATA.publicationYear}</p>
      </div>
    </div>
  )
}

{
  kind === 'front-matter' && id === 'introduction' && (
    <div class="book-page-inner">
      <h1 class="page-heading">Introduction</h1>
      <div class="page-prose">
        <p>
          Every culture is shaped by what it eats. The foods of the biblical
          world &mdash; bread baked on hot stones, lentils stewed in clay pots,
          fish caught from Galilean waters, honey gathered from wild hives
          &mdash; are not just historical curiosities. They are the daily
          realities that nourished the people whose stories fill Scripture.
        </p>
        <p>
          This cookbook exists to bring those foods back to your kitchen. Not as
          museum pieces or academic exercises, but as real, cookable recipes
          that honour the evidence while acknowledging its limits.
        </p>
        <p>
          We have been honest about what we know and what we don&rsquo;t. Some
          recipes are grounded in explicitly attested ingredients and historical
          preparation methods. Others are modern creations inspired by
          biblical-world ingredients where no specific ancient recipe exists.
        </p>
        <p>
          That honesty is what makes this cookbook different. We don&rsquo;t
          present uncertain reconstructions as discovered facts. We don&rsquo;t
          pretend that a modern kitchen can perfectly replicate an ancient
          preparation. And we don&rsquo;t hide uncertainty behind confident
          language.
        </p>
        <p>Welcome to Biblical Meals.</p>
      </div>
    </div>
  )
}

{
  kind === 'front-matter' && id === 'classification-guide' && (
    <div class="book-page-inner">
      <h1 class="page-heading">Recipe Classification Guide</h1>
      <p class="page-subheading">
        Every recipe carries a classification that tells you exactly how it
        relates to historical evidence.
      </p>
      <div class="classification-grid">
        {CLASSIFICATION_DEFINITIONS.map((def) => (
          <div class="classification-card">
            <div class="classification-card__header">
              <Chip
                variant={
                  CLASSIFICATION_VARIANTS[def.classification] ?? 'inspired'
                }
              >
                {def.label}
              </Chip>
              <span class="classification-card__desc">
                {def.shortDescription}
              </span>
            </div>
            <p class="classification-card__disclosure">
              {def.readerDisclosure}
            </p>
          </div>
        ))}
      </div>
    </div>
  )
}

{/* ─── BACK MATTER (placeholder) ──────────────────── */}
{
  kind === 'back-matter' && (
    <div class="book-page-inner book-page-inner--centered">
      <div class="back-matter-content">
        <h1 class="back-matter-content__title">
          {id === 'sources-bibliography'
            ? 'Sources & Bibliography'
            : id === 'recipe-index'
              ? 'Recipe Index'
              : id === 'ingredient-index'
                ? 'Ingredient Index'
                : id === 'scripture-index'
                  ? 'Scripture Index'
                  : 'Acknowledgments'}
        </h1>
        <p class="back-matter-content__note">
          This section is included in the complete digital edition.
        </p>
      </div>
    </div>
  )
}

<style>
  /* ── Chapter Opener ── */
  .chapter-opener-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    width: 100%;
  }
  .chapter-opener-page__number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--color-olive);
    opacity: 0.6;
  }
  .chapter-opener-page__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0;
  }
  .chapter-opener-page__desc {
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 32ch;
    margin: 0;
  }
  .chapter-opener-page__art {
    width: 100%;
    max-width: 24rem;
    border-radius: 0.5rem;
    overflow: hidden;
    opacity: 0.85;
  }
  .chapter-opener-page__count {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    font-weight: 600;
    color: var(--color-olive-dark);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  /* ── Title Page ── */
  .title-page-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.5rem, 2vw, 1rem);
  }
  .title-page-content__publisher {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-olive-dark);
    margin: 0;
  }
  .title-page-content__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
  }
  .title-page-content__subtitle {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 2.5vw, 1.25rem);
    line-height: 1.3;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .title-page-content__divider {
    width: 4rem;
    height: 1px;
    background: var(--color-line);
    margin: clamp(0.5rem, 1.5vw, 1rem) 0;
  }
  .title-page-content__meta {
    font-family: var(--font-sans);
    font-size: clamp(0.7rem, 1.4vw, 0.8rem);
    color: var(--color-ink-muted);
    margin: 0;
  }
  .title-page-content__year {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* ── Shared page styles ── */
  .page-heading {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.8vw, 1.5rem);
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0 0 clamp(0.375rem, 1.2vw, 0.625rem);
  }
  .page-subheading {
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0 0 clamp(0.5rem, 1.5vw, 0.75rem);
    max-width: 36ch;
  }
  .page-prose {
    display: flex;
    flex-direction: column;
    gap: clamp(0.375rem, 1.2vw, 0.625rem);
  }
  .page-prose p {
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* ── Classification Guide ── */
  .classification-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(0.375rem, 1.2vw, 0.625rem);
  }
  .classification-card {
    padding: clamp(0.375rem, 1vw, 0.625rem);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-background-alt);
  }
  .classification-card__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .classification-card__desc {
    font-family: var(--font-sans);
    font-size: clamp(0.65rem, 1.3vw, 0.75rem);
    font-weight: 500;
    color: var(--color-ink);
  }
  .classification-card__disclosure {
    font-size: clamp(0.6rem, 1.2vw, 0.7rem);
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0.25rem 0 0;
  }

  /* ── Back Matter ── */
  .back-matter-content {
    text-align: center;
  }
  .back-matter-content__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0 0 0.75rem;
  }
  .back-matter-content__note {
    font-size: clamp(0.7rem, 1.4vw, 0.8rem);
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
