---
import type { CollectionEntry } from 'astro:content';
import Button from '../common/Button.astro';
import Chip from '../common/Chip.astro';
import FoodIllustration from '../common/FoodIllustration.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { title, description, inspiredNote, servings, cookMinutes, difficulty } =
  recipe.data;
---

<section class="featured-recipe relative isolate overflow-hidden" id="recipe">
  <div class="featured-recipe__wash" aria-hidden="true"></div>
  <div class="relative container-site section-space">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal relative lg:col-span-7">
        <div class="featured-recipe__art-frame relative">
          <div class="featured-recipe__art-note" aria-hidden="true">
            <span>From the</span><strong>Test Kitchen</strong>
          </div>
          <FoodIllustration
            kind="stew"
            ratio="16 / 10"
            class="featured-recipe__image relative"
          />
        </div>
        <p class="mt-4 text-caption tracking-wide text-ink-muted/70">
          Original illustration for BiblicalMeal
        </p>
      </div>
      <div
        class="reveal relative space-y-6 lg:col-span-5"
        style="--reveal-delay:120ms"
      >
        <div
          class="flex items-center gap-3 text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
        >
          <span class="h-px w-9 bg-terracotta"></span> Featured Reconstruction
        </div>
        <h2 class="font-display text-h2 text-ink">{title}</h2>
        <Chip variant="inspired" />
        <p class="text-body-lg text-ink-muted">{description}</p>
        <div class="border-l-2 border-gold/60 pl-5">
          <p class="text-caption leading-relaxed text-ink-muted italic">
            {inspiredNote}
          </p>
        </div>
        <ul
          class="grid gap-3 border-y border-line py-5 text-body text-ink-muted sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3"
        >
          {
            servings && (
              <li>
                <>
                  <span class="block text-caption font-semibold tracking-wide text-olive-dark uppercase">
                    Serves
                  </span>
                  <span class="font-medium text-ink">{servings}</span>
                </>
              </li>
            )
          }
          {
            cookMinutes && (
              <li>
                <>
                  <span class="block text-caption font-semibold tracking-wide text-olive-dark uppercase">
                    Time
                  </span>
                  <span class="font-medium text-ink">{cookMinutes} min</span>
                </>{' '}
                simmer
              </li>
            )
          }
          {
            difficulty && (
              <li>
                <>
                  <span class="block text-caption font-semibold tracking-wide text-olive-dark uppercase">
                    Difficulty
                  </span>
                  <span class="font-medium text-ink capitalize">
                    {difficulty}
                  </span>
                </>
              </li>
            )
          }
        </ul>
        <div class="flex flex-wrap gap-4">
          <Button href={`/recipes/${recipe.id}/`}>View Recipe</Button><Button
            href="/recipes/"
            variant="secondary">Explore Recipes</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-recipe {
    background: linear-gradient(
      180deg,
      var(--color-background) 0%,
      color-mix(
          in srgb,
          var(--color-background) 72%,
          var(--color-background-alt)
        )
        100%
    );
    contain: paint;
  }
  .featured-recipe__wash {
    position: absolute;
    top: 18%;
    left: -15%;
    width: 28rem;
    height: 28rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(201 162 75 / 0.09),
      transparent 68%
    );
    pointer-events: none;
  }
  .featured-recipe__art-frame {
    padding: 1rem 1rem 1.7rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: 0 18px 45px rgb(41 32 24 / 0.08);
  }
  .featured-recipe__image {
    overflow: hidden;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-line) 80%, white);
  }
  .featured-recipe__art-note {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 0.65rem 0.8rem;
    border-radius: 0.45rem;
    background: rgb(255 252 245 / 0.92);
    color: var(--color-ink-muted);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 5px 20px rgb(41 32 24 / 0.07);
  }
  .featured-recipe__art-note strong {
    color: var(--color-olive-dark);
    font-weight: 700;
  }
</style>
