---
import type { CollectionEntry } from 'astro:content';
import Button from '../common/Button.astro';
import Chip from '../common/Chip.astro';
import EditorialImage from '../common/EditorialImage.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { title, description, inspiredNote, servings, cookMinutes, difficulty } = recipe.data;
---

<section class="featured-recipe relative isolate overflow-hidden" id="recipe">
  <div class="featured-recipe__wash" aria-hidden="true"></div>
  <div class="relative container-site section-space">
    <div class="mb-14 flex items-end justify-between gap-8">
      <div>
        <p class="flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase"><span class="h-px w-9 bg-terracotta/65"></span>Featured recipe</p>
        <h2 class="mt-5 font-display text-h2 text-ink">From the kitchen<span class="text-terracotta">.</span></h2>
      </div>
      <a href="/recipes/" class="hidden font-sans text-caption font-semibold tracking-wide text-terracotta-dark uppercase sm:inline-flex">View all recipes →</a>
    </div>

    <div class="grid items-stretch gap-10 lg:grid-cols-12 lg:gap-16 xl:gap-20">
      <div class="reveal relative lg:col-span-7">
        <a href={`/recipes/${recipe.id}/`} class="featured-recipe__art-frame group block h-full" aria-label={`Read ${title}`}>
          <div class="featured-recipe__art-note" aria-hidden="true"><span>From the</span><strong>BiblicalMeal kitchen</strong></div>
          <EditorialImage id="journal-meal-preparation" fallbackArt="stew" ratio="4 / 3" alt={title} loading="lazy" class="featured-recipe__image" />
          <div class="featured-recipe__caption"><span>{title}</span><span aria-hidden="true">→</span></div>
        </a>
      </div>

      <div class="reveal flex flex-col justify-center lg:col-span-5" style="--reveal-delay:120ms">
        <div class="flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"><span class="h-px w-9 bg-terracotta"></span> Biblical-inspired cooking</div>
        <h3 class="mt-5 font-display text-display-sm text-ink">{title}</h3>
        <div class="mt-5"><Chip variant="inspired" /></div>
        <p class="mt-5 max-w-xl text-body-lg leading-relaxed text-ink-muted">{description}</p>
        <p class="mt-6 max-w-xl border-l-2 border-gold/60 pl-5 text-body leading-relaxed text-ink-muted italic">{inspiredNote}</p>

        <ul class="mt-9 grid grid-cols-3 gap-4 border-y border-line py-6 text-caption text-ink-muted">
          {servings && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Serves</span><span class="mt-1 block font-medium text-ink">{servings}</span></li>}
          {cookMinutes && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Time</span><span class="mt-1 block font-medium text-ink">{cookMinutes} min</span></li>}
          {difficulty && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Difficulty</span><span class="mt-1 block font-medium text-ink capitalize">{difficulty}</span></li>}
        </ul>

        <div class="mt-8 flex flex-wrap gap-3"><Button href={`/recipes/${recipe.id}/`}>View Recipe</Button><Button href="/recipes/" variant="secondary">Explore Recipes</Button></div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-recipe { background: linear-gradient(180deg, var(--color-background), var(--color-background-alt)); }
  .featured-recipe__wash { position: absolute; inset: 4rem auto auto -16rem; width: 38rem; height: 38rem; border-radius: 50%; background: radial-gradient(circle, rgb(201 162 75 / 0.07), transparent 68%); pointer-events: none; }
  .featured-recipe__art-frame { position: relative; overflow: hidden; min-height: 100%; border: 1px solid color-mix(in srgb, var(--color-line) 88%, var(--color-gold)); background: var(--color-surface); box-shadow: 0 24px 58px rgb(41 32 24 / 0.09); }
  .featured-recipe__art-frame :global(.editorial-image), .featured-recipe__art-frame :global(img) { width: 100%; height: 100%; min-height: 32rem; }
  .featured-recipe__art-frame :global(img) { object-fit: cover; object-position: center; filter: saturate(0.9) contrast(1.02); transition: transform 700ms ease, filter 700ms ease; }
  .featured-recipe__art-note { position: absolute; z-index: 2; top: 1.25rem; left: 1.25rem; display: flex; flex-direction: column; border: 1px solid rgb(255 252 245 / 0.36); background: rgb(255 252 245 / 0.9); padding: 0.6rem 0.75rem; color: var(--color-ink-muted); font-family: var(--font-sans); font-size: 0.62rem; letter-spacing: 0.11em; text-transform: uppercase; }
  .featured-recipe__art-note strong { color: var(--color-olive-dark); }
  .featured-recipe__caption { position: absolute; right: 1.5rem; bottom: 1.5rem; left: 1.5rem; display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; border: 1px solid rgb(255 252 245 / 0.12); background: rgb(30 39 22 / 0.86); color: var(--color-cream); font-family: var(--font-display); font-size: clamp(1.1rem, 1rem + 0.4vw, 1.45rem); }
  @media (prefers-reduced-motion: no-preference) { .featured-recipe__art-frame:hover :global(img) { transform: scale(1.025); filter: saturate(0.96) contrast(1.03); } }
  @media (max-width: 767px) { .featured-recipe__art-frame :global(.editorial-image), .featured-recipe__art-frame :global(img) { min-height: 23rem; } .featured-recipe__caption { right: 1rem; bottom: 1rem; left: 1rem; } }
</style>
