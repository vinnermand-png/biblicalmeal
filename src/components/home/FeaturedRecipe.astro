---
import type { CollectionEntry } from 'astro:content';
import Button from '../common/Button.astro';
import Chip from '../common/Chip.astro';
import EditorialImage from '../common/EditorialImage.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const { title, description, inspiredNote, servings, cookMinutes, difficulty } = recipe.data;
---

<section class="featured-recipe relative isolate overflow-hidden" id="recipe">
  <div class="featured-recipe__wash" aria-hidden="true"></div>
  <div class="relative container-site section-space">
    <div class="mb-12 flex items-end justify-between gap-8">
      <div>
        <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">Featured recipe</p>
        <h2 class="mt-3 font-display text-h2 text-ink">From the kitchen</h2>
      </div>
      <a href="/recipes/" class="hidden font-sans text-caption font-semibold tracking-wide text-terracotta-dark sm:inline-flex">View all recipes →</a>
    </div>

    <div class="grid items-stretch gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="reveal relative lg:col-span-7">
        <a href={`/recipes/${recipe.id}/`} class="featured-recipe__art-frame group block h-full" aria-label={`Read ${title}`}>
          <div class="featured-recipe__art-note" aria-hidden="true">
            <span>From the</span><strong>BiblicalMeal kitchen</strong>
          </div>
          <EditorialImage
            id="journal-meal-preparation"
            fallbackArt="stew"
            ratio="4 / 3"
            alt={title}
            loading="lazy"
            class="featured-recipe__image"
          />
          <div class="featured-recipe__caption">
            <span>{title}</span><span aria-hidden="true">→</span>
          </div>
        </a>
      </div>

      <div class="reveal flex flex-col justify-center lg:col-span-5" style="--reveal-delay:120ms">
        <div class="flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">
          <span class="h-px w-9 bg-terracotta"></span> Biblical-inspired cooking
        </div>
        <h3 class="mt-5 font-display text-display-sm text-ink">{title}</h3>
        <div class="mt-5"><Chip variant="inspired" /></div>
        <p class="mt-5 max-w-xl text-body-lg text-ink-muted">{description}</p>
        <p class="mt-5 max-w-xl border-l-2 border-gold/60 pl-5 text-body text-ink-muted italic">{inspiredNote}</p>

        <ul class="mt-8 grid grid-cols-3 gap-4 border-y border-line py-5 text-caption text-ink-muted">
          {servings && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Serves</span><span class="mt-1 block font-medium text-ink">{servings}</span></li>}
          {cookMinutes && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Time</span><span class="mt-1 block font-medium text-ink">{cookMinutes} min</span></li>}
          {difficulty && <li><span class="block font-semibold tracking-wide text-olive-dark uppercase">Difficulty</span><span class="mt-1 block font-medium text-ink capitalize">{difficulty}</span></li>}
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`/recipes/${recipe.id}/`}>View Recipe</Button>
          <Button href="/recipes/" variant="secondary">Explore Recipes</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-recipe {
    background: var(--color-background);
  }
  .featured-recipe__wash {
    position: absolute;
    inset: 8rem auto auto -14rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(201 162 75 / 0.08), transparent 68%);
    pointer-events: none;
  }
  .featured-recipe__art-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: 0 22px 50px rgb(41 32 24 / 0.09);
  }
  .featured-recipe__image :global(img) {
    transition: transform 700ms ease;
  }
  .featured-recipe__art-note {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 1rem;
    display: flex;
    flex-direction: column;
    border: 1px solid rgb(255 252 245 / 0.45);
    border-radius: 0.55rem;
    background: rgb(255 252 245 / 0.9);
    padding: 0.55rem 0.7rem;
    color: var(--color-ink-muted);
    font-family: var(--font-sans);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .featured-recipe__art-note strong {
    color: var(--color-olive-dark);
  }
  .featured-recipe__caption {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.6rem;
    background: rgb(41 32 24 / 0.74);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .featured-recipe__art-frame:hover .featured-recipe__image :global(img) {
      transform: scale(1.025);
    }
  }
</style>
