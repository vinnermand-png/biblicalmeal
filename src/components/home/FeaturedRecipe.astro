---
import type { CollectionEntry } from 'astro:content';
import Button from '../common/Button.astro';
import Chip from '../common/Chip.astro';
import FoodIllustration from '../common/FoodIllustration.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, description, inspiredNote, servings, cookMinutes, difficulty } =
  recipe.data;
---

<section class="overflow-hidden" id="recipe">
  <div class="container-site py-20 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-7">
        <div class="group">
          <FoodIllustration
            kind="stew"
            ratio="16 / 10"
            class="rounded-xl shadow-lg"
          />
        </div>
        <p class="mt-3 text-caption text-ink-muted/70">
          Original illustration for BiblicalMeal
        </p>
      </div>
      <div class="reveal space-y-6 lg:col-span-5" style="--reveal-delay: 120ms">
        <p
          class="text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
        >
          From the Test Kitchen
        </p>
        <h2 class="font-display text-h2 text-ink">{title}</h2>
        <Chip variant="inspired" />
        <p class="text-body-lg text-ink-muted">{description}</p>
        <p class="text-caption leading-relaxed text-ink-muted/80 italic">
          {inspiredNote}
        </p>
        <ul
          class="flex flex-wrap gap-x-6 gap-y-2 border-y border-line py-4 text-body text-ink-muted"
        >
          {
            servings && (
              <li>
                <span class="font-medium text-ink">{servings}</span> servings
              </li>
            )
          }
          {
            cookMinutes && (
              <li>
                <span class="font-medium text-ink">{cookMinutes}</span> min
                simmer
              </li>
            )
          }
          {
            difficulty && (
              <li>
                Difficulty:{' '}
                <span class="font-medium text-ink capitalize">
                  {difficulty}
                </span>
              </li>
            )
          }
        </ul>
        <div class="flex flex-wrap gap-4">
          <Button href={`/recipes/${recipe.id}/`}>View Recipe</Button>
          <Button href="/recipes/" variant="secondary">Explore Recipes</Button>
        </div>
      </div>
    </div>
  </div>
</section>
