---
import Button from '../common/Button.astro';
---

<section class="cookbook-feature relative isolate scroll-mt-24 overflow-hidden" id="cookbook">
  <div class="cookbook-feature__grain" aria-hidden="true"></div>
  <div class="cookbook-feature__glow cookbook-feature__glow--left" aria-hidden="true"></div>
  <div class="cookbook-feature__glow cookbook-feature__glow--right" aria-hidden="true"></div>
  <div class="cookbook-feature__ring cookbook-feature__ring--left" aria-hidden="true"></div>
  <div class="cookbook-feature__ring cookbook-feature__ring--right" aria-hidden="true"></div>

  <div class="relative container-site section-space">
    <div class="cookbook-feature__layout grid items-center gap-14 lg:grid-cols-12 lg:gap-24 xl:gap-32">
      <div class="reveal order-last lg:order-first lg:col-span-5">
        <div class="cookbook-showcase mx-auto max-w-[30rem]">
          <div class="cookbook-showcase__label">A BiblicalMeal original</div>
          <div class="cookbook-object">
            <div class="cookbook-object__shadow" aria-hidden="true"></div>
            <div class="cookbook-object__pages" aria-hidden="true"></div>
            <div class="cookbook-object__page-lines" aria-hidden="true"></div>
            <div class="cookbook-object__cover relative aspect-[8/10] overflow-hidden rounded-[0.18rem] p-8 sm:p-10 lg:p-12">
              <div class="cookbook-object__spine" aria-hidden="true"></div>
              <div class="cookbook-object__paper" aria-hidden="true"></div>
              <div class="cookbook-object__foil" aria-hidden="true"></div>
              <div class="cookbook-object__texture" aria-hidden="true"></div>
              <div class="relative z-10 flex h-full flex-col justify-between text-center">
                <p class="text-eyebrow font-semibold tracking-eyebrow text-gold/90 uppercase">A BiblicalMeal Cookbook</p>
                <div class="space-y-5">
                  <h3 class="font-display text-h1 text-cream">Biblical<br />Meals</h3>
                  <div class="mx-auto h-px w-16 bg-gold/70"></div>
                  <p class="font-display text-h3 text-cream-muted italic">Recipes Inspired by the Foods<br />of the Bible</p>
                </div>
                <p class="text-caption tracking-wide text-cream-muted/80">Digital cookbook · In development</p>
              </div>
            </div>
          </div>
          <p class="cookbook-showcase__caption">A living collection of ingredients, stories and dishes.</p>
        </div>
      </div>

      <div class="reveal lg:col-span-7" style="--reveal-delay:120ms">
        <div class="cookbook-copy max-w-3xl">
          <p class="flex items-center gap-3 text-eyebrow font-semibold tracking-eyebrow text-gold uppercase"><span class="h-px w-10 bg-gold/70"></span>The Cookbook</p>

          <div class="mt-7 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <div>
              <h2 class="font-display text-h2 text-cream">Biblical Meals<span class="text-terracotta">.</span></h2>
              <p class="mt-5 max-w-2xl text-body-lg leading-relaxed text-cream/72">
                A carefully gathered digital cookbook shaped by Scripture, ancient ingredients and the meals that bring them back to the table.
              </p>
            </div>
            <div class="cookbook-status">In development<span></span></div>
          </div>

          <div class="cookbook-divider" aria-hidden="true"></div>

          <div class="cookbook-manifesto grid gap-7 sm:grid-cols-[auto_1fr] sm:items-start">
            <span class="cookbook-manifesto__number">01—03</span>
            <p>Not a recipe archive. A beautifully edited table of biblical food culture — from the ingredient itself to its history, meaning and modern kitchen life.</p>
          </div>

          <ul class="cookbook-pillars grid gap-px overflow-hidden border border-cream/10 bg-cream/10 sm:grid-cols-3">
            <li>
              <span class="font-display text-h3 text-gold">01</span>
              <strong>Ingredients</strong>
              <p>Stories behind the foods named in Scripture.</p>
            </li>
            <li>
              <span class="font-display text-h3 text-gold">02</span>
              <strong>Recipes</strong>
              <p>Kitchen-tested dishes made for today.</p>
            </li>
            <li>
              <span class="font-display text-h3 text-gold">03</span>
              <strong>The Table</strong>
              <p>Menus for gathering, seasons and celebration.</p>
            </li>
          </ul>

          <div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-center">
            <Button href="/#newsletter" size="lg">Notify me at launch</Button>
            <span class="cookbook-note">First edition · currently being developed</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cookbook-feature {
    background:
      radial-gradient(circle at 14% 50%, rgb(107 127 67 / 0.22), transparent 31%),
      radial-gradient(circle at 84% 12%, rgb(194 145 62 / 0.09), transparent 25%),
      linear-gradient(120deg, #10170c 0%, #172111 47%, #0d1309 100%);
    contain: paint;
  }
  .cookbook-feature__grain { position:absolute; inset:0; opacity:.22; pointer-events:none; background-image:radial-gradient(rgb(255 252 245 / .12) .45px, transparent .7px); background-size:6px 6px; mix-blend-mode:soft-light; }
  .cookbook-feature__glow { position:absolute; width:34rem; height:34rem; border-radius:999px; filter:blur(12px); pointer-events:none; }
  .cookbook-feature__glow--left { left:-14rem; bottom:-17rem; background:radial-gradient(circle, rgb(102 128 61 / .24), transparent 66%); }
  .cookbook-feature__glow--right { right:-12rem; top:-17rem; background:radial-gradient(circle, rgb(190 145 72 / .09), transparent 66%); }
  .cookbook-feature__ring { position:absolute; width:38rem; height:38rem; border:1px solid rgb(201 162 75 / .075); border-radius:50%; pointer-events:none; }
  .cookbook-feature__ring--left { left:-29rem; bottom:-29rem; }
  .cookbook-feature__ring--right { right:-30rem; top:-30rem; }

  .cookbook-showcase { position:relative; }
  .cookbook-showcase__label { position:absolute; left:-1rem; top:1.2rem; z-index:4; border:1px solid rgb(201 162 75 / .22); background:rgb(16 23 12 / .82); padding:.55rem .8rem; font-size:.58rem; letter-spacing:.18em; text-transform:uppercase; color:rgb(217 190 122 / .85); backdrop-filter:blur(8px); }
  .cookbook-showcase__caption { margin:1.8rem auto 0; max-width:20rem; text-align:center; font-size:.72rem; letter-spacing:.08em; color:rgb(255 252 245 / .38); }

  .cookbook-object { position:relative; isolation:isolate; padding:.8rem 2rem 2rem .8rem; transform:perspective(1500px) rotateY(8deg) rotateZ(-3.5deg); transition:transform .6s ease; }
  .cookbook-object:hover { transform:perspective(1500px) rotateY(3deg) rotateZ(-1.5deg) translateY(-4px); }
  .cookbook-object__shadow { position:absolute; z-index:-4; inset:3.1rem 1.6rem .5rem 2.4rem; transform:rotate(5deg); background:rgb(0 0 0 / .62); filter:blur(2px); box-shadow:0 38px 90px rgb(0 0 0 / .5); }
  .cookbook-object__pages { position:absolute; z-index:-1; inset:.9rem .2rem .15rem 1rem; border:1px solid rgb(235 229 211 / .56); background:linear-gradient(90deg,#c9c0ae 0%,#eee7d8 9%,#e5ddcc 96%,#aaa18f 100%); box-shadow:9px 9px 0 #b7ad99,14px 14px 0 #938a79; }
  .cookbook-object__page-lines { position:absolute; z-index:0; right:.45rem; top:1.35rem; bottom:.55rem; width:.7rem; background:repeating-linear-gradient(0deg,rgb(91 84 73 / .18) 0 1px,transparent 1px 3px); opacity:.85; }
  .cookbook-object__cover { border:1px solid rgb(255 252 245 / .18); background:linear-gradient(145deg,#5b6b3b 0%,#3a4b29 45%,#1a2512 100%); box-shadow:inset 0 0 0 1px rgb(255 252 245 / .035),24px 32px 80px rgb(0 0 0 / .36); }
  .cookbook-object__cover::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at 73% 17%,rgb(201 162 75 / .18),transparent 27%),linear-gradient(115deg,transparent 0 43%,rgb(255 252 245 / .05) 43% 44%,transparent 44% 100%); pointer-events:none; }
  .cookbook-object__spine { position:absolute; inset:0 auto 0 0; width:1.5rem; background:linear-gradient(90deg,rgb(0 0 0 / .5),rgb(255 252 245 / .08),transparent); }
  .cookbook-object__paper { position:absolute; inset:.75rem; border:1px solid rgb(201 162 75 / .3); pointer-events:none; }
  .cookbook-object__foil { position:absolute; inset:1.15rem; border:1px solid rgb(226 192 105 / .09); pointer-events:none; }
  .cookbook-object__texture { position:absolute; inset:0; opacity:.26; background-image:radial-gradient(rgb(255 252 245 / .16) .5px,transparent .7px); background-size:7px 7px; mix-blend-mode:soft-light; pointer-events:none; }

  .cookbook-copy { padding-left:clamp(0rem,2vw,2rem); }
  .cookbook-status { display:inline-flex; align-items:center; gap:.6rem; width:max-content; border:1px solid rgb(201 162 75 / .25); background:rgb(201 162 75 / .05); padding:.7rem .85rem; font-size:.64rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:rgb(217 190 122 / .9); }
  .cookbook-status span { width:.4rem; height:.4rem; border-radius:50%; background:#b75b31; box-shadow:0 0 0 4px rgb(183 91 49 / .12); }
  .cookbook-divider { height:1px; margin:2.2rem 0; background:linear-gradient(90deg,rgb(201 162 75 / .35),rgb(255 252 245 / .12) 38%,transparent); }
  .cookbook-manifesto__number { font-size:.68rem; font-weight:700; letter-spacing:.14em; color:rgb(201 162 75 / .78); white-space:nowrap; }
  .cookbook-manifesto p { max-width:44rem; font-family:var(--font-display, serif); font-size:1.08rem; line-height:1.65; color:rgb(255 252 245 / .74); }
  .cookbook-pillars { margin-top:2.5rem; }
  .cookbook-pillars li { min-height:11rem; background:rgb(14 21 10 / .64); padding:1.55rem; }
  .cookbook-pillars span { display:block; margin-bottom:1.5rem; }
  .cookbook-pillars strong { display:block; margin-bottom:.55rem; font-size:.82rem; letter-spacing:.08em; text-transform:uppercase; color:rgb(255 252 245 / .9); }
  .cookbook-pillars p { max-width:13rem; font-size:.86rem; line-height:1.55; color:rgb(255 252 245 / .5); }
  .cookbook-note { font-size:.7rem; letter-spacing:.06em; color:rgb(255 252 245 / .42); }

  @media (max-width: 1023px) { .cookbook-copy { padding-left:0; } .cookbook-showcase__label { left:0; } }
  @media (max-width: 640px) {
    .cookbook-feature__layout { gap:3.5rem; }
    .cookbook-object { max-width:22rem; margin:auto; padding:.6rem 1.35rem 1.35rem .6rem; transform:perspective(1000px) rotateY(3deg) rotateZ(-1.5deg); }
    .cookbook-object:hover { transform:perspective(1000px) rotateY(1deg) rotateZ(-.5deg); }
    .cookbook-showcase__label { top:.5rem; font-size:.5rem; }
    .cookbook-pillars li { min-height:auto; }
    .cookbook-manifesto p { font-size:1rem; }
  }
</style>
