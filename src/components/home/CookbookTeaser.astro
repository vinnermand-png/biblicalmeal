---
import Button from '../common/Button.astro';
---

<section class="cookbook-feature relative isolate scroll-mt-24 overflow-hidden" id="cookbook">
  <div class="cookbook-feature__grain" aria-hidden="true"></div>
  <div class="cookbook-feature__vignette" aria-hidden="true"></div>

  <div class="cookbook-feature__main relative">
    <div class="cookbook-feature__visual reveal">
      <div class="cookbook-scene" aria-hidden="true">
        <div class="cookbook-scene__olive cookbook-scene__olive--one"></div>
        <div class="cookbook-scene__olive cookbook-scene__olive--two"></div>
        <div class="cookbook-scene__cloth"></div>
        <div class="cookbook-scene__vessel"></div>
        <div class="cookbook-scene__bread"></div>
        <div class="cookbook-scene__fig cookbook-scene__fig--one"></div>
        <div class="cookbook-scene__fig cookbook-scene__fig--two"></div>
      </div>

      <div class="cookbook-showcase">
        <div class="cookbook-showcase__seal">
          <span>Inspired by</span>
          <strong>Scripture</strong>
          <i>✦</i>
          <strong>Made for<br />today</strong>
        </div>

        <div class="cookbook-object">
          <div class="cookbook-object__shadow" aria-hidden="true"></div>
          <div class="cookbook-object__pages" aria-hidden="true"></div>
          <div class="cookbook-object__page-lines" aria-hidden="true"></div>
          <div class="cookbook-object__cover relative aspect-[8/10] overflow-hidden rounded-[0.12rem] p-8 sm:p-10 lg:p-12">
            <div class="cookbook-object__spine" aria-hidden="true"></div>
            <div class="cookbook-object__paper" aria-hidden="true"></div>
            <div class="cookbook-object__foil" aria-hidden="true"></div>
            <div class="cookbook-object__texture" aria-hidden="true"></div>
            <div class="relative z-10 flex h-full flex-col justify-between text-center">
              <div class="space-y-4">
                <span class="cookbook-cover__branch">⌁</span>
                <h3 class="font-display text-h1 text-cream">Biblical<br />Meals</h3>
                <div class="mx-auto h-px w-16 bg-gold/70"></div>
              </div>
              <div class="space-y-5">
                <p class="font-display text-h3 text-gold/90">Recipes inspired by<br />the Foods of the Bible</p>
                <p class="text-eyebrow font-semibold tracking-eyebrow text-gold/75 uppercase">A BiblicalMeal Cookbook</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="cookbook-feature__content reveal" style="--reveal-delay:120ms">
      <div class="cookbook-copy">
        <p class="cookbook-kicker text-eyebrow font-semibold tracking-eyebrow text-gold uppercase">The Cookbook</p>
        <h2 class="font-display text-h2 text-cream">Biblical Meals<span class="text-terracotta">.</span></h2>
        <div class="cookbook-ornament" aria-hidden="true"><span></span><i>⌁</i><span></span></div>
        <p class="cookbook-lead">
          We are gathering our recipes inspired by the foods of the Bible into a single digital cookbook — ingredient stories, kitchen-tested dishes, and menus for the table.
        </p>

        <div class="cookbook-pillars grid gap-0 sm:grid-cols-3">
          <div class="cookbook-pillar">
            <span>01</span>
            <i></i>
            <p>Recipes inspired by<br />biblical ingredients</p>
          </div>
          <div class="cookbook-pillar">
            <span>02</span>
            <i></i>
            <p>Short histories behind<br />every dish</p>
          </div>
          <div class="cookbook-pillar">
            <span>03</span>
            <i></i>
            <p>Menus for gathering<br />and celebration</p>
          </div>
        </div>

        <div class="cookbook-action">
          <Button href="/#newsletter" size="lg">Notify me at launch</Button>
          <span>Join the first readers</span>
        </div>
      </div>
    </div>
  </div>

  <div class="cookbook-feature__values relative">
    <div class="container-site">
      <div class="grid gap-px overflow-hidden sm:grid-cols-3">
        <article class="cookbook-value">
          <div class="cookbook-value__icon">✥</div>
          <div><h3>Rooted in Scripture</h3><p>Every recipe and ingredient is rooted in the Bible.</p></div>
        </article>
        <article class="cookbook-value">
          <div class="cookbook-value__icon">⌁</div>
          <div><h3>Authentic &amp; Timeless</h3><p>Ancient ingredients, traditional wisdom, modern kitchens.</p></div>
        </article>
        <article class="cookbook-value">
          <div class="cookbook-value__icon">◯</div>
          <div><h3>Made for Today</h3><p>Nourishing meals for real life, family, and community.</p></div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .cookbook-feature { background:#10170d; contain:paint; }
  .cookbook-feature__grain { position:absolute; inset:0; z-index:5; opacity:.12; pointer-events:none; background-image:radial-gradient(rgb(255 252 245 / .15) .45px,transparent .7px); background-size:7px 7px; mix-blend-mode:soft-light; }
  .cookbook-feature__vignette { position:absolute; inset:0; background:radial-gradient(circle at 54% 38%, transparent 0 24%, rgb(0 0 0 / .12) 68%, rgb(0 0 0 / .28) 100%); pointer-events:none; }
  .cookbook-feature__main { display:grid; min-height:46rem; grid-template-columns:minmax(0,43%) minmax(0,57%); }

  .cookbook-feature__visual { position:relative; min-height:46rem; overflow:hidden; border-right:1px solid rgb(201 162 75 / .12); }
  .cookbook-scene { position:absolute; inset:0; background:radial-gradient(circle at 48% 20%, rgb(102 67 37 / .34), transparent 28%), linear-gradient(135deg,#0d130a 0%,#1b2111 40%,#4a3521 115%); }
  .cookbook-scene::before { content:''; position:absolute; inset:0; background:linear-gradient(90deg,rgb(0 0 0 / .2),transparent 45%), linear-gradient(0deg,rgb(0 0 0 / .5),transparent 44%); }
  .cookbook-scene__olive { position:absolute; width:12rem; height:12rem; border-radius:50%; filter:blur(20px); opacity:.32; background:radial-gradient(circle at 40% 40%,#8a8f47,transparent 58%); }
  .cookbook-scene__olive--one { left:-4rem; top:-2rem; }
  .cookbook-scene__olive--two { right:-7rem; bottom:7rem; }
  .cookbook-scene__cloth { position:absolute; left:-10%; bottom:-8%; width:60%; height:35%; border-radius:50%; transform:rotate(-12deg); background:repeating-linear-gradient(135deg,rgb(215 202 172 / .18) 0 2px,transparent 2px 11px), linear-gradient(145deg,rgb(159 136 100 / .28),rgb(65 50 34 / .12)); filter:blur(1px); }
  .cookbook-scene__vessel { position:absolute; right:7%; top:16%; width:23%; height:34%; border-radius:45% 45% 38% 38%; background:radial-gradient(ellipse at 30% 20%,rgb(174 111 58 / .6),transparent 32%), linear-gradient(90deg,#392013,#9b6034 44%,#2d180f); box-shadow:inset -1.2rem 0 2rem rgb(0 0 0 / .45),0 2rem 4rem rgb(0 0 0 / .42); opacity:.9; }
  .cookbook-scene__bread { position:absolute; right:4%; bottom:25%; width:34%; height:16%; border-radius:50% 48% 45% 42%; transform:rotate(-10deg); background:radial-gradient(ellipse at 45% 35%,#c38b4e 0 18%,#7b4727 55%,#342015 100%); box-shadow:inset 1rem -1rem 2rem rgb(0 0 0 / .28),0 1.5rem 3rem rgb(0 0 0 / .35); }
  .cookbook-scene__fig { position:absolute; bottom:7%; width:5.6rem; height:5.6rem; border-radius:48% 52% 45% 55%; background:radial-gradient(circle at 48% 50%,#9e4933 0 20%,#4e1c17 22% 33%,#1c130e 64%); box-shadow:inset 0 0 1rem rgb(255 203 136 / .18),0 1.5rem 2rem rgb(0 0 0 / .38); }
  .cookbook-scene__fig--one { right:18%; transform:rotate(22deg); }
  .cookbook-scene__fig--two { right:6%; bottom:4%; transform:rotate(-18deg) scale(.78); }

  .cookbook-showcase { position:relative; z-index:2; display:flex; min-height:100%; align-items:center; justify-content:center; padding:5rem 3rem; }
  .cookbook-showcase__seal { position:absolute; z-index:5; top:3.4rem; left:3rem; display:grid; width:9rem; height:9rem; place-content:center; gap:.45rem; border:1px solid rgb(201 162 75 / .7); border-radius:50%; background:rgb(16 23 13 / .76); box-shadow:inset 0 0 0 .35rem rgb(16 23 13 / .68), inset 0 0 0 .42rem rgb(201 162 75 / .15); text-align:center; text-transform:uppercase; color:rgb(221 190 122 / .9); backdrop-filter:blur(10px); }
  .cookbook-showcase__seal span,.cookbook-showcase__seal strong { font-size:.55rem; font-weight:700; letter-spacing:.18em; line-height:1.45; }
  .cookbook-showcase__seal i { font-size:.75rem; font-style:normal; color:#c9a24b; }

  .cookbook-object { position:relative; width:min(26rem,100%); isolation:isolate; padding:.9rem 1.9rem 1.9rem .9rem; transform:perspective(1600px) rotateY(7deg) rotateZ(-2.2deg); transition:transform .6s ease; }
  .cookbook-object:hover { transform:perspective(1600px) rotateY(2deg) rotateZ(-.8deg) translateY(-4px); }
  .cookbook-object__shadow { position:absolute; z-index:-4; inset:2.7rem 1.2rem .5rem 2rem; background:rgb(0 0 0 / .68); transform:rotate(4deg); filter:blur(2px); box-shadow:0 35px 85px rgb(0 0 0 / .72); }
  .cookbook-object__pages { position:absolute; z-index:-1; inset:.85rem .15rem .15rem .9rem; border:1px solid rgb(235 229 211 / .55); background:linear-gradient(90deg,#bcb29e 0%,#eee7d8 8%,#e5ddcc 95%,#968b77); box-shadow:8px 8px 0 #a59a86,13px 13px 0 #7f7769; }
  .cookbook-object__page-lines { position:absolute; z-index:0; right:.35rem; top:1.2rem; bottom:.5rem; width:.7rem; opacity:.85; background:repeating-linear-gradient(0deg,rgb(82 76 65 / .22) 0 1px,transparent 1px 3px); }
  .cookbook-object__cover { border:1px solid rgb(214 176 88 / .48); background:radial-gradient(circle at 66% 10%,rgb(183 143 64 / .14),transparent 24%),linear-gradient(145deg,#28361d 0%,#172315 56%,#0c120b 100%); box-shadow:inset 0 0 0 1px rgb(255 252 245 / .025), 28px 32px 75px rgb(0 0 0 / .46); }
  .cookbook-object__cover::after { content:''; position:absolute; inset:0; background:linear-gradient(110deg,transparent 0 48%,rgb(255 255 255 / .04) 48% 49%,transparent 49% 100%),radial-gradient(circle at 76% 17%,rgb(214 176 88 / .13),transparent 28%); pointer-events:none; }
  .cookbook-object__spine { position:absolute; inset:0 auto 0 0; width:1.25rem; background:linear-gradient(90deg,rgb(0 0 0 / .6),rgb(214 176 88 / .12),transparent); }
  .cookbook-object__paper { position:absolute; inset:.72rem; border:1px solid rgb(214 176 88 / .34); pointer-events:none; }
  .cookbook-object__foil { position:absolute; inset:1.08rem; border:1px solid rgb(214 176 88 / .08); pointer-events:none; }
  .cookbook-object__texture { position:absolute; inset:0; opacity:.2; background-image:radial-gradient(rgb(255 252 245 / .14) .5px,transparent .7px); background-size:7px 7px; mix-blend-mode:soft-light; pointer-events:none; }
  .cookbook-cover__branch { display:block; font-size:2.2rem; line-height:1; color:rgb(214 176 88 / .75); }

  .cookbook-feature__content { display:flex; min-height:46rem; align-items:center; justify-content:center; padding:5rem clamp(2rem,7vw,8rem); background:radial-gradient(circle at 50% 0%,rgb(89 69 32 / .08),transparent 36%),linear-gradient(90deg,#11170d,#10150d); }
  .cookbook-copy { width:100%; max-width:47rem; text-align:center; }
  .cookbook-kicker { display:flex; align-items:center; justify-content:center; gap:1rem; margin-bottom:1.2rem; }
  .cookbook-kicker::before,.cookbook-kicker::after { content:''; width:2.6rem; height:1px; background:rgb(201 162 75 / .45); }
  .cookbook-copy h2 { font-size:clamp(4rem,6vw,7.6rem); line-height:.92; letter-spacing:-.045em; }
  .cookbook-ornament { display:flex; align-items:center; justify-content:center; gap:.7rem; margin:2rem 0; color:rgb(201 162 75 / .78); }
  .cookbook-ornament span { width:7rem; height:1px; background:linear-gradient(90deg,transparent,rgb(201 162 75 / .55)); }
  .cookbook-ornament span:last-child { background:linear-gradient(90deg,rgb(201 162 75 / .55),transparent); }
  .cookbook-ornament i { font-style:normal; font-size:2rem; line-height:1; }
  .cookbook-lead { max-width:42rem; margin:0 auto; font-size:clamp(1rem,1.45vw,1.28rem); line-height:1.8; color:rgb(255 252 245 / .75); }
  .cookbook-pillars { margin-top:2.6rem; }
  .cookbook-pillar { position:relative; min-height:8.4rem; padding:0 1.4rem; }
  .cookbook-pillar + .cookbook-pillar { border-left:1px solid rgb(201 162 75 / .22); }
  .cookbook-pillar span { display:block; font-family:var(--font-display,serif); font-size:2rem; line-height:1; color:rgb(214 176 88 / .86); }
  .cookbook-pillar i { display:block; width:1.8rem; height:1px; margin:.65rem auto 1rem; background:rgb(214 176 88 / .58); }
  .cookbook-pillar p { font-size:.9rem; line-height:1.7; color:rgb(255 252 245 / .68); }
  .cookbook-action { display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:2.6rem; }
  .cookbook-action :global(a) { min-width:20rem; justify-content:center; border:1px solid rgb(214 176 88 / .6); background:linear-gradient(90deg,#6e451c,#a56f28); box-shadow:0 .7rem 2rem rgb(0 0 0 / .25),inset 0 1px 0 rgb(255 235 184 / .15); }
  .cookbook-action span { font-size:.64rem; letter-spacing:.14em; text-transform:uppercase; color:rgb(255 252 245 / .35); }

  .cookbook-feature__values { border-top:1px solid rgb(201 162 75 / .18); background:linear-gradient(90deg,#151d11,#1b2114 50%,#171d11); }
  .cookbook-value { display:grid; grid-template-columns:auto 1fr; align-items:center; gap:1.4rem; min-height:9.8rem; padding:2rem clamp(1.4rem,3vw,3.5rem); background:rgb(10 14 8 / .12); }
  .cookbook-value + .cookbook-value { border-left:1px solid rgb(201 162 75 / .16); }
  .cookbook-value__icon { display:grid; width:3rem; height:3rem; place-items:center; border:1px solid rgb(201 162 75 / .42); border-radius:50%; color:rgb(214 176 88 / .85); font-size:1.2rem; }
  .cookbook-value h3 { margin-bottom:.55rem; font-size:.68rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:rgb(214 176 88 / .92); }
  .cookbook-value p { max-width:18rem; font-size:.88rem; line-height:1.55; color:rgb(255 252 245 / .56); }

  @media (max-width:1023px) {
    .cookbook-feature__main { grid-template-columns:1fr; }
    .cookbook-feature__visual,.cookbook-feature__content { min-height:0; }
    .cookbook-feature__visual { min-height:38rem; border-right:0; border-bottom:1px solid rgb(201 162 75 / .12); }
    .cookbook-feature__content { padding:5.5rem 2rem; }
    .cookbook-value + .cookbook-value { border-left:0; border-top:1px solid rgb(201 162 75 / .16); }
  }
  @media (max-width:640px) {
    .cookbook-feature__visual { min-height:34rem; }
    .cookbook-showcase { padding:5rem 1.5rem 3rem; align-items:flex-end; }
    .cookbook-showcase__seal { top:1.5rem; left:1.2rem; width:6.8rem; height:6.8rem; }
    .cookbook-showcase__seal span,.cookbook-showcase__seal strong { font-size:.42rem; }
    .cookbook-object { width:min(19rem,92%); padding:.6rem 1.2rem 1.2rem .6rem; transform:perspective(1000px) rotateY(2deg) rotateZ(-1deg); }
    .cookbook-feature__content { padding:4rem 1.4rem; }
    .cookbook-copy h2 { font-size:clamp(3.4rem,16vw,5rem); }
    .cookbook-lead { font-size:1rem; }
    .cookbook-pillars { gap:0; }
    .cookbook-pillar { min-height:auto; padding:1.2rem 0; }
    .cookbook-pillar + .cookbook-pillar { border-left:0; border-top:1px solid rgb(201 162 75 / .18); }
    .cookbook-action { flex-direction:column; }
    .cookbook-action :global(a) { width:100%; min-width:0; }
    .cookbook-value { min-height:0; padding:1.6rem 1rem; }
  }
</style>
