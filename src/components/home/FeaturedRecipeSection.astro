---
import type { CollectionEntry } from 'astro:content';
import EditorialImage from '../common/EditorialImage.astro';

type RecipeEntry = CollectionEntry<'recipes'>;
interface Props {
  recipe: RecipeEntry;
}
const { recipe } = Astro.props;
---

<section class="bm-featured-recipe" aria-labelledby="bm-featured-recipe-title">
  <div class="bm-featured-recipe__image">
    <EditorialImage
      id="journal-meal-preparation"
      fallbackArt="stew"
      ratio="4 / 3"
      alt="Rustic lentil stew with herbs and handmade vessels on a weathered table"
    />
    <div class="bm-featured-recipe__image-note" aria-hidden="true">A BiblicalMeal kitchen study</div>
  </div>
  <div class="bm-featured-recipe__copy">
    <p class="bm-eyebrow">From the kitchen</p>
    <p class="bm-featured-recipe__chapter">A dish for the ancient pantry, remade for today.</p>
    <h2 id="bm-featured-recipe-title">{recipe.data.title}</h2>
    <p class="bm-featured-recipe__sub">Inspired by the ancient table.</p>
    <p class="bm-featured-recipe__description">{recipe.data.description}</p>
    <p class="bm-featured-recipe__note">{recipe.data.inspiredNote}</p>
    <div class="bm-featured-recipe__meta">
      <span><b>{recipe.data.servings}</b> Serves</span>
      <span><b>{recipe.data.prepMinutes} min</b> Prep</span>
      <span><b>{recipe.data.cookMinutes} min</b> Cook</span>
    </div>
    <a class="bm-btn bm-btn--terracotta" href={`/recipes/${recipe.id}/`}>View the recipe <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .bm-featured-recipe {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    min-height: 680px;
    background: #111a0d;
    color: #f3ebdd;
  }
  .bm-featured-recipe__image {
    position: relative;
    min-width: 0;
    min-height: 680px;
    overflow: hidden;
  }
  .bm-featured-recipe__image :global(img) {
    width: 100%;
    height: 100%;
    min-height: 680px;
    object-fit: cover;
    filter: saturate(0.76) contrast(1.05) brightness(0.72);
  }
  .bm-featured-recipe__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(12, 18, 10, 0.02), rgba(12, 18, 10, 0.24));
    pointer-events: none;
  }
  .bm-featured-recipe__image-note {
    position: absolute;
    left: 28px;
    bottom: 26px;
    z-index: 2;
    padding-top: 10px;
    border-top: 1px solid rgba(199, 171, 114, 0.36);
    color: rgba(243, 235, 221, 0.72);
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .bm-featured-recipe__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 680px;
    padding: clamp(60px, 8vw, 118px);
  }
  .bm-featured-recipe__copy .bm-eyebrow {
    margin: 0 0 14px;
    color: #c7ab72;
  }
  .bm-featured-recipe__chapter {
    max-width: 420px;
    margin: 0 0 10px;
    color: rgba(243, 235, 221, 0.46);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bm-featured-recipe h2 {
    max-width: 560px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 6vw, 6.2rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .bm-featured-recipe__sub {
    margin: 12px 0 0;
    color: #c7ab72;
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
  }
  .bm-featured-recipe__description {
    max-width: 560px;
    margin: 26px 0 0;
    color: rgba(243, 235, 221, 0.72);
    font-size: 17px;
    line-height: 1.75;
  }
  .bm-featured-recipe__note {
    max-width: 560px;
    margin: 18px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(199, 171, 114, 0.2);
    color: rgba(243, 235, 221, 0.48);
    font-size: 13px;
    line-height: 1.65;
  }
  .bm-featured-recipe__meta {
    display: flex;
    max-width: 560px;
    margin: 30px 0 32px;
    border-block: 1px solid rgba(199, 171, 114, 0.2);
  }
  .bm-featured-recipe__meta span {
    flex: 1;
    padding: 16px 14px 16px 0;
    color: #9d9587;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bm-featured-recipe__meta span + span {
    padding-left: 14px;
    border-left: 1px solid rgba(199, 171, 114, 0.2);
  }
  .bm-featured-recipe__meta b {
    display: block;
    margin-bottom: 4px;
    color: #f3ebdd;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }
  .bm-btn--terracotta {
    width: fit-content;
    color: #fff3e1;
    background: #a84f2c;
  }
  .bm-btn--terracotta:hover {
    background: #8f4328;
  }
  @media (max-width: 800px) {
    .bm-featured-recipe {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .bm-featured-recipe__image,
    .bm-featured-recipe__image :global(img) {
      min-height: 360px;
    }
    .bm-featured-recipe__copy {
      padding: 58px 24px 72px;
    }
  }
