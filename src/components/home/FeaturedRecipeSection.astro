---
import type { CollectionEntry } from 'astro:content';
import EditorialImage from '../common/EditorialImage.astro';

type RecipeEntry = CollectionEntry<'recipes'>;
interface Props { recipe: RecipeEntry; }
const { recipe } = Astro.props;
---

<section class="bm-featured-recipe" aria-labelledby="bm-featured-recipe-title">
  <div class="bm-featured-recipe__image">
    <EditorialImage id="journal-meal-preparation" fallbackArt="stew" ratio="4 / 3" alt="Rustic lentil stew with herbs and handmade vessels on a weathered table" />
  </div>
  <div class="bm-featured-recipe__copy">
    <p class="bm-eyebrow">From the kitchen</p>
    <h2 id="bm-featured-recipe-title">{recipe.data.title}</h2>
    <p class="bm-featured-recipe__sub">Inspired by the ancient table.</p>
    <p>{recipe.data.description}</p>
    <p class="bm-featured-recipe__note">{recipe.data.inspiredNote}</p>
    <div class="bm-featured-recipe__meta">
      <span><b>{recipe.data.servings}</b> Serves</span>
      <span><b>{recipe.data.prepMinutes} min</b> Prep</span>
      <span><b>{recipe.data.cookMinutes} min</b> Cook</span>
    </div>
    <a class="bm-btn bm-btn--terracotta" href={`/recipes/${recipe.id}/`}>View the recipe <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .bm-featured-recipe { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; background: #111a0d; color: #f3ebdd; }
  .bm-featured-recipe__image { min-width: 0; overflow: hidden; }
  .bm-featured-recipe__image :global(img) { width: 100%; height: 100%; min-height: 640px; object-fit: cover; filter: saturate(.78) contrast(1.05) brightness(.72); }
  .bm-featured-recipe__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(48px, 8vw, 112px); }
  .bm-featured-recipe__copy .bm-eyebrow { margin: 0 0 12px; color: #c7ab72; }
  .bm-featured-recipe h2 { margin: 0; font-family: var(--font-display); font-size: clamp(3.5rem, 5vw, 5.2rem); font-weight: 400; line-height: .95; letter-spacing: -.04em; }
  .bm-featured-recipe__sub { margin: 8px 0 0; color: #c7ab72; font-family: var(--font-display); font-size: 20px; }
  .bm-featured-recipe__copy > p:not(.bm-eyebrow):not(.bm-featured-recipe__sub):not(.bm-featured-recipe__note) { max-width: 530px; margin: 24px 0 0; color: rgba(243,235,221,.72); font-size: 17px; line-height: 1.75; }
  .bm-featured-recipe__note { margin: 18px 0 0; padding-top: 18px; border-top: 1px solid rgba(199,171,114,.2); max-width: 520px; color: rgba(243,235,221,.48); font-size: 13px; line-height: 1.65; }
  .bm-featured-recipe__meta { display: flex; gap: 0; margin: 28px 0 30px; max-width: 520px; border-block: 1px solid rgba(199,171,114,.2); }
  .bm-featured-recipe__meta span { flex: 1; padding: 15px 14px 15px 0; color: #9d9587; font-family: var(--font-sans); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .bm-featured-recipe__meta span + span { padding-left: 14px; border-left: 1px solid rgba(199,171,114,.2); }
  .bm-featured-recipe__meta b { display: block; margin-bottom: 4px; color: #f3ebdd; font-family: var(--font-display); font-size: 18px; font-weight: 400; letter-spacing: 0; text-transform: none; }
  .bm-btn--terracotta { width: fit-content; color: #fff3e1; background: #a84f2c; }
  .bm-btn--terracotta:hover { background: #8f4328; }
  @media (max-width: 800px) { .bm-featured-recipe { grid-template-columns: 1fr; min-height: auto; } .bm-featured-recipe__image :global(img) { min-height: 340px; } .bm-featured-recipe__copy { padding: 58px 24px 68px; } }
</style>
