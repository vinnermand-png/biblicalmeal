---
import NewsletterForm from '../islands/NewsletterForm.tsx';
---

<section class="newsletter-world relative isolate overflow-hidden border-t border-line" id="newsletter">
  <div class="newsletter-world__olive" aria-hidden="true"></div>
  <div class="relative container-site section-space-compact">
    <div class="newsletter-world__panel reveal mx-auto max-w-5xl px-2 py-4 sm:px-8 sm:py-8">
      <div class="grid items-center gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-14">
        <div class="space-y-4 text-center lg:text-left">
          <p class="text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">
            The BiblicalMeal Letter
          </p>
          <h2 class="font-display text-h2 text-ink">
            Stay inspired<span class="text-terracotta">.</span>
          </h2>
          <p class="max-w-md text-body text-ink-muted lg:mx-0">
            Get recipes, stories, and updates from the ancient table.
          </p>
        </div>
        <div class="border-t border-line pt-7 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
          <NewsletterForm client:visible />
          <p class="mt-4 text-caption text-ink-muted/70">No noise, unsubscribe anytime.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-world {
    background: linear-gradient(120deg, var(--color-background), var(--color-background-alt));
    contain: paint;
  }
  .newsletter-world__olive {
    position: absolute;
    width: 24rem;
    height: 24rem;
    left: -16rem;
    bottom: -17rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(92 107 60 / 0.1), transparent 68%);
    pointer-events: none;
  }
  .newsletter-world__panel {
    position: relative;
  }
</style>
