---
import NewsletterForm from '../islands/NewsletterForm.tsx';
---

<section class="newsletter-world relative isolate overflow-hidden border-t border-line" id="newsletter">
  <div class="newsletter-world__olive" aria-hidden="true"></div>
  <div class="newsletter-world__line" aria-hidden="true"></div>
  <div class="relative container-site section-space-compact">
    <div class="newsletter-world__panel reveal mx-auto max-w-6xl px-2 py-5 sm:px-8 sm:py-10">
      <div class="grid items-center gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
        <div class="space-y-4 text-center lg:text-left">
          <p class="flex items-center justify-center gap-3 text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase lg:justify-start"><span class="hidden h-px w-8 bg-terracotta/65 lg:block"></span>The BiblicalMeal Letter</p>
          <h2 class="font-display text-h2 text-ink">Bring the ancient table<br class="hidden sm:block" /> into your kitchen<span class="text-terracotta">.</span></h2>
          <p class="max-w-md text-body text-ink-muted lg:mx-0">New recipes, ingredient stories, and notes from the world behind the text.</p>
        </div>
        <div class="border-t border-line pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
          <NewsletterForm client:visible />
          <p class="mt-4 text-caption text-ink-muted/70">No noise, unsubscribe anytime.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-world { background: linear-gradient(120deg, var(--color-background), var(--color-background-alt)); contain: paint; }
  .newsletter-world__olive { position: absolute; width: 30rem; height: 30rem; left: -20rem; bottom: -23rem; border-radius: 50%; background: radial-gradient(circle, rgb(92 107 60 / 0.1), transparent 68%); pointer-events: none; }
  .newsletter-world__line { position: absolute; inset: 50% auto auto 0; width: 12rem; height: 1px; background: linear-gradient(90deg, transparent, rgb(163 83 47 / 0.22)); pointer-events: none; }
  .newsletter-world__panel { position: relative; }
</style>
