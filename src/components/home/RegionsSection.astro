---
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="bm-regions" aria-labelledby="bm-regions-title">
  <div class="container-site">
    <div class="bm-regions__intro">
      <div>
        <p class="bm-eyebrow">Explore the Biblical World</p>
        <h2 id="bm-regions-title">The table is shaped by place.</h2>
      </div>
      <p>Food belongs to landscapes, seasons, waterways, trade routes, and the people who made a home there.</p>
    </div>
    <div class="bm-regions__grid">
      <a class="bm-region" href="/articles/" aria-label="Explore Ancient Israel">
        <EditorialImage fallbackArt="israel" ratio="3 / 2" alt="Terraced hills and stone settlements representing ancient Israel" />
        <div class="bm-region__shade"></div>
        <div class="bm-region__copy">
          <span class="bm-region__index">01 · LANDSCAPE</span>
          <h3>Ancient Israel</h3>
          <p>Hills, harvests, orchards, and everyday tables.</p>
          <b>Explore chapter <span aria-hidden="true">→</span></b>
        </div>
      </a>
      <a class="bm-region" href="/articles/" aria-label="Explore Galilee">
        <EditorialImage fallbackArt="galilee" ratio="3 / 2" alt="The Sea of Galilee framed by quiet hills" />
        <div class="bm-region__shade"></div>
        <div class="bm-region__copy">
          <span class="bm-region__index">02 · WATER</span>
          <h3>Galilee</h3>
          <p>Lake country, fishing villages, fertile plains, and fresh water.</p>
          <b>Explore chapter <span aria-hidden="true">→</span></b>
        </div>
      </a>
      <a class="bm-region" href="/articles/" aria-label="Explore Judea">
        <EditorialImage fallbackArt="judea" ratio="3 / 2" alt="Terraced Judean hills and dry agricultural fields" />
        <div class="bm-region__shade"></div>
        <div class="bm-region__copy">
          <span class="bm-region__index">03 · HIGHLANDS</span>
          <h3>Judea</h3>
          <p>Stone terraces, dry hills, vineyards, and rural food culture.</p>
          <b>Explore chapter <span aria-hidden="true">→</span></b>
        </div>
      </a>
      <a class="bm-region" href="/articles/" aria-label="Explore the Mediterranean world">
        <EditorialImage id="journal-mediterranean-landscape" fallbackArt="mediterranean" ratio="3 / 2" alt="Warm Mediterranean agricultural landscape" />
        <div class="bm-region__shade"></div>
        <div class="bm-region__copy">
          <span class="bm-region__index">04 · CROSSROADS</span>
          <h3>The Mediterranean</h3>
          <p>Coastlines, olive culture, climates, ingredients, and ancient trade.</p>
          <b>Explore chapter <span aria-hidden="true">→</span></b>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .bm-regions { padding-block: 106px; background: #f3eee4; color: #24201a; }
  .bm-regions__intro { display: flex; align-items: end; justify-content: space-between; gap: 36px; margin-bottom: 40px; }
  .bm-regions__intro .bm-eyebrow { margin: 0 0 10px; color: #8f7b54; }
  .bm-regions__intro h2 { max-width: 700px; margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 4.8vw, 4.8rem); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  .bm-regions__intro > p { max-width: 390px; margin: 0; color: #71685b; font-size: 16px; line-height: 1.75; }
  .bm-regions__grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; }
  .bm-region { position: relative; min-width: 0; height: 300px; overflow: hidden; border: 1px solid rgba(91,72,46,.14); background: #2b2a22; }
  .bm-region :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.76) contrast(1.04) brightness(.78); transition: transform 700ms ease; }
  .bm-region:hover :global(img) { transform: scale(1.03); }
  .bm-region__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9,13,7,.02) 28%, rgba(9,13,7,.84) 100%); }
  .bm-region__copy { position: absolute; right: 20px; bottom: 20px; left: 20px; color: #f3ebdd; }
  .bm-region__index { color: #c7ab72; font-family: var(--font-sans); font-size: 10px; font-weight: 700; letter-spacing: .15em; }
  .bm-region__copy h3 { margin: 8px 0 6px; font-family: var(--font-display); font-size: 29px; font-weight: 400; line-height: 1; }
  .bm-region__copy p { margin: 0; color: rgba(243,235,221,.74); font-size: 14px; line-height: 1.55; }
  .bm-region__copy b { display: inline-flex; gap: 9px; margin-top: 12px; color: #c7ab72; font-family: var(--font-sans); font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  @media (max-width: 900px) { .bm-regions { padding-block: 84px; } .bm-regions__intro { display: block; } .bm-regions__intro > p { margin-top: 16px; } .bm-regions__grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .bm-region { height: 280px; } }
  @media (max-width: 620px) { .bm-regions { padding-block: 70px; } .bm-regions__grid { display:flex; overflow-x:auto; gap:12px; margin-right:-20px; padding-right:20px; padding-bottom:8px; scroll-snap-type:x mandatory; } .bm-region { flex:0 0 82vw; height:300px; scroll-snap-align:start; } }
</style>
