---
import Button from '../common/Button.astro';
import FoodIllustration from '../common/FoodIllustration.astro';
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-40 -right-40 h-[34rem] w-[34rem] rounded-full"
    style="background: radial-gradient(closest-side, rgba(169, 80, 45, 0.09), transparent);"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-52 -left-40 h-[30rem] w-[30rem] rounded-full"
    style="background: radial-gradient(closest-side, rgba(92, 107, 60, 0.08), transparent);"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative container-site grid items-center gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-16 lg:py-28"
  >
    <div class="space-y-8 lg:col-span-6">
      <p
        class="reveal flex items-center gap-3 text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase"
      >
        <span class="h-px w-8 bg-terracotta" aria-hidden="true"></span>
        Food · History · Scripture
      </p>
      <h1
        class="reveal font-display text-display text-ink"
        style="--reveal-delay: 80ms"
      >
        Discover the Foods of the Bible<span class="text-terracotta">.</span>
      </h1>
      <p
        class="reveal max-w-xl text-body-lg text-ink-muted"
        style="--reveal-delay: 160ms"
      >
        BiblicalMeal explores the ingredients, meals, and culinary traditions of
        the biblical world — and brings them to your modern table with recipes
        inspired by Scripture.
      </p>
      <div class="reveal flex flex-wrap gap-4" style="--reveal-delay: 240ms">
        <Button href="/ingredients/" size="lg">Explore Biblical Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg"
          >Explore Recipes</Button
        >
      </div>
      <p
        class="reveal text-caption text-ink-muted/80"
        style="--reveal-delay: 320ms"
      >
        A food publication rooted in history — written for your kitchen.
      </p>
    </div>

    <div
      class="group reveal relative lg:col-span-6"
      style="--reveal-delay: 200ms"
    >
      <div
        class="absolute -inset-3 -rotate-1 rounded-2xl border border-line bg-surface"
        aria-hidden="true"
      >
      </div>
      <FoodIllustration
        kind="still-life"
        class="relative aspect-[4/3] rounded-xl shadow-lg sm:aspect-[4/5]"
      />
      <p class="mt-3 text-right text-caption text-ink-muted/70">
        Original illustration for BiblicalMeal
      </p>
    </div>
  </div>
</section>
