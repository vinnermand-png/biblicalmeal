---
import Button from '../common/Button.astro';
import FoodIllustration from '../common/FoodIllustration.astro';
---

<section class="hero-home relative isolate overflow-hidden">
  <div class="hero-home__wash hero-home__wash--terracotta" aria-hidden="true"></div>
  <div class="hero-home__wash hero-home__wash--olive" aria-hidden="true"></div>
  <div class="hero-home__grain" aria-hidden="true"></div>

  <div class="relative container-site grid items-center gap-14 py-16 sm:py-20 md:py-24 lg:min-h-[46rem] lg:grid-cols-12 lg:gap-12 lg:py-28">
    <div class="relative z-10 space-y-8 lg:col-span-6 lg:space-y-9">
      <p class="reveal flex items-center gap-3 text-eyebrow font-semibold tracking-eyebrow text-olive-dark uppercase">
        <span class="h-px w-10 bg-terracotta" aria-hidden="true"></span>
        Food · History · Scripture
      </p>
      <div class="space-y-6">
        <h1 class="reveal max-w-3xl font-display text-display text-ink" style="--reveal-delay: 80ms">
          Discover the Foods of the Bible<span class="text-terracotta">.</span>
        </h1>
        <p class="reveal max-w-xl text-body-lg text-ink-muted" style="--reveal-delay: 160ms">
          BiblicalMeal explores the ingredients, meals, and culinary traditions of
          the biblical world — and brings them to your modern table with recipes
          inspired by Scripture.
        </p>
      </div>
      <div class="reveal flex flex-wrap gap-4" style="--reveal-delay: 240ms">
        <Button href="/ingredients/" size="lg">Explore Biblical Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg">Explore Recipes</Button>
      </div>
      <div class="reveal flex items-center gap-3 text-caption text-ink-muted/80" style="--reveal-delay: 320ms">
        <span class="h-px w-8 bg-line" aria-hidden="true"></span>
        <p>A food publication rooted in history — written for your kitchen.</p>
      </div>
    </div>

    <div class="reveal relative lg:col-span-6" style="--reveal-delay: 200ms">
      <div class="hero-art relative mx-auto max-w-2xl">
        <div class="hero-art__offset" aria-hidden="true"></div>
        <div class="hero-art__halo" aria-hidden="true"></div>
        <FoodIllustration kind="still-life" class="hero-art__image relative aspect-[4/3] sm:aspect-[5/6] lg:aspect-[4/5]" />
        <div class="hero-art__label hidden sm:flex" aria-hidden="true">
          <span>Ancient ingredients</span>
          <span class="h-1 w-1 rounded-full bg-gold"></span>
          <span>Modern table</span>
        </div>
      </div>
      <p class="mt-4 text-right text-caption tracking-wide text-ink-muted/60">Original illustration for BiblicalMeal</p>
    </div>
  </div>
</section>

<style>
  .hero-home {
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--color-background) 88%, white) 0%, var(--color-background) 54%, color-mix(in srgb, var(--color-background-alt) 52%, var(--color-background)) 100%);
    contain: paint;
  }
  .hero-home__wash { position:absolute; pointer-events:none; border-radius:999px; }
  .hero-home__wash--terracotta { top:-13rem; right:-12rem; width:34rem; height:34rem; background:radial-gradient(circle, rgb(169 80 45 / .13) 0 24%, rgb(169 80 45 / .06) 44%, transparent 68%); }
  .hero-home__wash--olive { bottom:-17rem; left:-15rem; width:36rem; height:36rem; background:radial-gradient(circle, rgb(92 107 60 / .11) 0 22%, rgb(92 107 60 / .05) 42%, transparent 68%); }
  .hero-home__grain { position:absolute; inset:0; opacity:.16; background-image:radial-gradient(rgb(41 32 24 / .13) .45px, transparent .6px); background-size:9px 9px; pointer-events:none; }
  .hero-art { isolation:isolate; }
  .hero-art__offset { position:absolute; z-index:-1; inset:1rem -1rem -1rem 1rem; border:1px solid var(--color-line); border-radius:1.15rem; background:var(--color-surface); transform:rotate(-2.5deg); }
  .hero-art__halo { position:absolute; z-index:-2; inset:10% -8%; border-radius:50%; background:radial-gradient(circle, rgb(201 162 75 / .14), transparent 68%); }
  .hero-art__image { overflow:hidden; border:1px solid var(--color-line); border-radius:1rem; box-shadow:0 22px 50px rgb(41 32 24 / .11); background:var(--color-surface); }
  .hero-art__label { position:absolute; right:-1.25rem; bottom:1.5rem; align-items:center; gap:.65rem; border:1px solid rgb(255 252 245 / .2); border-radius:999px; background:rgb(65 77 43 / .94); padding:.7rem 1rem; color:var(--color-cream); font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; box-shadow:0 12px 30px rgb(41 32 24 / .16); }
  @media (max-width: 640px) { .hero-art__offset { inset:.65rem -.45rem -.65rem .45rem; } }
  @media (prefers-reduced-motion:no-preference) { .hero-art { transition:transform var(--bm-motion-editorial) ease; } .hero-art:hover { transform:translateY(-3px); } }
</style>
