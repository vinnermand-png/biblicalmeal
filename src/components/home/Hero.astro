---
import Button from '../common/Button.astro';
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="hero-home relative isolate overflow-hidden">
  <div class="hero-home__image-bg" aria-hidden="true">
    <EditorialImage
      id="journal-ancient-table"
      fallbackArt="still-life"
      ratio="16 / 9"
      decorative
      loading="eager"
    />
  </div>
  <div class="hero-home__grain" aria-hidden="true"></div>

  <div class="relative z-10 container-site grid items-end gap-10 py-10 sm:py-14 lg:min-h-[48rem] lg:grid-cols-12 lg:gap-12 lg:py-16">
    <div class="hero-home__copy lg:col-span-6">
      <p class="reveal flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-cream/82 uppercase">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
        Food · History · Scripture
      </p>
      <h1 class="reveal mt-5 max-w-3xl font-display text-display text-cream" style="--reveal-delay:80ms">
        Discover the Foods of the Bible<span class="text-gold">.</span>
      </h1>
      <p class="reveal mt-6 max-w-xl text-body-lg text-cream/84" style="--reveal-delay:160ms">
        Real food. Real history. Real sources. Explore the ingredients, meals, and stories of the biblical world — brought thoughtfully to the modern table.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--reveal-delay:240ms">
        <Button href="/ingredients/" size="lg">Explore Biblical Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg">Browse Recipes</Button>
      </div>
      <p class="reveal mt-5 max-w-md font-sans text-caption tracking-wide text-cream/68" style="--reveal-delay:320ms">
        Scripture-led research, historical context, and recipes for a modern kitchen.
      </p>
    </div>

    <div class="hero-home__side relative lg:col-span-6">
      <div class="hero-home__note">
        <p class="font-display text-h3 italic text-cream">“Man does not live by bread alone…”</p>
        <p class="mt-2 font-sans text-caption tracking-wide text-cream/72">Matthew 4:4</p>
      </div>
      <div class="hero-home__caption" aria-hidden="true">
        <span>Ancient table</span><span class="h-1 w-1 rounded-full bg-gold"></span><span>Modern kitchen</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home {
    min-height: 48rem;
    background: #3b342c;
  }
  .hero-home__image-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-home__image-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.78) contrast(1.02);
  }
  .hero-home::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(32 28 24 / 0.8) 0%, rgb(32 28 24 / 0.63) 36%, rgb(32 28 24 / 0.2) 70%, rgb(32 28 24 / 0.42) 100%),
      linear-gradient(180deg, rgb(32 28 24 / 0.1), rgb(32 28 24 / 0.38));
    pointer-events: none;
  }
  .hero-home__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.1;
    background-image: radial-gradient(rgb(255 252 245 / 0.55) 0.4px, transparent 0.6px);
    background-size: 8px 8px;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .hero-home__copy,
  .hero-home__side {
    position: relative;
    z-index: 3;
  }
  .hero-home__note {
    max-width: 21rem;
    margin-left: auto;
    padding: 1.35rem 1.4rem 1.15rem;
    border: 1px solid rgb(255 252 245 / 0.18);
    border-radius: 0.9rem;
    background: rgb(41 32 24 / 0.38);
    backdrop-filter: blur(10px);
  }
  .hero-home__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 999px;
    background: rgb(41 32 24 / 0.68);
    padding: 0.65rem 0.95rem;
    color: var(--color-cream);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .hero-home {
      min-height: 42rem;
    }
    .hero-home::after {
      background: linear-gradient(180deg, rgb(32 28 24 / 0.56) 0%, rgb(32 28 24 / 0.45) 40%, rgb(32 28 24 / 0.76) 100%);
    }
    .hero-home__image-bg :global(img) {
      object-position: 58% center;
    }
    .hero-home__note {
      margin-top: 2rem;
      margin-right: auto;
    }
    .hero-home__caption {
      position: static;
      margin-top: 0.75rem;
    }
  }
</style>
