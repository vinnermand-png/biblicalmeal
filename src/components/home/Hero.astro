---
import Button from '../common/Button.astro';
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="hero-home relative isolate overflow-hidden">
  <div class="hero-home__image-bg" aria-hidden="true">
    <EditorialImage
      id="journal-ancient-table"
      fallbackArt="still-life"
      ratio="16 / 9"
      decorative
      loading="eager"
    />
  </div>
  <div class="hero-home__grain" aria-hidden="true"></div>

  <div
    class="relative z-10 container-site grid min-h-[46rem] items-center gap-10 py-16 sm:py-20 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-12 lg:gap-12 lg:py-20 xl:gap-20"
  >
    <div class="hero-home__copy lg:col-span-6 xl:col-span-5">
      <p class="hero-home__eyebrow reveal">
        <span aria-hidden="true"></span>
        The Ancient Table
      </p>
      <h1 class="hero-home__title reveal" style="--reveal-delay:80ms">
        Discover <span>the Foods</span> <span>of the Bible<span class="text-terracotta">.</span></span>
      </h1>
      <div class="hero-home__rule" aria-hidden="true"></div>
      <p class="hero-home__intro reveal" style="--reveal-delay:160ms">
        Food holds real history. Real cultures. Real stories. Explore the
        ingredients, meals, and traditions of the biblical world — brought
        thoughtfully to the modern table.
      </p>
      <div class="hero-home__actions reveal" style="--reveal-delay:240ms">
        <Button href="/ingredients/" size="lg">Explore the Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg">Browse Recipes</Button>
      </div>
      <p class="hero-home__caption reveal" style="--reveal-delay:320ms">
        Rooted in Scripture. Inspired by history. Made for today.
      </p>
    </div>

    <div class="hero-home__side relative lg:col-span-6 xl:col-span-7">
      <div class="hero-home__note">
        <p class="font-display text-h3 italic leading-tight text-cream">
          “Man does not live by bread alone…”
        </p>
        <p class="mt-4 font-sans text-caption font-semibold tracking-wide text-gold/90 uppercase">
          Matthew 4:4 <span class="ml-3 text-cream/45">→</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home { min-height: 46rem; background: #e8decb; }
  .hero-home__image-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-home__image-bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 58% center; filter: saturate(0.9) contrast(1.02) sepia(0.05); }
  .hero-home::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(250 246 237 / 0.98) 0%, rgb(250 246 237 / 0.92) 31%, rgb(250 246 237 / 0.48) 53%, rgb(41 32 24 / 0.05) 100%), linear-gradient(180deg, rgb(255 252 245 / 0.18), rgb(41 32 24 / 0.08)); pointer-events: none; }
  .hero-home__grain { position: absolute; inset: 0; z-index: 2; opacity: 0.06; background-image: radial-gradient(rgb(41 32 24 / 0.18) 0.4px, transparent 0.6px); background-size: 8px 8px; mix-blend-mode: multiply; pointer-events: none; }
  .hero-home__copy, .hero-home__side { position: relative; z-index: 3; }
  .hero-home__eyebrow { display:flex; align-items:center; gap:.75rem; font-family:var(--font-sans); font-size:var(--text-eyebrow); font-weight:600; letter-spacing:var(--tracking-eyebrow); text-transform:uppercase; color:var(--color-terracotta-dark); }
  .hero-home__eyebrow span { width:2.5rem; height:1px; background:var(--color-terracotta); }
  .hero-home__title { margin-top:1.25rem; max-width:8ch; font-family:var(--font-display); font-size:clamp(3.65rem,6.5vw,6.75rem); line-height:.9; letter-spacing:-.055em; color:var(--color-ink); }
  .hero-home__title > span { display:block; }
  .hero-home__rule { width:3rem; height:1px; margin-top:1.7rem; background:rgb(169 87 45 / .45); }
  .hero-home__intro { max-width:34rem; margin-top:1.25rem; font-size:clamp(1rem,.95rem + .18vw,1.18rem); line-height:1.65; color:var(--color-ink-muted); }
  .hero-home__actions { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2rem; }
  .hero-home__caption { max-width:28rem; margin-top:1.25rem; font-family:var(--font-sans); font-size:var(--text-caption); letter-spacing:var(--tracking-wide); color:rgb(86 77 65 / .75); }
  .hero-home__note { max-width:20rem; margin-left:auto; margin-top:14rem; padding:1.5rem 1.6rem 1.35rem; border:1px solid rgb(255 252 245 / .13); border-radius:.35rem; background:rgb(38 46 24 / .88); box-shadow:0 22px 55px rgb(41 32 24 / .18); }
  @media (max-width: 767px) { .hero-home { min-height:43rem; } .hero-home::after { background:linear-gradient(180deg,rgb(250 246 237 / .94) 0%,rgb(250 246 237 / .67) 44%,rgb(41 32 24 / .35) 100%); } .hero-home__image-bg :global(img) { object-position:64% center; } .hero-home__copy { max-width:30rem; } .hero-home__title { max-width:10ch; font-size:clamp(3rem,13vw,4.7rem); } .hero-home__note { margin-top:5rem; margin-right:auto; } }
</style>
