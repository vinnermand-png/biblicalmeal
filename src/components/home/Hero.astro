---
import Button from '../common/Button.astro';
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="hero-home relative isolate overflow-hidden">
  <div class="hero-home__image-bg" aria-hidden="true">
    <EditorialImage
      id="journal-ancient-table"
      fallbackArt="still-life"
      ratio="16 / 9"
      decorative
      loading="eager"
    />
  </div>
  <div class="hero-home__grain" aria-hidden="true"></div>

  <div class="relative z-10 container-site grid min-h-[44rem] items-center gap-10 py-20 sm:py-24 lg:min-h-[calc(100vh-2rem)] lg:grid-cols-12 lg:gap-16 lg:py-24">
    <div class="hero-home__copy lg:col-span-6 xl:col-span-5">
      <p class="reveal flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">
        <span class="h-px w-10 bg-terracotta" aria-hidden="true"></span>
        The Ancient Table
      </p>
      <h1 class="reveal mt-5 font-display text-display text-ink" style="--reveal-delay:80ms">
        Discover the Foods of the Bible<span class="text-terracotta">.</span>
      </h1>
      <p class="reveal mt-6 max-w-xl text-body-lg text-ink-muted" style="--reveal-delay:160ms">
        Food holds real history, real cultures, and real stories. Explore the ingredients, meals, and traditions of the biblical world — brought thoughtfully to the modern table.
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--reveal-delay:240ms">
        <Button href="/ingredients/" size="lg">Explore the Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg">Browse Recipes</Button>
      </div>
      <p class="reveal mt-5 max-w-md font-sans text-caption tracking-wide text-ink-muted/75" style="--reveal-delay:320ms">
        Rooted in Scripture. Inspired by history. Made for today.
      </p>
    </div>

    <div class="hero-home__side relative lg:col-span-6 xl:col-span-7">
      <div class="hero-home__note">
        <p class="font-display text-h3 italic text-cream">“Man does not live by bread alone…”</p>
        <p class="mt-2 font-sans text-caption tracking-wide text-cream/72">Matthew 4:4</p>
      </div>
      <div class="hero-home__caption" aria-hidden="true">
        <span>Ancient table</span><span class="h-1 w-1 rounded-full bg-gold"></span><span>Modern kitchen</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home {
    min-height: 44rem;
    background: #e8decb;
  }
  .hero-home__image-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-home__image-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 56% center;
    filter: saturate(0.86) contrast(1.01);
  }
  .hero-home::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(248 242 231 / 0.96) 0%, rgb(248 242 231 / 0.82) 35%, rgb(248 242 231 / 0.26) 60%, rgb(41 32 24 / 0.08) 100%),
      linear-gradient(180deg, rgb(255 252 245 / 0.14), rgb(41 32 24 / 0.1));
    pointer-events: none;
  }
  .hero-home__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.08;
    background-image: radial-gradient(rgb(41 32 24 / 0.18) 0.4px, transparent 0.6px);
    background-size: 8px 8px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .hero-home__copy,
  .hero-home__side {
    position: relative;
    z-index: 3;
  }
  .hero-home__note {
    max-width: 21rem;
    margin-left: auto;
    margin-top: 16rem;
    padding: 1.35rem 1.4rem 1.15rem;
    border: 1px solid rgb(255 252 245 / 0.16);
    border-radius: 0.55rem;
    background: rgb(38 46 24 / 0.82);
    box-shadow: 0 18px 45px rgb(41 32 24 / 0.16);
  }
  .hero-home__caption {
    position: absolute;
    right: 0;
    bottom: -3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid rgb(41 32 24 / 0.18);
    padding-bottom: 0.55rem;
    color: var(--color-ink-muted);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 767px) {
    .hero-home {
      min-height: 42rem;
    }
    .hero-home::after {
      background: linear-gradient(180deg, rgb(248 242 231 / 0.88) 0%, rgb(248 242 231 / 0.54) 38%, rgb(41 32 24 / 0.36) 100%);
    }
    .hero-home__image-bg :global(img) {
      object-position: 62% center;
    }
    .hero-home__copy {
      max-width: 30rem;
    }
    .hero-home__note {
      margin-top: 5rem;
      margin-right: auto;
    }
    .hero-home__caption {
      position: static;
      margin-top: 0.85rem;
    }
  }
</style>
