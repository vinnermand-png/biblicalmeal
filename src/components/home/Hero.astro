---
import Button from '../common/Button.astro';
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="hero-home relative isolate overflow-hidden">
  <div class="hero-home__image-bg" aria-hidden="true">
    <EditorialImage
      id="journal-ancient-table"
      fallbackArt="still-life"
      ratio="16 / 9"
      decorative
      loading="eager"
    />
  </div>
  <div class="hero-home__grain" aria-hidden="true"></div>

  <div
    class="relative z-10 container-site grid min-h-[46rem] items-center gap-10 py-16 sm:py-20 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-12 lg:gap-12 lg:py-20 xl:gap-20"
  >
    <div class="hero-home__copy lg:col-span-6 xl:col-span-5">
      <p
        class="reveal flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase"
      >
        <span class="h-px w-10 bg-terracotta" aria-hidden="true"></span>
        The Ancient Table
      </p>
      <h1
        class="reveal mt-5 max-w-[44rem] font-display text-display text-ink"
        style="--reveal-delay:80ms"
      >
        Discover the Foods of the Bible<span class="text-terracotta">.</span>
      </h1>
      <div class="mt-6 h-px w-12 bg-terracotta/45" aria-hidden="true"></div>
      <p
        class="reveal mt-5 max-w-lg text-body-lg leading-relaxed text-ink-muted"
        style="--reveal-delay:160ms"
      >
        Food holds real history. Real cultures. Real stories. Explore the
        ingredients, meals, and traditions of the biblical world — brought
        thoughtfully to the modern table.
      </p>
      <div
        class="reveal mt-8 flex flex-wrap gap-3"
        style="--reveal-delay:240ms"
      >
        <Button href="/ingredients/" size="lg">Explore the Foods</Button>
        <Button href="/recipes/" variant="secondary" size="lg"
          >Browse Recipes</Button
        >
      </div>
      <p
        class="reveal mt-5 max-w-md font-sans text-caption tracking-wide text-ink-muted/75"
        style="--reveal-delay:320ms"
      >
        Rooted in Scripture. Inspired by history. Made for today.
      </p>
    </div>

    <div class="hero-home__side relative lg:col-span-6 xl:col-span-7">
      <div class="hero-home__note">
        <p class="font-display text-h3 italic leading-tight text-cream">
          “Man does not live by bread alone…”
        </p>
        <p class="mt-4 font-sans text-caption font-semibold tracking-wide text-gold/90 uppercase">
          Matthew 4:4 <span class="ml-3 text-cream/45">→</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home {
    min-height: 46rem;
    background: #e8decb;
  }
  .hero-home__image-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-home__image-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    filter: saturate(0.9) contrast(1.02) sepia(0.05);
  }
  .hero-home::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(250 246 237 / 0.98) 0%, rgb(250 246 237 / 0.92) 31%, rgb(250 246 237 / 0.48) 53%, rgb(41 32 24 / 0.05) 100%),
      linear-gradient(180deg, rgb(255 252 245 / 0.18), rgb(41 32 24 / 0.08));
    pointer-events: none;
  }
  .hero-home__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.06;
    background-image: radial-gradient(rgb(41 32 24 / 0.18) 0.4px, transparent 0.6px);
    background-size: 8px 8px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .hero-home__copy,
  .hero-home__side {
    position: relative;
    z-index: 3;
  }
  .hero-home__note {
    max-width: 20rem;
    margin-left: auto;
    margin-top: 14rem;
    padding: 1.5rem 1.6rem 1.35rem;
    border: 1px solid rgb(255 252 245 / 0.13);
    border-radius: 0.35rem;
    background: rgb(38 46 24 / 0.88);
    box-shadow: 0 22px 55px rgb(41 32 24 / 0.18);
  }
  @media (max-width: 767px) {
    .hero-home {
      min-height: 43rem;
    }
    .hero-home::after {
      background: linear-gradient(180deg, rgb(250 246 237 / 0.94) 0%, rgb(250 246 237 / 0.67) 44%, rgb(41 32 24 / 0.35) 100%);
    }
    .hero-home__image-bg :global(img) {
      object-position: 64% center;
    }
    .hero-home__copy {
      max-width: 30rem;
    }
    .hero-home__note {
      margin-top: 5rem;
      margin-right: auto;
    }
  }
</style>
