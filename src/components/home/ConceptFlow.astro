---
import EditorialImage from '../common/EditorialImage.astro';

const steps = [
  {
    number: '01',
    title: 'Scripture',
    description:
      'We begin with the biblical text itself — read carefully and in context.',
  },
  {
    number: '02',
    title: 'History',
    description:
      'We study the culinary world behind the text: what was grown, traded, and cooked.',
  },
  {
    number: '03',
    title: 'Ingredient',
    description:
      'We trace each food to its roots — olives, barley, honey, figs, lentils.',
  },
  {
    number: '04',
    title: 'Recipe',
    description:
      'We bring it home: dishes inspired by the ancient table, made for your kitchen.',
  },
];
---

<section class="concept-flow relative overflow-hidden bg-background-alt" id="story">
  <div class="grid lg:min-h-[46rem] lg:grid-cols-2">
    <div class="concept-flow__copy flex items-center py-20 sm:py-24 lg:py-0">
      <div class="concept-flow__copy-inner w-full">
        <div class="max-w-[40rem]">
          <p class="reveal flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">
            <span class="h-px w-9 bg-terracotta/70" aria-hidden="true"></span>
            Our approach
          </p>
          <h2 class="reveal mt-5 font-display text-display-sm text-ink" style="--reveal-delay:80ms">
            From Scripture<br />to Table<span class="text-terracotta">.</span>
          </h2>
          <p class="reveal mt-7 max-w-[37rem] text-body-lg leading-relaxed text-ink-muted" style="--reveal-delay:120ms">
            Every meal begins with meaning — for the land, the people, and the
            world behind the text. We move through Scripture, history,
            ingredients, and practical cooking without collapsing them into one
            claim.
          </p>

          <ol class="concept-flow__steps mt-11 grid gap-x-7 gap-y-7 sm:grid-cols-2" aria-label="BiblicalMeal approach">
            {
              steps.map((step) => (
                <li class="reveal border-t border-line pt-5" style={`--reveal-delay:${160 + Number(step.number) * 30}ms`}>
                  <div class="grid grid-cols-[2.75rem_1fr] gap-3">
                    <span class="font-display text-h2 leading-none text-terracotta/65" aria-hidden="true">{step.number}</span>
                    <div>
                      <h3 class="font-display text-h3 leading-none text-ink">{step.title}</h3>
                      <p class="mt-2.5 text-body leading-relaxed text-ink-muted">{step.description}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>

          <a href="/editorial-method/" class="reveal mt-10 inline-flex items-center gap-3 font-sans text-caption font-semibold tracking-wide text-terracotta uppercase transition-transform hover:translate-x-1" style="--reveal-delay:320ms">
            Learn our approach <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="concept-flow__visual relative min-h-[38rem] overflow-hidden bg-olive-dark lg:min-h-full">
      <EditorialImage
        id="journal-meal-preparation"
        fallbackArt="still-life"
        ratio="4 / 3"
        alt="A warm editorial table scene with bread, herbs, and clay vessels"
        decorative
        loading="lazy"
      />
      <div class="concept-flow__shade" aria-hidden="true"></div>
      <div class="concept-flow__quote relative z-10 flex h-full min-h-[38rem] items-end p-7 sm:p-10 lg:min-h-full lg:p-12 xl:p-16">
        <div class="concept-flow__quote-card max-w-[35rem]">
          <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-gold uppercase">Where meals meet meaning</p>
          <div class="mt-4 h-px w-12 bg-gold/70" aria-hidden="true"></div>
          <blockquote class="mt-5 font-display text-h2 leading-[1.08] text-cream">
            “A land of wheat and barley, and vines, and fig trees, and
            pomegranates; a land of oil olive, and honey.”
          </blockquote>
          <cite class="mt-6 block font-sans text-caption font-semibold not-italic tracking-wide text-gold/85 uppercase">
            Deuteronomy 8:8
          </cite>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .concept-flow { contain: paint; border-block: 1px solid rgb(103 77 52 / 0.12); }
  .concept-flow__copy { background: linear-gradient(135deg, rgb(255 252 245 / 0.9), rgb(248 242 231 / 0.72)); }
  .concept-flow__copy-inner { padding: clamp(3rem, 6vw, 6.5rem); padding-right: clamp(3rem, 5vw, 5.5rem); }
  .concept-flow__steps li { min-height: 8.1rem; }
  .concept-flow__visual :global(.editorial-image),
  .concept-flow__visual :global(img) { width: 100%; height: 100%; }
  .concept-flow__visual :global(img) { object-fit: cover; object-position: center; filter: saturate(0.9) contrast(1.01) brightness(0.82); }
  .concept-flow__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(17 24 12 / 0.08) 10%, rgb(17 24 12 / 0.28) 48%, rgb(17 24 12 / 0.78) 100%), linear-gradient(90deg, rgb(17 24 12 / 0.24), transparent 68%); pointer-events: none; }
  .concept-flow__quote { position: absolute; inset: 0; }
  .concept-flow__quote-card { padding: 1.75rem 1.9rem 1.85rem; border: 1px solid rgb(255 248 232 / 0.14); background: linear-gradient(135deg, rgb(22 31 15 / 0.78), rgb(22 31 15 / 0.46)); backdrop-filter: blur(3px); box-shadow: 0 22px 60px rgb(0 0 0 / 0.16); }
  @media (max-width: 1023px) {
    .concept-flow__copy-inner { max-width: 52rem; margin-inline: auto; padding: clamp(2rem, 7vw, 4rem); }
  }
  @media (max-width: 639px) {
    .concept-flow__copy-inner { padding-inline: 1.5rem; }
    .concept-flow__steps li { min-height: 0; }
    .concept-flow__quote-card { padding: 1.4rem; }
  }
</style>
