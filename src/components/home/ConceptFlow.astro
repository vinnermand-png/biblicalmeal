---
import EditorialImage from '../common/EditorialImage.astro';

const steps = [
  {
    number: '01',
    title: 'Scripture',
    description:
      'We begin with the biblical text itself — read carefully and in context.',
  },
  {
    number: '02',
    title: 'History',
    description:
      'We study the culinary world behind the text: what was grown, traded, and cooked.',
  },
  {
    number: '03',
    title: 'Ingredient',
    description:
      'We trace each food to its roots — olives, barley, honey, figs, lentils.',
  },
  {
    number: '04',
    title: 'Recipe',
    description:
      'We bring it home: dishes inspired by the ancient table, made for your kitchen.',
  },
];
---

<section class="concept-flow relative overflow-hidden bg-background-alt" id="story">
  <div class="concept-flow__rule" aria-hidden="true"></div>
  <div class="grid lg:min-h-[48rem] lg:grid-cols-2">
    <div class="concept-flow__copy flex items-center py-20 sm:py-24 lg:py-28">
      <div class="container-site w-full lg:max-w-none lg:pr-[clamp(3rem,7vw,8rem)] xl:pl-[clamp(4rem,8vw,12rem)]">
        <div class="max-w-2xl">
          <p class="reveal flex items-center gap-3 font-sans text-eyebrow font-semibold tracking-eyebrow text-terracotta-dark uppercase">
            <span class="h-px w-9 bg-terracotta/70" aria-hidden="true"></span>
            Our approach
          </p>
          <h2 class="reveal mt-5 max-w-xl font-display text-display-sm text-ink" style="--reveal-delay:80ms">
            From Scripture<br />to Table<span class="text-terracotta">.</span>
          </h2>
          <p class="reveal mt-7 max-w-xl text-body-lg leading-relaxed text-ink-muted" style="--reveal-delay:120ms">
            Every meal begins with meaning — for the land, the people, and the
            world behind the text. We move through Scripture, history,
            ingredients, and practical cooking without collapsing them into one
            claim.
          </p>

          <ol class="concept-flow__steps mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2" aria-label="BiblicalMeal approach">
            {
              steps.map((step) => (
                <li class="reveal border-t border-line pt-5" style={`--reveal-delay:${160 + Number(step.number) * 30}ms`}>
                  <div class="flex items-start gap-4">
                    <span class="font-display text-h2 text-terracotta/70" aria-hidden="true">{step.number}</span>
                    <div>
                      <h3 class="font-display text-h3 text-ink">{step.title}</h3>
                      <p class="mt-2 text-body text-ink-muted">{step.description}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>

          <a href="/editorial-method/" class="reveal mt-11 inline-flex items-center gap-3 font-sans text-caption font-semibold tracking-wide text-terracotta uppercase transition-transform hover:translate-x-1" style="--reveal-delay:320ms">
            Learn our approach <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="concept-flow__visual relative min-h-[34rem] overflow-hidden bg-olive-dark lg:min-h-full">
      <EditorialImage
        id="journal-meal-preparation"
        fallbackArt="still-life"
        ratio="4 / 3"
        alt="A warm editorial table scene with bread, herbs, and clay vessels"
        decorative
        loading="lazy"
      />
      <div class="concept-flow__shade" aria-hidden="true"></div>
      <div class="concept-flow__quote relative z-10 flex h-full min-h-[34rem] items-end p-8 sm:p-12 lg:min-h-full lg:p-16 xl:p-20">
        <div class="max-w-[34rem]">
          <p class="font-sans text-eyebrow font-semibold tracking-eyebrow text-gold uppercase">Where meals meet meaning</p>
          <div class="mt-5 h-px w-12 bg-gold/70" aria-hidden="true"></div>
          <blockquote class="mt-6 font-display text-display-sm leading-[1.03] text-cream">
            “A land of wheat and barley, and vines, and fig trees, and
            pomegranates; a land of oil olive, and honey.”
          </blockquote>
          <cite class="mt-7 block font-sans text-caption font-semibold not-italic tracking-wide text-gold/85 uppercase">
            Deuteronomy 8:8
          </cite>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .concept-flow { contain: paint; }
  .concept-flow__rule { position: absolute; inset: 0 50% auto 0; height: 1px; background: rgb(103 77 52 / 0.12); }
  .concept-flow__copy { background: linear-gradient(135deg, rgb(255 252 245 / 0.7), transparent 62%); }
  .concept-flow__steps li { min-height: 7.5rem; }
  .concept-flow__visual :global(.editorial-image),
  .concept-flow__visual :global(img) { width: 100%; height: 100%; }
  .concept-flow__visual :global(img) { object-fit: cover; object-position: center; filter: saturate(0.84) contrast(1.02) brightness(0.9); }
  .concept-flow__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(24 32 16 / 0.22), rgb(24 32 16 / 0.68) 100%), linear-gradient(90deg, rgb(24 32 16 / 0.24), transparent 72%); pointer-events: none; }
  .concept-flow__quote { position: absolute; inset: 0; }
  @media (max-width: 1023px) { .concept-flow__copy { background: var(--color-background-alt); } .concept-flow__rule { inset: auto 0 0; } }
</style>
