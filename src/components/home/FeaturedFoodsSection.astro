---
import type { CollectionEntry } from 'astro:content';
import { INGREDIENT_ART, INGREDIENT_PREMIUM_IMAGE_IDS } from '../../lib/visuals';
import EditorialImage from '../common/EditorialImage.astro';

type IngredientEntry = CollectionEntry<'ingredients'>;
interface Props { items: IngredientEntry[]; }
const { items } = Astro.props;
---

<section class="bm-featured-foods" aria-labelledby="bm-featured-foods-title">
  <div class="container-site">
    <div class="bm-featured-foods__intro">
      <p class="bm-eyebrow">Featured foods</p>
      <h2 id="bm-featured-foods-title">Ingredients of the ancient table.</h2>
      <p>Collectible foods, explored through Scripture, history, evidence, and the ways they still reach the table today.</p>
    </div>

    <div class="bm-foods-grid">
      {items.map((entry, index) => {
        const premium = INGREDIENT_PREMIUM_IMAGE_IDS[entry.id];
        const art = entry.data.art ?? INGREDIENT_ART[entry.id] ?? 'still-life';
        const href = ['figs', 'dates'].includes(entry.id) ? `/foods/${entry.id}/` : `/ingredients/${entry.id}/`;
        return (
          <a class:list={['bm-food-panel', index === 0 ? 'bm-food-panel--feature' : '', index === 5 ? 'bm-food-panel--wide' : '']} href={href}>
            <EditorialImage id={premium} fallbackArt={art} ratio="4 / 3" alt={`${entry.data.name} ingredient portrait`} />
            <div class="bm-food-panel__shade"></div>
            <div class="bm-food-panel__copy">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{entry.data.name}</h3>
              <p>{entry.data.description}</p>
              <b>Explore <span aria-hidden="true">→</span></b>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .bm-featured-foods { padding-block: 118px; background: #14200f; color: #f3ebdd; }
  .bm-featured-foods__intro { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 32px; }
  .bm-featured-foods__intro .bm-eyebrow { margin: 0 0 8px; color: #c7ab72; }
  .bm-featured-foods__intro h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.7rem, 4.4vw, 4.2rem); font-weight: 400; line-height: 1; letter-spacing: -.04em; }
  .bm-featured-foods__intro > p { max-width: 350px; margin: 0; color: rgba(243,235,221,.58); font-size: 15px; line-height: 1.7; }
  .bm-foods-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: 330px 150px; gap: 12px; }
  .bm-food-panel { position: relative; min-width: 0; overflow: hidden; border: 1px solid rgba(199,171,114,.18); background: #28361f; }
  .bm-food-panel :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.78) contrast(1.03) brightness(.72); transition: transform 550ms ease; }
  .bm-food-panel:hover :global(img) { transform: scale(1.025); }
  .bm-food-panel--feature { grid-column: span 2; grid-row: span 2; }
  .bm-food-panel--wide { grid-column: span 2; }
  .bm-food-panel__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,15,8,.03), rgba(10,15,8,.72) 82%); }
  .bm-food-panel__copy { position: absolute; inset: auto 20px 20px; z-index: 2; }
  .bm-food-panel__copy > span { color: #c7ab72; font-family: var(--font-sans); font-size: 10px; font-weight: 700; letter-spacing: .18em; }
  .bm-food-panel h3 { margin: 6px 0 4px; font-family: var(--font-display); font-size: clamp(1.6rem, 2.2vw, 2.45rem); font-weight: 400; }
  .bm-food-panel p { max-width: 34rem; margin: 0; color: rgba(243,235,221,.72); font-size: 13px; line-height: 1.55; }
  .bm-food-panel b { display: inline-flex; gap: 10px; margin-top: 10px; color: #c7ab72; font-family: var(--font-sans); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  @media (max-width: 900px) { .bm-featured-foods { padding-block: 90px; } .bm-featured-foods__intro { display: block; } .bm-featured-foods__intro > p { margin-top: 14px; } .bm-foods-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(3, 180px); } .bm-food-panel--feature { grid-column: span 2; grid-row: span 1; } .bm-food-panel--wide { grid-column: span 2; } }
  @media (max-width: 620px) { .bm-featured-foods { padding-block: 72px; } .bm-foods-grid { grid-template-columns: 1fr; grid-template-rows: repeat(6, 200px); } .bm-food-panel--feature, .bm-food-panel--wide { grid-column: auto; grid-row: auto; } }
</style>
