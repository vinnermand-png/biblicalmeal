---
import type { CollectionEntry } from 'astro:content';
import { INGREDIENT_ART, INGREDIENT_PREMIUM_IMAGE_IDS } from '../../lib/visuals';
import EditorialImage from '../common/EditorialImage.astro';

type IngredientEntry = CollectionEntry<'ingredients'>;
interface Props { items: IngredientEntry[]; }
const { items } = Astro.props;
---

<section class="bm-featured-foods" aria-labelledby="bm-featured-foods-title">
  <div class="container-site">
    <div class="bm-featured-foods__intro">
      <div>
        <p class="bm-eyebrow">Featured foods</p>
        <h2 id="bm-featured-foods-title">A living archive of the ancient table.</h2>
      </div>
      <p>Collectible foods explored through Scripture, history, evidence, and the ways they still reach the table today.</p>
    </div>

    <div class="bm-foods-grid">
      {items.map((entry, index) => {
        const premium = INGREDIENT_PREMIUM_IMAGE_IDS[entry.id];
        const art = entry.data.art ?? INGREDIENT_ART[entry.id] ?? 'still-life';
        const href = ['figs', 'dates'].includes(entry.id) ? `/foods/${entry.id}/` : `/ingredients/${entry.id}/`;
        const isFeature = index === 0;
        const isWide = index === 5;
        return (
          <a
            class:list={[
              'bm-food-panel',
              {
                'bm-food-panel--feature': isFeature,
                'bm-food-panel--wide': isWide,
                'bm-food-panel--dates': entry.id === 'dates',
              },
            ]}
            href={href}
          >
            <EditorialImage
              id={premium}
              fallbackArt={art}
              ratio="4 / 3"
              alt={`${entry.data.name} ingredient portrait`}
              class="bm-food-panel__image"
            />
            <div class="bm-food-panel__shade"></div>
            <div class="bm-food-panel__copy">
              <span class="bm-food-panel__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="bm-food-panel__type">{isFeature ? 'Collected specimen' : isWide ? 'Archive entry' : 'Ancient table'}</span>
              <h3>{entry.data.name}</h3>
              {isFeature || isWide ? <p>{entry.data.description}</p> : null}
              <b>Explore ingredient <span aria-hidden="true">→</span></b>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .bm-featured-foods {
    padding-block: clamp(92px, 9vw, 132px);
    background: #14200f;
    color: #f3ebdd;
  }
  .bm-featured-foods__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem);
    align-items: end;
    gap: 48px;
    margin-bottom: 38px;
  }
  .bm-featured-foods__intro .bm-eyebrow { margin: 0 0 10px; color: #c7ab72; }
  .bm-featured-foods__intro h2 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.9vw, 4.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .bm-featured-foods__intro > p { margin: 0; color: rgba(243,235,221,0.62); font-size: 16px; line-height: 1.75; }
  .bm-foods-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(210px, 1fr)) 180px;
    gap: 14px;
  }
  .bm-food-panel {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(199,171,114,0.18);
    background: #28361f;
  }
  .bm-food-panel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.03) brightness(0.74);
    transition: transform 700ms ease;
  }
  .bm-food-panel:hover :global(img) { transform: scale(1.03); }
  .bm-food-panel--feature { grid-column: span 2; grid-row: span 2; }
  .bm-food-panel--wide { grid-column: 1 / -1; }
  .bm-food-panel__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10,15,8,0.02), rgba(10,15,8,0.8) 88%),
      linear-gradient(90deg, rgba(10,15,8,0.2), transparent 52%);
  }
  .bm-food-panel__copy { position: absolute; right: 22px; bottom: 22px; left: 22px; z-index: 2; }
  .bm-food-panel__index { color: #c7ab72; font-family: var(--font-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; }
  .bm-food-panel__type {
    margin-left: 12px;
    color: rgba(243,235,221,0.44);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .bm-food-panel h3 { max-width: 32rem; margin: 7px 0 6px; font-family: var(--font-display); font-size: clamp(1.8rem,2.8vw,3rem); font-weight: 400; line-height: 0.98; }
  .bm-food-panel--feature h3 { max-width: 36rem; font-size: clamp(2.8rem,4.6vw,4.6rem); }
  .bm-food-panel p { max-width: 38rem; margin: 0; color: rgba(243,235,221,0.72); font-size: 15px; line-height: 1.65; }
  .bm-food-panel b { display: inline-flex; gap: 10px; margin-top: 12px; color: #c7ab72; font-family: var(--font-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .bm-food-panel--wide .bm-food-panel__copy { display: grid; grid-template-columns: auto auto minmax(0,1fr) auto; align-items: end; gap: 18px; }
  .bm-food-panel--wide p { max-width: 32rem; }

  .bm-food-panel--dates { min-height: 330px; }
  .bm-food-panel--dates > .bm-food-panel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    z-index: 0;
  }
  .bm-food-panel--dates .bm-food-panel__image :global(img) {
    object-position: 65% center;
    filter: saturate(0.98) contrast(1.02) brightness(1.04);
  }
  .bm-food-panel--dates .bm-food-panel__shade {
    z-index: 1;
    background: linear-gradient(90deg, rgba(7,19,11,0.96) 0%, rgba(7,19,11,0.88) 28%, rgba(7,19,11,0.55) 52%, rgba(7,19,11,0.15) 75%, rgba(7,19,11,0.05) 100%);
  }
  .bm-food-panel--dates .bm-food-panel__copy {
    z-index: 2;
    display: block;
    width: min(40%, 34rem);
    max-width: 34rem;
    right: auto;
  }
  .bm-food-panel--dates .bm-food-panel__index { font-size: 12px; }
  .bm-food-panel--dates h3 { margin-top: 8px; font-size: clamp(2.5rem, 4.4vw, 4.4rem); }
  .bm-food-panel--dates p { max-width: 32rem; font-size: 16px; line-height: 1.55; }

  @media (max-width: 900px) {
    .bm-featured-foods__intro { grid-template-columns: 1fr; gap: 18px; }
    .bm-foods-grid { grid-template-rows: repeat(2,230px) 170px; }
    .bm-food-panel--feature { grid-column: span 2; grid-row: span 2; }
    .bm-food-panel--wide .bm-food-panel__copy { display: block; }
    .bm-food-panel--dates { min-height: 320px; }
    .bm-food-panel--dates .bm-food-panel__copy { width: 45%; }
  }
  @media (max-width: 620px) {
    .bm-featured-foods { padding-block: 76px; }
    .bm-foods-grid { grid-template-columns: 1fr; grid-template-rows: repeat(6,230px); }
    .bm-food-panel--feature,.bm-food-panel--wide { grid-column: auto; grid-row: auto; }
    .bm-food-panel--feature h3 { font-size: 2.55rem; }
    .bm-food-panel__copy { right:18px; bottom:18px; left:18px; }
    .bm-food-panel--wide .bm-food-panel__copy { display:block; }
    .bm-food-panel--dates { min-height: 300px; }
    .bm-food-panel--dates .bm-food-panel__image :global(img) { object-position: 65% center; }
    .bm-food-panel--dates .bm-food-panel__copy { width: 68%; max-width: none; }
    .bm-food-panel--dates h3 { font-size: 2.9rem; }
  }
</style>
