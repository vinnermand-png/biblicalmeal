---
import type { CollectionEntry } from 'astro:content';
import { INGREDIENT_ART, INGREDIENT_PREMIUM_IMAGE_IDS } from '../../lib/visuals';
import EditorialImage from '../common/EditorialImage.astro';

type IngredientEntry = CollectionEntry<'ingredients'>;
interface Props {
  items: IngredientEntry[];
}
const { items } = Astro.props;
---

<section class="bm-featured-foods" aria-labelledby="bm-featured-foods-title">
  <div class="container-site">
    <div class="bm-featured-foods__intro">
      <div>
        <p class="bm-eyebrow">Featured foods</p>
        <h2 id="bm-featured-foods-title">A living archive of the ancient table.</h2>
      </div>
      <p>Collectible foods explored through Scripture, history, evidence, and the ways they still reach the table today.</p>
    </div>

    <div class="bm-foods-grid">
      {items.map((entry, index) => {
        const premium = INGREDIENT_PREMIUM_IMAGE_IDS[entry.id];
        const art = entry.data.art ?? INGREDIENT_ART[entry.id] ?? 'still-life';
        const href = ['figs', 'dates'].includes(entry.id) ? `/foods/${entry.id}/` : `/ingredients/${entry.id}/`;
        const isFeature = index === 0;
        const isWide = index === 5;
        return (
          <a
            class:list={[
              'bm-food-panel',
              { 'bm-food-panel--feature': isFeature, 'bm-food-panel--wide': isWide },
            ]}
            href={href}
          >
            <EditorialImage
              id={premium}
              fallbackArt={art}
              ratio="4 / 3"
              alt={`${entry.data.name} ingredient portrait`}
            />
            <div class="bm-food-panel__shade"></div>
            <div class="bm-food-panel__copy">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{entry.data.name}</h3>
              <p>{entry.data.description}</p>
              <b>Explore ingredient <span aria-hidden="true">→</span></b>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .bm-featured-foods {
    padding-block: clamp(92px, 9vw, 132px);
    background: #14200f;
    color: #f3ebdd;
  }
  .bm-featured-foods__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem);
    align-items: end;
    gap: 48px;
    margin-bottom: 38px;
  }
  .bm-featured-foods__intro .bm-eyebrow {
    margin: 0 0 10px;
    color: #c7ab72;
  }
  .bm-featured-foods__intro h2 {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.9vw, 4.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .bm-featured-foods__intro > p {
    margin: 0;
    color: rgba(243, 235, 221, 0.62);
    font-size: 16px;
    line-height: 1.75;
  }
  .bm-foods-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(210px, 1fr)) 180px;
    gap: 14px;
  }
  .bm-food-panel {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(199, 171, 114, 0.18);
    background: #28361f;
  }
  .bm-food-panel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.03) brightness(0.74);
    transition: transform 700ms ease;
  }
  .bm-food-panel:hover :global(img) {
    transform: scale(1.03);
  }
  .bm-food-panel--feature {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bm-food-panel--wide {
    grid-column: 1 / -1;
  }
  .bm-food-panel__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 15, 8, 0.02), rgba(10, 15, 8, 0.78) 88%),
      linear-gradient(90deg, rgba(10, 15, 8, 0.18), transparent 52%);
  }
  .bm-food-panel__copy {
    position: absolute;
    right: 22px;
    bottom: 22px;
    left: 22px;
    z-index: 2;
  }
  .bm-food-panel__copy > span {
    color: #c7ab72;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .bm-food-panel h3 {
    max-width: 32rem;
    margin: 7px 0 6px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.8vw, 3rem);
    font-weight: 400;
    line-height: 0.98;
  }
  .bm-food-panel--feature h3 {
    font-size: clamp(2.6rem, 4vw, 4rem);
  }
  .bm-food-panel p {
    max-width: 38rem;
    margin: 0;
    color: rgba(243, 235, 221, 0.72);
    font-size: 14px;
    line-height: 1.6;
  }
  .bm-food-panel b {
    display: inline-flex;
    gap: 10px;
    margin-top: 12px;
    color: #c7ab72;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .bm-food-panel--wide .bm-food-panel__copy {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: 18px;
  }
  .bm-food-panel--wide p {
    max-width: 34rem;
  }
  @media (max-width: 900px) {
    .bm-featured-foods__intro {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .bm-foods-grid {
      grid-template-rows: repeat(2, 230px) 170px;
    }
    .bm-food-panel--feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bm-food-panel--wide .bm-food-panel__copy {
      display: block;
    }
  }
  @media (max-width: 620px) {
    .bm-featured-foods {
      padding-block: 76px;
    }
    .bm-foods-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(6, 230px);
    }
    .bm-food-panel--feature,
    .bm-food-panel--wide {
      grid-column: auto;
      grid-row: auto;
    }
    .bm-food-panel--feature h3 {
      font-size: 2.45rem;
    }
    .bm-food-panel__copy {
      right: 18px;
      bottom: 18px;
      left: 18px;
    }
  }
</style>
