---
import type { CollectionEntry } from 'astro:content';
import EditorialImage from '../common/EditorialImage.astro';

type ArticleEntry = CollectionEntry<'articles'>;
type RecipeEntry = CollectionEntry<'recipes'>;
interface Props {
  articles: ArticleEntry[];
  recipe: RecipeEntry;
}
const { articles, recipe } = Astro.props;
const featured = articles[0];
const secondary = articles[1];
---

<section class="bm-journal" aria-labelledby="bm-journal-title">
  <div class="container-site">
    <div class="bm-journal__intro">
      <div>
        <p class="bm-eyebrow">From the Journal</p>
        <h2 id="bm-journal-title">Stories, research, and inspiration.</h2>
      </div>
      <a href="/articles/">View all articles <span aria-hidden="true">→</span></a>
    </div>

    <div class="bm-journal__grid">
      {featured && (
        <a class="bm-journal-card bm-journal-card--feature" href={`/articles/${featured.id}/`}>
          <EditorialImage
            id={featured.data.art === 'mediterranean' ? 'journal-mediterranean-landscape' : featured.id === 'how-we-research' ? 'journal-research-manuscript' : 'journal-ancient-table'}
            fallbackArt={featured.data.art ?? 'still-life'}
            ratio="16 / 10"
            alt={featured.data.title}
          />
          <div class="bm-journal-card__shade"></div>
          <div class="bm-journal-card__copy">
            <span>{featured.data.category}</span>
            <h3>{featured.data.title}</h3>
            <p>{featured.data.excerpt}</p>
            <b>Read the story <span aria-hidden="true">→</span></b>
          </div>
        </a>
      )}

      {secondary && (
        <a class="bm-journal-card bm-journal-card--secondary" href={`/articles/${secondary.id}/`}>
          <EditorialImage
            id={secondary.id === 'how-we-research' ? 'journal-research-manuscript' : secondary.data.art === 'mediterranean' ? 'journal-mediterranean-landscape' : 'journal-ancient-table'}
            fallbackArt={secondary.data.art ?? 'still-life'}
            ratio="16 / 10"
            alt={secondary.data.title}
          />
          <div class="bm-journal-card__shade"></div>
          <div class="bm-journal-card__copy">
            <span>{secondary.data.category}</span>
            <h3>{secondary.data.title}</h3>
            <b>Read article <span aria-hidden="true">→</span></b>
          </div>
        </a>
      )}

      <a class="bm-journal-card bm-journal-card--secondary" href={`/recipes/${recipe.id}/`}>
        <EditorialImage
          id="journal-meal-preparation"
          fallbackArt="stew"
          ratio="16 / 10"
          alt="Lentil stew and ingredients prepared on a rustic table"
        />
        <div class="bm-journal-card__shade"></div>
        <div class="bm-journal-card__copy">
          <span>From the kitchen</span>
          <h3>{recipe.data.title}</h3>
          <b>Read recipe <span aria-hidden="true">→</span></b>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .bm-journal {
    padding-block: clamp(92px, 9vw, 124px);
    background: #efe7d8;
    color: #292018;
  }
  .bm-journal__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 38px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(91, 72, 46, 0.16);
  }
  .bm-journal__intro .bm-eyebrow {
    margin: 0 0 10px;
    color: #8f7b54;
  }
  .bm-journal__intro h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.8vw, 4.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .bm-journal__intro > a {
    flex: 0 0 auto;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(91, 72, 46, 0.36);
    color: #5b4c30;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .bm-journal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(220px, 1fr));
    gap: 16px;
  }
  .bm-journal-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(91, 72, 46, 0.15);
    background: #2a2119;
  }
  .bm-journal-card--feature {
    grid-row: 1 / -1;
  }
  .bm-journal-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.76) contrast(1.04) brightness(0.72);
    transition: transform 700ms ease;
  }
  .bm-journal-card:hover :global(img) {
    transform: scale(1.03);
  }
  .bm-journal-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 13, 7, 0.04), rgba(9, 13, 7, 0.9));
  }
  .bm-journal-card__copy {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 2;
    color: #f3ebdd;
  }
  .bm-journal-card__copy > span {
    color: #c7ab72;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bm-journal-card__copy h3 {
    max-width: 40rem;
    margin: 8px 0 10px;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.03;
  }
  .bm-journal-card--feature .bm-journal-card__copy h3 {
    max-width: 42rem;
    font-size: clamp(2.4rem, 4.1vw, 4.1rem);
  }
  .bm-journal-card__copy p {
    max-width: 38rem;
    margin: 0;
    color: rgba(243, 235, 221, 0.72);
    font-size: 15px;
    line-height: 1.65;
  }
  .bm-journal-card__copy b {
    display: inline-flex;
    gap: 9px;
    margin-top: 13px;
    color: #c7ab72;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 800px) {
    .bm-journal {
      padding-block: 82px;
    }
    .bm-journal__intro {
      display: block;
    }
    .bm-journal__intro > a {
      display: inline-block;
      margin-top: 16px;
    }
    .bm-journal__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .bm-journal-card--feature {
      grid-row: auto;
      min-height: 430px;
    }
    .bm-journal-card--secondary {
      min-height: 240px;
    }
  }
</style>
