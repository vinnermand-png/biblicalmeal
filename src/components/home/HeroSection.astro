---
import EditorialImage from '../common/EditorialImage.astro';
---

<section class="bm-home-hero" aria-labelledby="bm-home-hero-title">
  <div class="bm-home-hero__media" aria-hidden="true">
    <EditorialImage
      id="journal-ancient-table"
      fallbackArt="still-life"
      ratio="16 / 10"
      alt=""
      decorative
      loading="eager"
      fit="cover"
    />
  </div>
  <div class="bm-home-hero__overlay" aria-hidden="true"></div>

  <div class="container-site bm-home-hero__inner">
    <div class="bm-home-hero__copy">
      <p class="bm-eyebrow">The Ancient Table</p>
      <h1 id="bm-home-hero-title">The Bible tells<br />its story<br />at the <em>table.</em></h1>
      <div class="bm-rule" aria-hidden="true"><span></span><b>✦</b><span></span></div>
      <p class="bm-home-hero__lead">Ingredients, meals, landscapes, and culinary traditions from the ancient world — explored through Scripture, history, evidence, and the kitchen.</p>
      <div class="bm-home-hero__actions">
        <a class="bm-btn bm-btn--gold" href="/ingredients/">Explore the foods <span aria-hidden="true">→</span></a>
        <a class="bm-btn bm-btn--ghost" href="/editorial-method/">Enter the biblical world</a>
      </div>
      <p class="bm-home-hero__principles">Rooted in Scripture <span>•</span> Inspired by history <span>•</span> Made for today</p>
    </div>

    <aside class="bm-home-hero__quote" aria-label="Scripture reflection">
      <p>At the table</p>
      <blockquote>“Man shall not live by bread alone.”</blockquote>
      <cite>Matthew 4:4</cite>
    </aside>
  </div>
</section>

<style>
  .bm-home-hero {
    position: relative;
    min-height: 850px;
    overflow: hidden;
    isolation: isolate;
    background: #0f170d;
    color: #f3ebdd;
  }
  .bm-home-hero__media {
    position: absolute;
    inset: 0 0 0 31%;
    z-index: -3;
  }
  .bm-home-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.78) sepia(0.08) contrast(1.05) brightness(0.76);
  }
  .bm-home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, #0f170d 0%, #0f170d 24%, rgba(15, 23, 13, 0.99) 36%, rgba(15, 23, 13, 0.76) 51%, rgba(15, 23, 13, 0.16) 74%, rgba(15, 23, 13, 0.04) 100%),
      linear-gradient(0deg, rgba(8, 12, 7, 0.58), transparent 38%);
  }
  .bm-home-hero__inner {
    position: relative;
    display: flex;
    min-height: 850px;
    align-items: center;
    justify-content: space-between;
    padding-top: 72px;
    padding-bottom: 60px;
  }
  .bm-home-hero__copy {
    width: min(600px, 54%);
    padding-top: 12px;
  }
  .bm-eyebrow {
    margin: 0 0 18px;
    color: #c7a86c;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .bm-home-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.7rem, 7vw, 6.7rem);
    font-weight: 400;
    line-height: 0.93;
    letter-spacing: -0.045em;
  }
  .bm-home-hero h1 em {
    color: #c39a56;
    font-style: normal;
  }
  .bm-rule {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 255px;
    margin: 28px 0 24px;
    color: #b89653;
  }
  .bm-rule span {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .bm-rule b {
    font-size: 12px;
    font-weight: 400;
  }
  .bm-home-hero__lead {
    max-width: 540px;
    margin: 0;
    color: rgba(243, 235, 221, 0.78);
    font-size: 18px;
    line-height: 1.8;
  }
  .bm-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .bm-btn {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 22px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }
  .bm-btn:hover { transform: translateY(-2px); }
  .bm-btn--gold { color: #1b1915; background: #b89653; }
  .bm-btn--gold:hover { background: #c7ab72; }
  .bm-btn--ghost { color: #f3ebdd; border: 1px solid rgba(243, 235, 221, 0.3); }
  .bm-btn--ghost:hover { border-color: rgba(243, 235, 221, 0.72); }
  .bm-home-hero__principles {
    margin: 26px 0 0;
    color: #b89653;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .bm-home-hero__principles span { margin-inline: 9px; color: #846a3f; }
  .bm-home-hero__quote {
    width: 250px;
    align-self: flex-end;
    margin: 0 54px 70px 20px;
    padding: 22px 22px 20px;
    border: 1px solid rgba(184, 150, 83, 0.28);
    background: rgba(20, 31, 15, 0.74);
    backdrop-filter: blur(4px);
  }
  .bm-home-hero__quote p {
    margin: 0 0 12px;
    color: #c7a86c;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bm-home-hero__quote blockquote {
    margin: 0 0 15px;
    font-family: var(--font-display);
    font-size: 21px;
    font-style: italic;
    line-height: 1.35;
  }
  .bm-home-hero__quote cite {
    color: #b89653;
    font-family: var(--font-sans);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 1023px) {
    .bm-home-hero { min-height: 720px; }
    .bm-home-hero__inner { min-height: 720px; }
    .bm-home-hero__copy { width: min(560px, 65%); }
    .bm-home-hero h1 { font-size: clamp(3.7rem, 8vw, 5.3rem); }
    .bm-home-hero__quote { width: 215px; margin-right: 14px; }
  }
  @media (max-width: 760px) {
    .bm-home-hero { min-height: auto; }
    .bm-home-hero__media { inset: 0; }
    .bm-home-hero__overlay {
      background:
        linear-gradient(180deg, rgba(15, 23, 13, 0.12) 0%, rgba(15, 23, 13, 0.46) 35%, #0f170d 74%),
        linear-gradient(90deg, rgba(15, 23, 13, 0.8), rgba(15, 23, 13, 0.18));
    }
    .bm-home-hero__inner { min-height: 760px; flex-direction: column; align-items: stretch; justify-content: flex-end; padding-top: 150px; padding-bottom: 28px; }
    .bm-home-hero__copy { width: 100%; padding-top: 0; }
    .bm-home-hero h1 { font-size: clamp(3.2rem, 14vw, 4.9rem); }
    .bm-home-hero__lead { max-width: 34rem; font-size: 16px; line-height: 1.75; }
    .bm-home-hero__actions { display: grid; grid-template-columns: 1fr; }
    .bm-btn { width: 100%; }
    .bm-home-hero__principles { font-size: 10px; line-height: 1.8; }
    .bm-home-hero__quote { width: auto; align-self: stretch; margin: 24px 0 0; }
  }
</style>
